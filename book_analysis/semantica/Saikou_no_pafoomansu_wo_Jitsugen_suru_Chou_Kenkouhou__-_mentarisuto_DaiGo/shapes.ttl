<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/PhytochemicalShape>
    a sh:NodeShape ;
    sh:targetClass ex:Phytochemical ;
    sh:name "ファイトケミカル" ;
    sh:description "ポリフェノールやカルテノイドなど。活性酸素を無毒化し老化や疾患を防ぐ植物由来物質。" ;
    sh:property [
        sh:path ex:improves ;
        sh:class ex:Brain ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:healthEffect ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/ArtificialSweetenerShape>
    a sh:NodeShape ;
    sh:targetClass ex:ArtificialSweetener ;
    sh:name "人工甘味料" ;
    sh:description "FDA認可でも大腸菌を刺激して毒素を出させ、肥満や高血糖の人ではグルコース不耐症のリスクがある。" ;
    sh:property [
        sh:path ex:affects ;
        sh:class ex:Sleep ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:impairs ;
        sh:class ex:GutMicrobiome ;
        sh:severity sh:Violation
    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/SleepShape>
    a sh:NodeShape ;
    sh:targetClass ex:Sleep ;
    sh:name "睡眠" ;
    sh:description "高脂肪食・夜のブルーライト・ホルモンバランスの影響を受ける休息機能。" .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/StressShape>
    a sh:NodeShape ;
    sh:targetClass ex:Stress ;
    sh:name "ストレス" ;
    sh:description "午前中に負荷の高い仕事を終わらせると食欲増進ホルモンが抑えられ肥満リスクが下がる。" ;
    sh:property [
        sh:path ex:affects ;
        sh:class ex:Sleep ;
        sh:severity sh:Violation
    ] ;
    sh:property [
