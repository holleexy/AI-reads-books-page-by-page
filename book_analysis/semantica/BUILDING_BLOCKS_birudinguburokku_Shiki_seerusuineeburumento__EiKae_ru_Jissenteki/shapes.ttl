<https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/shapes> a owl:Ontology .

<https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/SalesEnablementShape>
    a sh:NodeShape ;
    sh:targetClass ex:SalesEnablement ;
    sh:name "セールスイネーブルメント" ;
    sh:description "営業担当者が適切なタイミングで適切なリソースを活用できるようにする部門横断的かつ戦略的なアプローチ。目的は営業組織の生産性最大化、売上向上、コスト削減である。" ;
    sh:property [
        sh:path ex:basedOnSystemsThinking ;
        sh:class ex:SystemsThinking ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasBuildingBlock ;
        sh:class ex:BuildingBlock ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasSystem ;
        sh:class ex:EnablementSystem ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:targetsOrganization ;
        sh:class ex:SalesOrganization ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:enablesRepresentative ;
        sh:class ex:SalesRepresentative ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:usesFramework ;
        sh:class ex:Framework ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasCharter ;
        sh:class ex:Charter ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasOnboarding ;
        sh:class ex:Onboarding ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:providesSupportService ;
        sh:class ex:SupportService ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:evolvesInto ;
        sh:class ex:PerformanceConsulting ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasMetric ;
        sh:class ex:Metric ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasPurpose ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasDefinition ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/SystemsThinkingShape>
    a sh:NodeShape ;
    sh:targetClass ex:SystemsThinking ;
    sh:name "システム思考" ;
    sh:description "相互に依存し全体として機能する部分の集合として営業組織を生態系として捉える思考法。セールスイネーブルメント構築の基盤となる。" .

<https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/BuildingBlockShape>
    a sh:NodeShape ;
    sh:targetClass ex:BuildingBlock ;
    sh:name "ビルディングブロック" ;
    sh:description "組織の営業力を最大化するための構成要素。単発の研修やツール導入ではなく相互依存する要素群として設計される。" ;
    sh:property [
        sh:path ex:usesFramework ;
        sh:class ex:Framework ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasPurpose ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasDefinition ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

