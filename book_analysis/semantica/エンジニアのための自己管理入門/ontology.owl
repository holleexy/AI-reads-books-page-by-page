<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="https://books.local/エンジニアのための自己管理入門/">
    <rdfs:label>エンジニアのための自己管理入門Ontology</rdfs:label>
    <owl:versionInfo>1.0</owl:versionInfo>
  </owl:Ontology>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/SelfManagement">
    <rdfs:label xml:lang="ja">セルフマネジメント</rdfs:label>
    <rdfs:comment xml:lang="ja">自分自身を管理の対象として扱い、自らのハンドルを握る実践。状態の変動を観察し調整し、意図した方向へ戻すことで、変化の中でも自らの意志で進む基盤をつくる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Person">
    <rdfs:label xml:lang="ja">人</rdfs:label>
    <rdfs:comment xml:lang="ja">自己管理の主体。エンジニアとマネージャーの役割は重なることが多く、自己管理する個人はチームへ良い影響を与える。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Engineer">
    <rdfs:label xml:lang="ja">エンジニア</rdfs:label>
    <rdfs:comment xml:lang="ja">実装や技術的課題に向き合う役割。創造的で一点ものの仕事が多く、モチベーションと余白が成果と成長を左右する。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Manager">
    <rdfs:label xml:lang="ja">マネージャー</rdfs:label>
    <rdfs:comment xml:lang="ja">人と優先順位に向き合う役割。思考ブロックの確保、委譲、心理的安全性の土壌づくりが自己管理の一部となる。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Agency">
    <rdfs:label xml:lang="ja">主体性</rdfs:label>
    <rdfs:comment xml:lang="ja">自ら選び、なぜ働くかを見失わず、義務ではなく欲求に駆動される感覚。その喪失が忙しさそのものよりも疲弊の真因となる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/JohariWindow">
    <rdfs:label xml:lang="ja">ジョハリの窓</rdfs:label>
    <rdfs:comment xml:lang="ja">自己情報を自己と他者の既知・未知の二軸で四象限に分ける自己理解の枠組み。盲点と未知を小さくすることが自己統制につながる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/WindowQuadrant">
    <rdfs:label xml:lang="ja">窓の象限</rdfs:label>
    <rdfs:comment xml:lang="ja">ジョハリの窓を構成する四つの領域。開放・盲点・隠れ・未知のいずれかとして自己情報を位置づける。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/OpenWindow">
    <rdfs:label xml:lang="ja">開放の窓</rdfs:label>
    <rdfs:comment xml:lang="ja">自己にも他者にも知られている領域。技術スタックや働き方、価値観の共有が含まれ、広いほど協力と自己管理が容易になる。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/エンジニアのための自己管理入門/WindowQuadrant"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/BlindSpotWindow">
    <rdfs:label xml:lang="ja">盲点の窓</rdfs:label>
    <rdfs:comment xml:lang="ja">他者には見えるが本人は気づいていない領域。繰り返されるレビュー指摘や無自覚な割り込みなどが該当し、自己統制を妨げる。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/エンジニアのための自己管理入門/WindowQuadrant"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/HiddenWindow">
    <rdfs:label xml:lang="ja">隠れた窓</rdfs:label>
    <rdfs:comment xml:lang="ja">本人は知っているが他者には見せていない領域。未挑戦のスキルやキャリア関心、困難などが含まれ、ある程度大きくてもよい。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/エンジニアのための自己管理入門/WindowQuadrant"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/UnknownWindow">
    <rdfs:label xml:lang="ja">未知の窓</rdfs:label>
    <rdfs:comment xml:lang="ja">自己にも他者にも未知の領域。新しい役割で現れる強みや、圧力下の予測不能な反応などが含まれ、最小化が望ましい。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/エンジニアのための自己管理入門/WindowQuadrant"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Motivation">
    <rdfs:label xml:lang="ja">モチベーション</rdfs:label>
    <rdfs:comment xml:lang="ja">特定の目標に向かって行動を起こし維持させるエネルギー。ワクワクする状況づくりが最大の加速要因であり、創造的な開発仕事に不可欠。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/GrowthLoop">
    <rdfs:label xml:lang="ja">成長ループ</rdfs:label>
    <rdfs:comment xml:lang="ja">高いモチベーションが主体的行動と複数のアプローチを生み、新たなケイパビリティを通じてさらに成長が加速する循環。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/MotivationTheory">
    <rdfs:label xml:lang="ja">動機づけ理論</rdfs:label>
    <rdfs:comment xml:lang="ja">何が動機づけるか（内容理論）と、どのように動機が生じるか（過程理論）を説明する理論群。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/ERGTheory">
    <rdfs:label xml:lang="ja">ERG理論</rdfs:label>
    <rdfs:comment xml:lang="ja">生存・関係・成長の三カテゴリで欲求を整理し、同時並行と欲求不満回帰を認める理論。エンジニアの賃金・信頼・挑戦の説明に適する。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/エンジニアのための自己管理入門/MotivationTheory"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/ExpectancyTheory">
    <rdfs:label xml:lang="ja">期待理論</rdfs:label>
    <rdfs:comment xml:lang="ja">動機づけを期待×道具性×誘意性の積として捉えるブルーームの理論。最も弱い要因から強化する。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/エンジニアのための自己管理入門/MotivationTheory"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/DesiredState">
    <rdfs:label xml:lang="ja">あるべき姿</rdfs:label>
    <rdfs:comment xml:lang="ja">TOBE。近い将来に望む状態。スキルアップや行動を逆算する起点となり、周囲の変化の中でも焦点を保つ。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/CurrentState">
    <rdfs:label xml:lang="ja">現状</rdfs:label>
    <rdfs:comment xml:lang="ja">ASIS。現在の自分の状態。あるべき姿とのギャップを認識し、埋める行動を設計する起点。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Goal">
    <rdfs:label xml:lang="ja">目標</rdfs:label>
    <rdfs:comment xml:lang="ja">行動の方向を定めるもの。SMARTでややストレッチに設定し、明確さ・難易度・フィードバック・コミットメントを点検する。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Task">
    <rdfs:label xml:lang="ja">タスク</rdfs:label>
    <rdfs:comment xml:lang="ja">行うべき仕事。何をすべきかを整理し、一日で完了できる大きさまで分解し、完了条件を明確にする対象。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Slack">
    <rdfs:label xml:lang="ja">余白</rdfs:label>
    <rdfs:comment xml:lang="ja">意図的に残す時間的・認知的余裕。100パーセント稼働を避け、変化・学習・検査・適応と創造性、燃え尽き防止を支える。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/TimeThief">
    <rdfs:label xml:lang="ja">時間どろぼう</rdfs:label>
    <rdfs:comment xml:lang="ja">集中と余白を奪う内外の要因。散在会議や通知などの外部要因と、未完了タスクや無限スクロールなどの内部要因がある。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Stress">
    <rdfs:label xml:lang="ja">ストレス</rdfs:label>
    <rdfs:comment xml:lang="ja">刺激に対する心身の反応。期限や技術的負債、要求の衝突などが典型因となり、中長期の状態調整の対象となる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Anger">
    <rdfs:label xml:lang="ja">怒り</rdfs:label>
    <rdfs:comment xml:lang="ja">蓄積したストレスから生じる二次感情。大切にしている価値観が侵害されたときのセンサーであり、一拍おいて建設的に扱う。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Resilience">
    <rdfs:label xml:lang="ja">レジリエンス</rdfs:label>
    <rdfs:comment xml:lang="ja">竹のようにしなやかな心の回復力。適切に落ち込み、回復し、教訓を抽出して前に進む力であり、決して揺れないことではない。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Coping">
    <rdfs:label xml:lang="ja">コーピング</rdfs:label>
    <rdfs:comment xml:lang="ja">ストレスに対処する認知的・行動的努力。問題焦点型と情動焦点型があり、動揺時はまず情動焦点で落ち着いてから再解釈する。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Burnout">
    <rdfs:label xml:lang="ja">バーンアウト</rdfs:label>
    <rdfs:comment xml:lang="ja">管理されない慢性ストレスによる疲弊・冷笑・効力感低下。早期兆候に気づき、休息と自己ケアで防ぐ。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Team">
    <rdfs:label xml:lang="ja">チーム</rdfs:label>
    <rdfs:comment xml:lang="ja">協働する集団。共有された世界観と心理的安全性が持続的モチベーションを支え、自己管理する個人が良い影響を及ぼす。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/PsychologicalSafety">
    <rdfs:label xml:lang="ja">心理的安全性</rdfs:label>
    <rdfs:comment xml:lang="ja">誰もが恐れずに発言できる土壌。ポジティブ感情が思考と行動のレパートリーを広げるための戦略的投資。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/PersonalValue">
    <rdfs:label xml:lang="ja">価値観</rdfs:label>
    <rdfs:comment xml:lang="ja">無意識に抱く優先事項。どんな状況で何をなぜ優先するかを言語化することが深い自己理解の鍵となる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Technique">
    <rdfs:label xml:lang="ja">技法</rdfs:label>
    <rdfs:comment xml:lang="ja">自己管理に用いる具体的手法。GTD、ポモドーロ、タイムボクシング、アイゼンハワーマトリクス、ABC理論、Moving Motivatorsなど。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Skill">
    <rdfs:label xml:lang="ja">スキル</rdfs:label>
    <rdfs:comment xml:lang="ja">あるべき姿から逆算して伸ばす能力。継続学習が前提の業界において、ギャップを埋める行動の対象。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/エンジニアのための自己管理入門/Career">
    <rdfs:label xml:lang="ja">キャリア</rdfs:label>
    <rdfs:comment xml:lang="ja">自らの条件で切り拓く職業的軌跡。日々の自己管理が仕事の質を高め、自律的な進路選択を可能にする。</rdfs:comment>
  </owl:Class>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/practices">
    <rdfs:label xml:lang="ja">実践する</rdfs:label>
    <rdfs:comment xml:lang="ja">人がセルフマネジメントを日常的に実践し、観察・調整・方向復帰を行う関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/SelfManagement"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/hasAgency">
    <rdfs:label xml:lang="ja">主体性を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">人が選択の感覚と望ましい自己像を保持している関係。喪失は疲弊の主因となる。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/Agency"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/hasMotivation">
    <rdfs:label xml:lang="ja">モチベーションを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">人が目標に向かうエネルギーを持つ関係。生存・関係・成長の充足と期待理論の要因に左右される。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/Motivation"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/generates">
    <rdfs:label xml:lang="ja">生成する</rdfs:label>
    <rdfs:comment xml:lang="ja">高いモチベーションが成長ループを生み、ケイパビリティの複利的な向上につながる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Motivation"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/GrowthLoop"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/explainedBy">
    <rdfs:label xml:lang="ja">説明される</rdfs:label>
    <rdfs:comment xml:lang="ja">モチベーションの生じ方や内容が動機づけ理論によって説明される関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Motivation"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/MotivationTheory"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/hasDesiredState">
    <rdfs:label xml:lang="ja">あるべき姿を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">人が近い将来の望ましい状態を意識し、行動の逆算起点とする関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/DesiredState"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/hasCurrentState">
    <rdfs:label xml:lang="ja">現状を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">人が現在の状態を観察し、あるべき姿とのギャップを把握する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/CurrentState"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/closesGapToward">
    <rdfs:label xml:lang="ja">ギャップを埋める</rdfs:label>
    <rdfs:comment xml:lang="ja">現状からあるべき姿へ近づくために行動を設計する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/CurrentState"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/DesiredState"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/hasGoal">
    <rdfs:label xml:lang="ja">目標を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">人がややストレッチな目標を設定し、動機づけと行動を方向づける関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/Goal"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/managesTask">
    <rdfs:label xml:lang="ja">タスクを管理する</rdfs:label>
    <rdfs:comment xml:lang="ja">人が何をすべきかを整理し、分解・委譲・完了条件の明確化を行う関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/Task"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/requiresSlack">
    <rdfs:label xml:lang="ja">余白を必要とする</rdfs:label>
    <rdfs:comment xml:lang="ja">セルフマネジメントが変化対応と創造性のために意図的な余白を必要とする関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/SelfManagement"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/Slack"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/stealsFrom">
    <rdfs:label xml:lang="ja">奪う</rdfs:label>
    <rdfs:comment xml:lang="ja">時間どろぼうが人の集中・余白・認知資源を侵食する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/TimeThief"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/hasQuadrant">
    <rdfs:label xml:lang="ja">象限を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">ジョハリの窓が開放・盲点・隠れ・未知の各象限を構成要素として持つ関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/JohariWindow"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/WindowQuadrant"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/hasValue">
    <rdfs:label xml:lang="ja">価値観を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">人が優先事項としての価値観を持ち、怒りや動機のセンサーとして働く関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/PersonalValue"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/belongsToTeam">
    <rdfs:label xml:lang="ja">チームに属する</rdfs:label>
    <rdfs:comment xml:lang="ja">人がチームの一員として協働し、相互の動機づけと安全な発言環境に影響する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/Team"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/hasPsychologicalSafety">
    <rdfs:label xml:lang="ja">心理的安全性を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">チームが恐れずに発言できる土壌を持ち、創造性と回復力を支える関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Team"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/PsychologicalSafety"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/experiences">
    <rdfs:label xml:lang="ja">経験する</rdfs:label>
    <rdfs:comment xml:lang="ja">人が刺激に対するストレス反応を経験する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/Stress"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/triggers">
    <rdfs:label xml:lang="ja">引き起こす</rdfs:label>
    <rdfs:comment xml:lang="ja">蓄積したストレスが怒りの爆発を引き起こす関係。怒りは価値観侵害の信号でもある。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Stress"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/Anger"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/isAddressedBy">
    <rdfs:label xml:lang="ja">対処される</rdfs:label>
    <rdfs:comment xml:lang="ja">ストレスが問題焦点型または情動焦点型のコーピングによって対処される関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Stress"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/Coping"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/hasResilience">
    <rdfs:label xml:lang="ja">レジリエンスを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">人が圧力を吸収し回復して教訓を前に進める力を持つ関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/Resilience"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/canLeadTo">
    <rdfs:label xml:lang="ja">至りうる</rdfs:label>
    <rdfs:comment xml:lang="ja">管理されない慢性ストレスがバーンアウトに至りうる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Stress"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/Burnout"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/usesTechnique">
    <rdfs:label xml:lang="ja">技法を用いる</rdfs:label>
    <rdfs:comment xml:lang="ja">人が自己管理のために具体的な技法やフレームワークを用いる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/Technique"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/developsSkill">
    <rdfs:label xml:lang="ja">スキルを伸ばす</rdfs:label>
    <rdfs:comment xml:lang="ja">人があるべき姿から逆算してスキルを意図的に伸ばす関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/Skill"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/エンジニアのための自己管理入門/managesCareer">
    <rdfs:label xml:lang="ja">キャリアを管理する</rdfs:label>
    <rdfs:comment xml:lang="ja">人が自らの条件でキャリアを切り拓く関係。日々の自己管理が基盤となる。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Person"/>
    <rdfs:range rdf:resource="https://books.local/エンジニアのための自己管理入門/Career"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="https://books.local/エンジニアのための自己管理入門/verbalization">
    <rdfs:label xml:lang="ja">言語化</rdfs:label>
    <rdfs:comment xml:lang="ja">価値観・目的・動機を言葉にしたもの。パーソナルユーザーストーリーや振り返りで用いる。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/PersonalValue"/>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Goal"/>
    <rdfs:domain rdf:resource="https://books.local/エンジニアのための自己管理入門/Motivation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

</rdf:RDF>
