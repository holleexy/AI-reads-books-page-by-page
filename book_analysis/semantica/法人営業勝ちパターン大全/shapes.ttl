<https://books.local/法人営業勝ちパターン大全/BudgetDoesNotIncreaseMazeShape>
    a sh:NodeShape ;
    sh:targetClass ex:BudgetDoesNotIncreaseMaze ;
    sh:name "予算が増えない迷路" ;
    sh:description "「予算がない」は内部事情の一言要約であることが多い。値引きせず予算すごろくで論理と証拠を共創する。" ;
