@prefix ex: <https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/shapes> a owl:Ontology .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/BookShape>
    a sh:NodeShape ;
    sh:targetClass ex:Book ;
    sh:name "書籍" ;
    sh:description "成果に直結する仮説提案営業の実践講座に関する書籍およびその分析対象。" ;
    sh:property [
        sh:path ex:title ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/SalesChallengeShape>
    a sh:NodeShape ;
    sh:targetClass ex:SalesChallenge ;
    sh:name "営業課題" ;
    sh:description "新製品が売れない、新規開拓が苦手、引き合い減少、製品同質化、オンライン商談での関係構築難化などBtoB営業の共通課題。" ;
    sh:property [
        sh:path ex:description ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/SalesApproachShape>
    a sh:NodeShape ;
    sh:targetClass ex:SalesApproach ;
    sh:name "営業アプローチ" ;
    sh:description "顧客への働きかけの仕方を表す営業スタイルや手法の上位概念。" ;
    sh:property [
        sh:path ex:addressesChallenge ;
        sh:class ex:SalesChallenge ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:appliesPrinciple ;
        sh:class ex:PsychologicalPrinciple ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:describedInBook ;
        sh:class ex:Book ;
        sh:severity sh:Violation
    ] .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/WaitingSalesShape>
    a sh:NodeShape ;
    sh:targetClass ex:WaitingSales ;
    sh:name "待ちの営業" ;
    sh:description "顧客からの提案依頼を待つ従来型の営業。システムリプレース型の大型案件に依存しやすい。" ;
    sh:property [
        sh:path ex:addressesChallenge ;
        sh:class ex:SalesChallenge ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:appliesPrinciple ;
        sh:class ex:PsychologicalPrinciple ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:describedInBook ;
        sh:class ex:Book ;
        sh:severity sh:Violation
    ] .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/OffensiveSalesShape>
    a sh:NodeShape ;
    sh:targetClass ex:OffensiveSales ;
    sh:name "攻めの営業" ;
    sh:description "クラウド普及による単価低下を踏まえ、顧客に先回りして提案する能動的な営業パラダイム。" ;
    sh:property [
        sh:path ex:addressesChallenge ;
        sh:class ex:SalesChallenge ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:appliesPrinciple ;
        sh:class ex:PsychologicalPrinciple ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:describedInBook ;
        sh:class ex:Book ;
        sh:severity sh:Violation
    ] .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/HypothesisProposalSalesShape>
    a sh:NodeShape ;
    sh:targetClass ex:HypothesisProposalSales ;
    sh:name "仮説提案営業" ;
    sh:description "明確なニーズがなくても事前調査に基づく仮説と個別提案資料で初回商談から案件を前進させる営業手法。" ;
    sh:property [
        sh:path ex:usesThinkingMethod ;
        sh:class ex:ThinkingMethod ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:formulatesHypothesis ;
        sh:class ex:Hypothesis ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:addressesChallenge ;
        sh:class ex:SalesChallenge ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:appliesPrinciple ;
        sh:class ex:PsychologicalPrinciple ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:describedInBook ;
        sh:class ex:Book ;
        sh:severity sh:Violation
    ] .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/ThinkingMethodShape>
    a sh:NodeShape ;
    sh:targetClass ex:ThinkingMethod ;
    sh:name "思考法" ;
    sh:description "営業活動で結論を導くための思考の枠組み。" .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/ExhaustiveThinkingShape>
    a sh:NodeShape ;
    sh:targetClass ex:ExhaustiveThinking ;
    sh:name "網羅思考" ;
    sh:description "すべての事象やデータを抽出・分析してから結論を出す手法。現場営業には時間がかかりすぎて不向き。" .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/HypothesisThinkingShape>
    a sh:NodeShape ;
    sh:targetClass ex:HypothesisThinking ;
    sh:name "仮説思考" ;
    sh:description "BCGが提唱した、情報が不十分な段階で仮の結論を立て実行・検証・修正を繰り返す手法。" .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/HypothesisShape>
    a sh:NodeShape ;
    sh:targetClass ex:Hypothesis ;
    sh:name "仮説" ;
    sh:description "限られた情報から立てる顧客課題または解決策の仮の結論。" ;
    sh:property [
        sh:path ex:hasHypothesisLevel ;
        sh:class ex:HypothesisLevel ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:basedOnSource ;
        sh:class ex:InformationSource ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:proposedToCustomer ;
        sh:class ex:Customer ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:presentedInMeeting ;
        sh:class ex:SalesMeeting ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:describedInBook ;
        sh:class ex:Book ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:description ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/ProblemHypothesisShape>
    a sh:NodeShape ;
    sh:targetClass ex:ProblemHypothesis ;
    sh:name "問題仮説" ;
    sh:description "顧客が抱えているであろう課題の仮定。So what?で根本原因とインパクトまで深掘りする。" ;
