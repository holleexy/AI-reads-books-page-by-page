    <rdfs:range rdf:resource="https://books.local/NEW_SALES/SignificancePerspective"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/hasEnablementDomain">
    <rdfs:label xml:lang="ja">実践領域を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">イネーブルメントの四つの実践領域。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/SalesEnablement"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/EnablementDomain"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/enables">
    <rdfs:label xml:lang="ja">遂行を支援する</rdfs:label>
    <rdfs:comment xml:lang="ja">営業組織と担当者のNEW SALES実現を支援する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/SalesEnablement"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/SalesOrganization"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/Salesperson"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/NewSales"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/targetsCustomer">
    <rdfs:label xml:lang="ja">顧客を対象とする</rdfs:label>
    <rdfs:comment xml:lang="ja">営業活動や商談が向かう顧客。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/Salesperson"/>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/Deal"/>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/SalesMethod"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/Customer"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/belongsToOrganization">
    <rdfs:label xml:lang="ja">組織に所属する</rdfs:label>
