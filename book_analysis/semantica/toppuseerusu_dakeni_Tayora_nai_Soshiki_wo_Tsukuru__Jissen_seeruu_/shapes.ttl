    a sh:NodeShape ;
    sh:targetClass ex:Coaching ;
    sh:name "コーチング" ;
    sh:description "ティーチングや進捗確認ではなく、部下が次のアクションを自ら決められるよう促す支援。商談コーチングとスキルコーチングがある。" ;
    sh:property [
        sh:path ex:alignedWithCustomerProcess ;
