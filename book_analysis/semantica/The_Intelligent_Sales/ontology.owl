<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="https://books.local/The_Intelligent_Sales/">
    <rdfs:label>The_Intelligent_SalesOntology</rdfs:label>
    <owl:versionInfo>1.0</owl:versionInfo>
  </owl:Ontology>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/Book">
    <rdfs:label xml:lang="ja">書籍</rdfs:label>
    <rdfs:comment xml:lang="ja">法人営業における生成AIの実践的活用法を解説する著作。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/Author">
    <rdfs:label xml:lang="ja">著者</rdfs:label>
    <rdfs:comment xml:lang="ja">書籍の執筆者。生成AIの進化に衝撃を受け、使い手のリテラシーが成果差を生むと認識する。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/Organization">
    <rdfs:label xml:lang="ja">組織</rdfs:label>
    <rdfs:comment xml:lang="ja">生成AIを導入し営業活動を行う企業や部門などの組織。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/Company">
    <rdfs:label xml:lang="ja">企業</rdfs:label>
    <rdfs:comment xml:lang="ja">法人営業の実践主体または顧客となる企業。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/The_Intelligent_Sales/Organization"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/SalesPerson">
    <rdfs:label xml:lang="ja">営業担当者</rdfs:label>
    <rdfs:comment xml:lang="ja">法人営業を担う人材。熱意・誠意・安心感が購買の最終決定に不可欠である。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/Customer">
    <rdfs:label xml:lang="ja">顧客</rdfs:label>
    <rdfs:comment xml:lang="ja">法人営業における購買側の企業または推進者。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/GenerativeAI">
    <rdfs:label xml:lang="ja">生成AI</rdfs:label>
    <rdfs:comment xml:lang="ja">営業プロセスの標準化・自動化を支援する生成人工知能。魔法の杖ではなくサプリメントである。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/TraditionalSales">
    <rdfs:label xml:lang="ja">三K営業</rdfs:label>
    <rdfs:comment xml:lang="ja">勘・経験・根性に依存する旧来の営業スタイル。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/IntelligentSales">
    <rdfs:label xml:lang="ja">インテリジェントセールス</rdfs:label>
    <rdfs:comment xml:lang="ja">生成AIやデジタルを駆使した営業4.0。外見の洗練とプロセスの無駄のないスマートさを備える。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/SalesProcess">
    <rdfs:label xml:lang="ja">営業プロセス</rdfs:label>
    <rdfs:comment xml:lang="ja">ターゲティングから商談準備、ロープレ、稟議支援までの一連の営業活動。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/Targeting">
    <rdfs:label xml:lang="ja">ターゲティング</rdfs:label>
    <rdfs:comment xml:lang="ja">過去の成功データから条件を特定し、ホットなリストを抽出する工程。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/The_Intelligent_Sales/SalesProcess"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/MeetingPreparation">
    <rdfs:label xml:lang="ja">商談準備</rdfs:label>
    <rdfs:comment xml:lang="ja">3C分析、PEST分析、競合調査により精度の高い仮説を構築する工程。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/The_Intelligent_Sales/SalesProcess"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/SalesRolePlay">
    <rdfs:label xml:lang="ja">営業ロープレ</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客ペルソナを詳細設定したAIとの模擬商談で反論対策や質問力を鍛える工程。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/The_Intelligent_Sales/SalesProcess"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/ApprovalDocumentSupport">
    <rdfs:label xml:lang="ja">稟議書支援</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客の社内稟議を通す文言を生成し、購買推進者を優秀な社内営業に変える支援。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/The_Intelligent_Sales/SalesProcess"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/MinutesCreation">
    <rdfs:label xml:lang="ja">議事録作成</rdfs:label>
    <rdfs:comment xml:lang="ja">結論、ネクストアクション、予算、選定基準、開始時期を簡潔に要約する周辺業務。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/The_Intelligent_Sales/SalesProcess"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/PromptEngineering">
    <rdfs:label xml:lang="ja">プロンプトエンジニアリング</rdfs:label>
    <rdfs:comment xml:lang="ja">一問一答で終わらせず、理想の回答を引き出す指示設計の技術。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/Prompt">
    <rdfs:label xml:lang="ja">プロンプト</rdfs:label>
    <rdfs:comment xml:lang="ja">命令文や役割指定などを含む、生成AIへの構造化された指示。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/PromptTechnique">
    <rdfs:label xml:lang="ja">プロンプト技法</rdfs:label>
    <rdfs:comment xml:lang="ja">具体性、目的明確化、出力形式指定、役割付与、不足情報の確認などの原則。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/DialogueCycle">
    <rdfs:label xml:lang="ja">対話サイクル</rdfs:label>
    <rdfs:comment xml:lang="ja">拡散・深掘り・収束の三フェーズで回答の解像度を上げる対話手法。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/Persona">
    <rdfs:label xml:lang="ja">ペルソナ</rdfs:label>
    <rdfs:comment xml:lang="ja">企業情報や制約条件を定義した詳細な顧客像。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/Management">
    <rdfs:label xml:lang="ja">マネジメント</rdfs:label>
    <rdfs:comment xml:lang="ja">指標や案件などのコトの管理と、感情やモチベーションなどのヒトの管理。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/Leadership">
    <rdfs:label xml:lang="ja">リーダーシップ</rdfs:label>
    <rdfs:comment xml:lang="ja">管理職が自らAIを体験し、無能・無知・無謀を避けて段階導入する指導力。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/IntroductionApproach">
    <rdfs:label xml:lang="ja">段階的導入</rdfs:label>
    <rdfs:comment xml:lang="ja">PoCでの成功体験、特定部門のスモールスタート、全社展開という導入手順。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/HumanDomain">
    <rdfs:label xml:lang="ja">人間の領域</rdfs:label>
    <rdfs:comment xml:lang="ja">感情、信頼、熱意、誠意など、AIが代替せず購買決定を動かす領域。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/SupplementTheory">
    <rdfs:label xml:lang="ja">サプリメント論</rdfs:label>
    <rdfs:comment xml:lang="ja">生成AIは基礎能力なしには効果が出ず、鵜呑みにすればリスクを生むという考え方。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/AILiteracy">
    <rdfs:label xml:lang="ja">AIリテラシー</rdfs:label>
    <rdfs:comment xml:lang="ja">生成AIの出力品質を左右する使い手の知識・経験・属人性。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/Benefit">
    <rdfs:label xml:lang="ja">活用メリット</rdfs:label>
    <rdfs:comment xml:lang="ja">知識向上、活動効率化、品質向上、マネジメント改善、再現性確保などの利点。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/NewHero">
    <rdfs:label xml:lang="ja">ニューヒーロー</rdfs:label>
    <rdfs:comment xml:lang="ja">細分化された特定営業職種の専門性とAIを掛け合わせた次世代人材。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/The_Intelligent_Sales/SalesPerson"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/CaseStudy">
    <rdfs:label xml:lang="ja">導入事例</rdfs:label>
    <rdfs:comment xml:lang="ja">ディップやセレブリックスなど、生成AIを営業に先行導入した実践例。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/The_Intelligent_Sales/SalesPureTime">
    <rdfs:label xml:lang="ja">セールスピュアタイム</rdfs:label>
    <rdfs:comment xml:lang="ja">周辺業務をAIで非同期化した結果、人間が本質的な顧客対応に充てる時間。</rdfs:comment>
  </owl:Class>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/writtenBy">
    <rdfs:label xml:lang="ja">執筆者</rdfs:label>
    <rdfs:comment xml:lang="ja">書籍とその著者を結びつける。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/Book"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/Author"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/evolvesFrom">
    <rdfs:label xml:lang="ja">進化元</rdfs:label>
    <rdfs:comment xml:lang="ja">インテリジェントセールスが脱却する旧来の三K営業。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/IntelligentSales"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/TraditionalSales"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/utilizes">
    <rdfs:label xml:lang="ja">活用する</rdfs:label>
    <rdfs:comment xml:lang="ja">営業主体が生成AIを用いる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/SalesPerson"/>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/Organization"/>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/IntelligentSales"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/GenerativeAI"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/hasProcess">
    <rdfs:label xml:lang="ja">プロセスを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">インテリジェントセールスが含む営業工程。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/IntelligentSales"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/SalesProcess"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/supportsProcess">
    <rdfs:label xml:lang="ja">プロセスを支援する</rdfs:label>
    <rdfs:comment xml:lang="ja">生成AIが営業プロセスの標準化・自動化を支援する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/GenerativeAI"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/SalesProcess"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/hasBenefit">
    <rdfs:label xml:lang="ja">メリットを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">生成AI活用やインテリジェントセールスがもたらす利点。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/GenerativeAI"/>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/IntelligentSales"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/Benefit"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/usesPrompt">
    <rdfs:label xml:lang="ja">プロンプトを用いる</rdfs:label>
    <rdfs:comment xml:lang="ja">営業担当者やプロンプト技術が指示文を用いる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/SalesPerson"/>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/PromptEngineering"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/Prompt"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/employsTechnique">
    <rdfs:label xml:lang="ja">技法を用いる</rdfs:label>
    <rdfs:comment xml:lang="ja">効果的なプロンプトのための原則や技法。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/PromptEngineering"/>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/Prompt"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/PromptTechnique"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/followsCycle">
    <rdfs:label xml:lang="ja">対話サイクルに従う</rdfs:label>
    <rdfs:comment xml:lang="ja">拡散・深掘り・収束で対話を継続する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/PromptEngineering"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/DialogueCycle"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/hasPersona">
    <rdfs:label xml:lang="ja">ペルソナを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">ロープレやプロンプトで用いる顧客像。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/SalesRolePlay"/>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/Prompt"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/Persona"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/serves">
    <rdfs:label xml:lang="ja">顧客に対応する</rdfs:label>
    <rdfs:comment xml:lang="ja">営業担当者が顧客に向き合う関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/SalesPerson"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/Customer"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/belongsTo">
    <rdfs:label xml:lang="ja">所属する</rdfs:label>
    <rdfs:comment xml:lang="ja">営業担当者が組織に属する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/SalesPerson"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/Organization"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/requiresLiteracy">
    <rdfs:label xml:lang="ja">リテラシーを要する</rdfs:label>
    <rdfs:comment xml:lang="ja">生成AIの効果は使い手のAIリテラシーに依存する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/GenerativeAI"/>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/SalesPerson"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/AILiteracy"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/doesNotReplace">
    <rdfs:label xml:lang="ja">代替しない</rdfs:label>
    <rdfs:comment xml:lang="ja">生成AIは感情や信頼などの人間領域を代替しない。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/GenerativeAI"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/HumanDomain"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/explainedBy">
    <rdfs:label xml:lang="ja">理論で説明される</rdfs:label>
    <rdfs:comment xml:lang="ja">生成AIの位置づけをサプリメント論で捉える。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/GenerativeAI"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/SupplementTheory"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/leads">
    <rdfs:label xml:lang="ja">指導する</rdfs:label>
    <rdfs:comment xml:lang="ja">AI時代のリーダーが組織や営業担当者を導く。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/Leadership"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/Organization"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/SalesPerson"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/manages">
    <rdfs:label xml:lang="ja">管理する</rdfs:label>
    <rdfs:comment xml:lang="ja">マネジメントが人と案件プロセスを管理する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/Management"/>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/Leadership"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/SalesPerson"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/SalesProcess"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/followsApproach">
    <rdfs:label xml:lang="ja">導入方針に従う</rdfs:label>
    <rdfs:comment xml:lang="ja">組織がPoCから全社展開へ段階的に導入する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/Organization"/>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/Leadership"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/IntroductionApproach"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/illustratedBy">
    <rdfs:label xml:lang="ja">事例で示される</rdfs:label>
    <rdfs:comment xml:lang="ja">インテリジェントセールスの実践を導入事例が示す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/IntelligentSales"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/CaseStudy"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/implementedAt">
    <rdfs:label xml:lang="ja">実施企業</rdfs:label>
    <rdfs:comment xml:lang="ja">導入事例が実施された企業。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/CaseStudy"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/Company"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/freesTimeFor">
    <rdfs:label xml:lang="ja">純時間を創出する</rdfs:label>
    <rdfs:comment xml:lang="ja">周辺業務の自動化により本質的な顧客対応時間を生む。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/GenerativeAI"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/SalesPureTime"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/combinesExpertiseWith">
    <rdfs:label xml:lang="ja">専門性と組み合わせる</rdfs:label>
    <rdfs:comment xml:lang="ja">ニューヒーローが特定領域の専門性と生成AIを融合する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/The_Intelligent_Sales/NewHero"/>
    <rdfs:range rdf:resource="https://books.local/The_Intelligent_Sales/GenerativeAI"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/The_Intelligent_Sales/appliedTo">
    <rdfs:label xml:lang="ja">適用対象</rdfs:label>
