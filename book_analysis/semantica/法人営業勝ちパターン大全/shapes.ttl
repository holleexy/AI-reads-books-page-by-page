<https://books.local/法人営業勝ちパターン大全/FinalDecisionMakerShape>
    a sh:NodeShape ;
    sh:targetClass ex:FinalDecisionMaker ;
    sh:name "最終決裁者" ;
    sh:description "最安値ではなく投資価値とROIを見る。実質影響は16.7%に過ぎず、決裁権と実影響力は一致しない。" ;
    sh:property [
