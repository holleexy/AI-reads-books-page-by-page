    a sh:NodeShape ;
    sh:targetClass ex:ManagementPlanning ;
    sh:name "経営企画" ;
    sh:description "経営の手足。中期計画、予算、M&A、特別プロジェクトを扱い、定型業務は相対的に少ない。" ;
