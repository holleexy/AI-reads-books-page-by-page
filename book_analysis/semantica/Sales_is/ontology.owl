<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="https://books.local/Sales_is/">
    <rdfs:label>Sales_isOntology</rdfs:label>
    <owl:versionInfo>1.0</owl:versionInfo>
  </owl:Ontology>

  <owl:Class rdf:about="https://books.local/Sales_is/ScientificSalesMethod">
    <rdfs:label xml:lang="ja">科学的営業術</rdfs:label>
    <rdfs:comment xml:lang="ja">勘・偶然・根性といった不確実要素を排除し、論理とデータで成果をコントロールする再現性の高い営業手法。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/Salesperson">
    <rdfs:label xml:lang="ja">営業パーソン</rdfs:label>
    <rdfs:comment xml:lang="ja">科学的営業術を実践し、顧客の課題解決と成果創出を担う専門職・技術職。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/Customer">
    <rdfs:label xml:lang="ja">顧客</rdfs:label>
    <rdfs:comment xml:lang="ja">商品そのものではなく、課題が解決できる可能性に対して契約する相手。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/DecisionMaker">
    <rdfs:label xml:lang="ja">決裁者</rdfs:label>
    <rdfs:comment xml:lang="ja">会うべき人である役職者・意思決定者。鶴の一声による白紙化を防ぐ対象。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Sales_is/Customer"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/NonPurchaseReason">
    <rdfs:label xml:lang="ja">買わない理由</rdfs:label>
    <rdfs:comment xml:lang="ja">売れた理由より信憑性が高く、営業プロセスで一つずつ排除すべき成約阻害要因。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/LostDeal">
    <rdfs:label xml:lang="ja">失注</rdfs:label>
    <rdfs:comment xml:lang="ja">受注よりサンプルが多く早期改善に役立つ宝の山であり、分析と実行の対象。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/SalesOpportunityLead">
    <rdfs:label>SOL</rdfs:label>
    <rdfs:comment xml:lang="ja">購買のタイミングと理由が明確になったリード（Sales Opportunity Lead）。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/TargetList">
    <rdfs:label xml:lang="ja">ターゲットリスト</rdfs:label>
    <rdfs:comment xml:lang="ja">ニーズのある見込み客を集めたリスト。探客力の中核となる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/TargetListCriterion">
    <rdfs:label xml:lang="ja">ターゲットリスト要素</rdfs:label>
    <rdfs:comment xml:lang="ja">勝利を掴むリストに必要な精度・鮮度・具体性・絶対数の四要素。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/GiveModel">
    <rdfs:label xml:lang="ja">Giveモデル</rdfs:label>
    <rdfs:comment xml:lang="ja">先に有益情報を提供し返報性の法則でSOLを得るスマート・アウトバウンド手法。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/ConsultingSalesProcess">
    <rdfs:label xml:lang="ja">コンサルティングセールスプロセス</rdfs:label>
    <rdfs:comment xml:lang="ja">違和感・不要感・不安感を未然に防ぎ合意と共感を積み重ねる七段階の営業プロセス。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/ProcessStep">
    <rdfs:label xml:lang="ja">プロセスステップ</rdfs:label>
    <rdfs:comment xml:lang="ja">コンサルティングセールスを構成する各フェーズ。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/LeadSales">
    <rdfs:label xml:lang="ja">リードセールス</rdfs:label>
    <rdfs:comment xml:lang="ja">アカウントプランからオーダーコントロールまでの案件獲得プロセス（前工程）。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Sales_is/ProcessStep"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/CoreSales">
    <rdfs:label xml:lang="ja">コアセールス</rdfs:label>
    <rdfs:comment xml:lang="ja">企画作成からクロージングまでの案件攻略プロセス（後工程）。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Sales_is/ProcessStep"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/AccountPlan">
    <rdfs:label xml:lang="ja">アカウントプラン</rdfs:label>
    <rdfs:comment xml:lang="ja">三C＋二C×マクロ環境などで顧客の勝ち筋と課題仮説を構築する商談前の攻略計画。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Sales_is/LeadSales"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/Approach">
    <rdfs:label xml:lang="ja">アプローチ</rdfs:label>
    <rdfs:comment xml:lang="ja">第一印象・壁の除去・興味喚起・信頼構築の四ステップとファーストピッチで土台を築く工程。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Sales_is/LeadSales"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/FactFinding">
    <rdfs:label xml:lang="ja">ファクトファインディング</rdfs:label>
    <rdfs:comment xml:lang="ja">事業理解・問題発見・課題設定により顧客と課題を一緒に見つける究極の営業力。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Sales_is/LeadSales"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/OrderControl">
    <rdfs:label xml:lang="ja">オーダーコントロール</rdfs:label>
    <rdfs:comment xml:lang="ja">グランドデザイン・体制・予算感と意思決定者をすり合わせ、白紙化を防ぐ要件定義。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Sales_is/LeadSales"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/ProposalCreation">
    <rdfs:label xml:lang="ja">企画作成</rdfs:label>
    <rdfs:comment xml:lang="ja">課題解決・評価基準・ストーリー・実現性の四要件を満たす提案書を起転承結で作る工程。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Sales_is/CoreSales"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/Presentation">
    <rdfs:label xml:lang="ja">プレゼンテーション</rdfs:label>
    <rdfs:comment xml:lang="ja">相手の立場にスポットライトを変え、テストクロージングで障壁を除く最適な提案。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Sales_is/CoreSales"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/Closing">
    <rdfs:label xml:lang="ja">クロージング</rdfs:label>
    <rdfs:comment xml:lang="ja">説得ではなく納得を支援し、意思決定を後押しする工程。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Sales_is/CoreSales"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/CustomerCase">
    <rdfs:label xml:lang="ja">顧客事例</rdfs:label>
    <rdfs:comment xml:lang="ja">可能性の見える化、否定しない問題提起、トークスキル非依存の説得を実現する武器。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/MindsetRule">
    <rdfs:label xml:lang="ja">マインドセットルール</rdfs:label>
    <rdfs:comment xml:lang="ja">買いもの提案・顧客主語・コンサルタント思想など営業パーソンの十の行動原則。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/DiSCType">
    <rdfs:label xml:lang="ja">DiSCタイプ</rdfs:label>
    <rdfs:comment xml:lang="ja">支配的・社交的・協調的・慎重の行動傾向に合わせたコミュニケーション類型。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/Problem">
    <rdfs:label xml:lang="ja">問題</rdfs:label>
    <rdfs:comment xml:lang="ja">現状から理想を引いたギャップとして可視化されるもの。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/Issue">
    <rdfs:label xml:lang="ja">課題</rdfs:label>
    <rdfs:comment xml:lang="ja">原因と示唆から導かれ、解決するためのポジティブな取り組みに昇華したもの。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Sales_is/CustomerSuccess">
    <rdfs:label xml:lang="ja">カスタマーサクセス</rdfs:label>
    <rdfs:comment xml:lang="ja">購買をきっかけに問題解決を実現し、指名枠を得る営業の究極目標。</rdfs:comment>
  </owl:Class>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/practices">
    <rdfs:label xml:lang="ja">実践する</rdfs:label>
    <rdfs:comment xml:lang="ja">営業パーソンが科学的営業術を用いる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/Salesperson"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/ScientificSalesMethod"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/serves">
    <rdfs:label xml:lang="ja">担当する</rdfs:label>
    <rdfs:comment xml:lang="ja">営業パーソンが顧客を主語にして価値提供する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/Salesperson"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/Customer"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/hasRule">
    <rdfs:label xml:lang="ja">ルールを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">科学的営業術を支える十のマインドセット。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/ScientificSalesMethod"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/MindsetRule"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/followsProcess">
    <rdfs:label xml:lang="ja">プロセスに従う</rdfs:label>
    <rdfs:comment xml:lang="ja">成果をコントロールするために七ステップを用いる。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/ScientificSalesMethod"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/ConsultingSalesProcess"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/hasStep">
    <rdfs:label xml:lang="ja">ステップを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">プロセスがリードセールスとコアセールスの工程から構成される。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/ConsultingSalesProcess"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/ProcessStep"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/precedes">
    <rdfs:label xml:lang="ja">先行する</rdfs:label>
    <rdfs:comment xml:lang="ja">前工程から後工程へ合意と共感を積み重ねる順序関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/ProcessStep"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/ProcessStep"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/eliminates">
    <rdfs:label xml:lang="ja">排除する</rdfs:label>
    <rdfs:comment xml:lang="ja">各フェーズで買わない理由を未然に取り除く。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/ProcessStep"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/NonPurchaseReason"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/causedBy">
    <rdfs:label xml:lang="ja">原因となる</rdfs:label>
    <rdfs:comment xml:lang="ja">失注が買わない理由によって生じる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/LostDeal"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/NonPurchaseReason"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/analyzes">
    <rdfs:label xml:lang="ja">分析する</rdfs:label>
    <rdfs:comment xml:lang="ja">失注を金脈と捉え検証し同じ失敗を防ぐ。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/Salesperson"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/LostDeal"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/usesCase">
    <rdfs:label xml:lang="ja">事例を用いる</rdfs:label>
    <rdfs:comment xml:lang="ja">個人の話術に依存せず顧客事例をコンテンツとして使う。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/Salesperson"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/CustomerCase"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/visualizesPossibility">
    <rdfs:label xml:lang="ja">可能性を見える化する</rdfs:label>
    <rdfs:comment xml:lang="ja">親近感のある事例で導入後の理想を想像させる。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/CustomerCase"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/Customer"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/hasTargetList">
    <rdfs:label xml:lang="ja">リストを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">探客力に基づきターゲットリストを保有する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/Salesperson"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/TargetList"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/hasCriterion">
    <rdfs:label xml:lang="ja">要素を備える</rdfs:label>
    <rdfs:comment xml:lang="ja">精度・鮮度・具体性・絶対数を満たす。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/TargetList"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/TargetListCriterion"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/usesGiveModel">
    <rdfs:label xml:lang="ja">Giveモデルを用いる</rdfs:label>
    <rdfs:comment xml:lang="ja">先に価値提供してからヒアリングへ移行する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/Salesperson"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/GiveModel"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/obtains">
    <rdfs:label xml:lang="ja">獲得する</rdfs:label>
    <rdfs:comment xml:lang="ja">GiveモデルによりSOLを創出・獲得する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/GiveModel"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/SalesOpportunityLead"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/sourcedFrom">
    <rdfs:label xml:lang="ja">リストから生じる</rdfs:label>
    <rdfs:comment xml:lang="ja">質の高いターゲットリストからSOLが生まれる。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/SalesOpportunityLead"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/TargetList"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/meets">
    <rdfs:label xml:lang="ja">商談する</rdfs:label>
    <rdfs:comment xml:lang="ja">会える人ではなく会うべき決裁者と商談する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/Salesperson"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/DecisionMaker"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/hasBehavioralType">
    <rdfs:label xml:lang="ja">行動傾向を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">アプローチ時にDiSCで快適なコミュニケーションを選ぶ。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/Customer"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/DiSCType"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/identifiesProblem">
    <rdfs:label xml:lang="ja">問題を発見する</rdfs:label>
    <rdfs:comment xml:lang="ja">現状と理想のギャップを共同作業で可視化する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/FactFinding"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/Problem"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/setsIssue">
    <rdfs:label xml:lang="ja">課題を設定する</rdfs:label>
    <rdfs:comment xml:lang="ja">問題を解決のためのポジティブな取り組みへ昇華する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/FactFinding"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/Issue"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/derivedFrom">
    <rdfs:label xml:lang="ja">問題から導かれる</rdfs:label>
    <rdfs:comment xml:lang="ja">原因と示唆により問題が課題へ変換される。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/Issue"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/Problem"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/solves">
    <rdfs:label xml:lang="ja">課題を解決する</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客課題にフィットした情報だけに絞り込んだ提案を行う。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/ProposalCreation"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/Issue"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/leadsToSuccess">
    <rdfs:label xml:lang="ja">成功へ導く</rdfs:label>
    <rdfs:comment xml:lang="ja">受注をきっかけに顧客の問題解決実現へつなげる。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/Closing"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/CustomerSuccess"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Sales_is/pursues">
    <rdfs:label xml:lang="ja">寄り添い続ける</rdfs:label>
    <rdfs:comment xml:lang="ja">受注後も責任を放棄せず顧客成功に貢献する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/Salesperson"/>
    <rdfs:range rdf:resource="https://books.local/Sales_is/CustomerSuccess"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="https://books.local/Sales_is/description">
    <rdfs:label xml:lang="ja">説明</rdfs:label>
    <rdfs:comment xml:lang="ja">概念やルール、工程の日本語による補足説明。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/ScientificSalesMethod"/>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/MindsetRule"/>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/ProcessStep"/>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/CustomerCase"/>
    <rdfs:domain rdf:resource="https://books.local/Sales_is/NonPurchaseReason"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

</rdf:RDF>
