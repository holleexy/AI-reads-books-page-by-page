    <rdfs:range rdf:resource="https://books.local/バックオフィス業務のすべてがわかる本.ocr/AccountingPrinciple"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/バックオフィス業務のすべてがわかる本.ocr/producesStatement">
    <rdfs:label xml:lang="ja">財務諸表を作成する</rdfs:label>
    <rdfs:comment xml:lang="ja">経理財務や決算業務が財務諸表を作成する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/バックオフィス業務のすべてがわかる本.ocr/AccountingFinance"/>
    <rdfs:domain rdf:resource="https://books.local/バックオフィス業務のすべてがわかる本.ocr/FinancialClosing"/>
    <rdfs:range rdf:resource="https://books.local/バックオフィス業務のすべてがわかる本.ocr/FinancialStatement"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/バックオフィス業務のすべてがわかる本.ocr/usesBookkeeping">
    <rdfs:label xml:lang="ja">簿記を用いる</rdfs:label>
    <rdfs:comment xml:lang="ja">経理財務が複式簿記を記帳の基盤として用いる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/バックオフィス業務のすべてがわかる本.ocr/AccountingFinance"/>
    <rdfs:range rdf:resource="https://books.local/バックオフィス業務のすべてがわかる本.ocr/DoubleEntryBookkeeping"/>
