    <rdfs:label xml:lang="ja">仮説を立案する</rdfs:label>
    <rdfs:comment xml:lang="ja">事前調査に基づき問題仮説と解決仮説を立てる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/Salesperson"/>
