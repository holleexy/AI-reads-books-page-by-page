        sh:path ex:hasEnablementDomain ;
        sh:class ex:EnablementDomain ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:enables ;
        sh:class ex:SalesOrganization ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:description ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/NEW_SALES/EnablementDomainShape>
    a sh:NodeShape ;
    sh:targetClass ex:EnablementDomain ;
    sh:name "イネーブルメント実践領域" ;
    sh:description "ナレッジ・ワーク・ラーニング・ピープルの四領域。" .

<https://books.local/NEW_SALES/KnowledgeDomainShape>
    a sh:NodeShape ;
    sh:targetClass ex:KnowledgeDomain ;
    sh:name "ナレッジ領域" ;
    sh:description "商材・資料・ノウハウの展開によりCANを最大化する領域。" .

<https://books.local/NEW_SALES/WorkDomainShape>
    a sh:NodeShape ;
    sh:targetClass ex:WorkDomain ;
    sh:name "ワーク領域" ;
    sh:description "営業プロセス設計によりMUSTを明確化する領域。" .

<https://books.local/NEW_SALES/LearningDomainShape>
    a sh:NodeShape ;
    sh:targetClass ex:LearningDomain ;
    sh:name "ラーニング領域" ;
    sh:description "スキル獲得のための学習プログラム提供によりCANを最大化する領域。" ;
    sh:property [
        sh:path ex:offersCourse ;
        sh:class ex:LearningCourse ;
        sh:severity sh:Violation
    ] .

<https://books.local/NEW_SALES/PeopleDomainShape>
    a sh:NodeShape ;
    sh:targetClass ex:PeopleDomain ;
    sh:name "ピープル領域" ;
    sh:description "求められるスキル定義と人材配置によりMUSTを明確化する領域。" .

<https://books.local/NEW_SALES/CustomerShape>
    a sh:NodeShape ;
    sh:targetClass ex:Customer ;
    sh:name "顧客" ;
    sh:description "購買プロセスを進める企業または個人。" ;
    sh:property [
        sh:path ex:hasChampion ;
        sh:class ex:Champion ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasInternalMap ;
        sh:class ex:InternalRelationshipMap ;
        sh:severity sh:Violation
