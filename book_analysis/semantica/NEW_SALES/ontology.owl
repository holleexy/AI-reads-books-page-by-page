    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/Salesperson"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/SalesOrganization"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/assignedTo">
    <rdfs:label xml:lang="ja">担当する</rdfs:label>
    <rdfs:comment xml:lang="ja">商談を担当する営業担当者。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/Deal"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/Salesperson"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/hasChampion">
    <rdfs:label xml:lang="ja">チャンピオンを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客社内の擁護者との関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/Customer"/>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/Deal"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/Champion"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/hasInternalMap">
    <rdfs:label xml:lang="ja">社内関係図を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">複雑な意思決定構造の可視化。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/Customer"/>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/Deal"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/InternalRelationshipMap"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/partOfProcess">
    <rdfs:label xml:lang="ja">プロセスの一部である</rdfs:label>
    <rdfs:comment xml:lang="ja">商談や段階が営業プロセスに属する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/Deal"/>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/ScenarioStage"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/SalesProcess"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/forecasts">
    <rdfs:label xml:lang="ja">予測する</rdfs:label>
    <rdfs:comment xml:lang="ja">確度別ヨミによる案件の業績予測。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/ForecastManagement"/>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/ScoreSales"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/Deal"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/usesContent">
    <rdfs:label xml:lang="ja">コンテンツを用いる</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客事例や比較表などの営業コンテンツ利用。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/Salesperson"/>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/Deal"/>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/StorySales"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/SalesContent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/offersCourse">
    <rdfs:label xml:lang="ja">学習コースを提供する</rdfs:label>
    <rdfs:comment xml:lang="ja">OJTに頼らない体系的学習の提供。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/ShareSales"/>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/LearningDomain"/>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/SalesOrganization"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/LearningCourse"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/playsRole">
    <rdfs:label xml:lang="ja">役割を担う</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客側関係者が担う運用・利用・管理・決裁の役割。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/Customer"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/CustomerRole"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/hasPersonalityType">
    <rdfs:label xml:lang="ja">志向タイプを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客個人のDiSC等に基づく志向。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/Customer"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/PersonalityType"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/practicesMethod">
    <rdfs:label xml:lang="ja">メソッドを実践する</rdfs:label>
    <rdfs:comment xml:lang="ja">担当者が現場の四つのSを実践する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/Salesperson"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/SalesMethod"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="https://books.local/NEW_SALES/description">
    <rdfs:label xml:lang="ja">説明</rdfs:label>
    <rdfs:comment xml:lang="ja">概念や案件の日本語による説明文。</rdfs:comment>
