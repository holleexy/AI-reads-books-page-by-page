    ] .

<https://books.local/toppuseerusu_dakeni_Tayora_nai_Soshiki_wo_Tsukuru__Jissen_seeruu_/ProductEnablementShape>
    a sh:NodeShape ;
    sh:targetClass ex:ProductEnablement ;
    sh:name "プロダクト・イネーブルメント" ;
    sh:description "製品ごとに売り方をパッケージ化したセールス・プレイを提供し、拡大した製品知識の習得負荷を下げる取り組み。" ;
    sh:property [
        sh:path ex:providesSalesPlay ;
