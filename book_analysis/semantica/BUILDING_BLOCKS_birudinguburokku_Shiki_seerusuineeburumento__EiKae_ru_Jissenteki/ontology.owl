  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/usesFramework">
    <rdfs:label xml:lang="ja">フレームワークを用いる</rdfs:label>
    <rdfs:comment xml:lang="ja">ビルディングブロックやイネーブルメントが実践枠組みを用いる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/BuildingBlock"/>
    <rdfs:domain rdf:resource="https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/SalesEnablement"/>
