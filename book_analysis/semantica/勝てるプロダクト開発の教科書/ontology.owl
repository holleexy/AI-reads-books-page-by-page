  <owl:ObjectProperty rdf:about="https://books.local/勝てるプロダクト開発の教科書/operatesInPhase">
    <rdfs:label xml:lang="ja">組織フェーズで活動する</rdfs:label>
    <rdfs:comment xml:lang="ja">立ち上げ・成長・拡大で保持と委任の地図が変わる。</rdfs:comment>
