    ] ;
    sh:property [
        sh:path ex:handlesConsumptionTax ;
        sh:class ex:ConsumptionTax ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:mappedToResource ;
        sh:class ex:Resource ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:ledBy ;
        sh:class ex:ExecutiveRole ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasWorkType ;
