    a sh:NodeShape ;
    sh:targetClass ex:BackOfficeFunction ;
    sh:name "バックオフィス機能" ;
    sh:description "バックオフィスを構成する職能領域。ヒト・モノ・カネの観点から経営意思決定を支える。" ;
    sh:property [
        sh:path ex:mappedToResource ;
        sh:class ex:Resource ;
        sh:severity sh:Violation
    ] ;
    sh:property [
