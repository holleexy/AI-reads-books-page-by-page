        sh:severity sh:Violation
    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/Omega3FattyAcidShape>
    a sh:NodeShape ;
    sh:targetClass ex:Omega3FattyAcid ;
    sh:name "オメガ3脂肪酸" ;
    sh:description "DHA・EPA。海馬を大きくし認知機能を向上させ、1日1.5gを60日で慢性頭痛を75%減少させる。" ;
    sh:property [
        sh:path ex:improves ;
        sh:class ex:Brain ;
        sh:severity sh:Violation
    ] ;
    sh:property [
