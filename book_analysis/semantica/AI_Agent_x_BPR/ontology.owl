    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/DigitalWorker"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/Copilot"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/exhibitsCharacteristic">
    <rdfs:label xml:lang="ja">特性を示す</rdfs:label>
    <rdfs:comment xml:lang="ja">LLM由来の出力や理解の特性を持つことを表す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/AIAgent"/>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/IntelligenceLayer"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/LLMCharacteristic"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/improves">
    <rdfs:label xml:lang="ja">を改善する</rdfs:label>
    <rdfs:comment xml:lang="ja">エージェントが対象業務の生産性や品質を高める関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/AIAgent"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/BusinessProcess"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/usesMethod">
    <rdfs:label xml:lang="ja">手法を用いる</rdfs:label>
    <rdfs:comment xml:lang="ja">業務改革がAIAM法に従って推進されることを表す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/BusinessReform"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/AIAMMethod"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/reforms">
    <rdfs:label xml:lang="ja">を改革対象とする</rdfs:label>
    <rdfs:comment xml:lang="ja">改革イニシアティブが対象とする業務プロセス。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/BusinessReform"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/BusinessProcess"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/facesBarrier">
    <rdfs:label xml:lang="ja">壁に直面する</rdfs:label>
    <rdfs:comment xml:lang="ja">導入現場で直面する七つの壁との関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/BusinessReform"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/Barrier"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/hasROI">
    <rdfs:label xml:lang="ja">ROIを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">改革施策の投資対効果。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/BusinessReform"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/ROI"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/hasKPI">
    <rdfs:label xml:lang="ja">KPIを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">目標設定・検証・撤退判断に用いる指標。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/BusinessReform"/>
