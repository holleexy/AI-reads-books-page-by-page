<https://books.local/バックオフィス業務のすべてがわかる本.ocr/ResourceShape>
    a sh:NodeShape ;
    sh:targetClass ex:Resource ;
    sh:name "経営資源" ;
    sh:description "バックオフィスが経営意思決定を支えるヒト・モノ・カネ。" .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/PeopleResourceShape>
    a sh:NodeShape ;
    sh:targetClass ex:PeopleResource ;
    sh:name "ヒト" ;
    sh:description "人事労務が主に担う人的資源。" .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/GoodsResourceShape>
    a sh:NodeShape ;
    sh:targetClass ex:GoodsResource ;
    sh:name "モノ" ;
    sh:description "物品・設備など物的資源。" .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/MoneyResourceShape>
    a sh:NodeShape ;
    sh:targetClass ex:MoneyResource ;
    sh:name "カネ" ;
    sh:description "経理財務が主に担う資金・財務資源。お金の動きはビジネスが進む過程の結果に過ぎない。" .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/ExecutiveRoleShape>
    a sh:NodeShape ;
    sh:targetClass ex:ExecutiveRole ;
    sh:name "経営層役職" ;
    sh:description "バックオフィスと経営をつなぐCXO級の役割。CFO、CHROに加えCLOやCAOも重要性を増す。差は経営への関与にある。" ;
    sh:property [
        sh:path ex:mission ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/ChiefFinancialOfficerShape>
    a sh:NodeShape ;
    sh:targetClass ex:ChiefFinancialOfficer ;
    sh:name "最高財務責任者" ;
    sh:description "全社の財務資源配分をM&Aを含めて最適化する使命を持つ。" ;
    sh:property [
        sh:path ex:mission ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/ChiefHumanResourcesOfficerShape>
    a sh:NodeShape ;
    sh:targetClass ex:ChiefHumanResourcesOfficer ;
    sh:name "最高人事責任者" ;
    sh:description "制度設計、採用、文化を通じて最強の成果を生む組織を構築する使命を持つ。" ;
    sh:property [
        sh:path ex:mission ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/WorkTypeShape>
    a sh:NodeShape ;
    sh:targetClass ex:WorkType ;
    sh:name "業務類型" ;
    sh:description "バックオフィス業務の性質。定型業務の割合が高いこと、専門知識を要すること、全社の経営管理を規律することの三特性がある。" ;
    sh:property [
        sh:path ex:characteristic ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/RoutineWorkShape>
    a sh:NodeShape ;
    sh:targetClass ex:RoutineWork ;
    sh:name "定型業務" ;
    sh:description "日次・週次・月次・年次のサイクルで行われる標準化された業務。可視化とマニュアル化が効率を左右する。" ;
    sh:property [
        sh:path ex:workCycle ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:characteristic ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/SpecializedKnowledgeWorkShape>
    a sh:NodeShape ;
    sh:targetClass ex:SpecializedKnowledgeWork ;
    sh:name "専門知識業務" ;
    sh:description "法令や会計基準など専門知識を要する業務。法令はほぼ毎年改正される。" ;
    sh:property [
        sh:path ex:characteristic ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/ManagementControlWorkShape>
    a sh:NodeShape ;
    sh:targetClass ex:ManagementControlWork ;
    sh:name "経営管理業務" ;
    sh:description "全社の経営管理を規律する業務。経営者の意図を理解し同じ視点でオペレーションを回すことが本質である。" ;
    sh:property [
        sh:path ex:characteristic ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/OrganizationDesignShape>
    a sh:NodeShape ;
    sh:targetClass ex:OrganizationDesign ;
    sh:name "組織設計" ;
    sh:description "事業モデル、成長計画、文化、企業類型、ステークホルダー要求に応じた編成。一人バックオフィスから機能別部門まで段階的に変わる。組織設計は文化形成そのものである。" ;
    sh:property [
        sh:path ex:characteristic ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/BackOfficePolicyShape>
    a sh:NodeShape ;
    sh:targetClass ex:BackOfficePolicy ;
    sh:name "バックオフィス・ポリシー" ;
    sh:description "機能を統一する羅針盤。全社戦略との連動、情熱と論理の結合、独自性の簡潔な表現が設計原則。コストセンターである機能の成長と存在感を支える。" ;
    sh:property [
        sh:path ex:policyValue ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/PeriodicTaskShape>
    a sh:NodeShape ;
    sh:targetClass ex:PeriodicTask ;
    sh:name "定期業務" ;
    sh:description "年間・月次または随時のスケジュール、提出先、書類で管理される業務。法定期限を持つものが多く、繁閑は予測可能である。" ;
    sh:property [
        sh:path ex:governedByLaw ;
        sh:class ex:Law ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:involvesStakeholder ;
        sh:class ex:Stakeholder ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:workCycle ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/FinancialClosingShape>
    a sh:NodeShape ;
    sh:targetClass ex:FinancialClosing ;
    sh:name "決算業務" ;
    sh:description "最も重要な定期業務の一つ。定型に見えて基準や事業展開により毎年変化し、完了時の達成感が大きい。" ;
    sh:property [
        sh:path ex:producesStatement ;
        sh:class ex:FinancialStatement ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:governedByLaw ;
        sh:class ex:Law ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:involvesStakeholder ;
        sh:class ex:Stakeholder ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:workCycle ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/AccountingPrincipleShape>
    a sh:NodeShape ;
    sh:targetClass ex:AccountingPrinciple ;
    sh:name "会計原則" ;
    sh:description "発生主義、費用収益対応の原則、継続企業の前提、収益の実現主義など、記帳と期間計算を支える原則。" .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/DoubleEntryBookkeepingShape>
    a sh:NodeShape ;
    sh:targetClass ex:DoubleEntryBookkeeping ;
    sh:name "複式簿記" ;
    sh:description "資産・負債・純資産・収益・費用の五分類で中長期視点を加える記帳法。会計の言語であり、借方と貸方で取引を捉える。" ;
    sh:property [
        sh:path ex:appliesPrinciple ;
        sh:class ex:AccountingPrinciple ;
        sh:severity sh:Violation
    ] .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/FinancialStatementShape>
    a sh:NodeShape ;
    sh:targetClass ex:FinancialStatement ;
    sh:name "財務諸表" ;
    sh:description "会社法、金融商品取引法、税法、経営それぞれに奉仕する報告。貸借対照表と損益計算書を含む。" ;
    sh:property [
        sh:path ex:involvesStakeholder ;
        sh:class ex:Stakeholder ;
        sh:severity sh:Violation
    ] .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/ConsumptionTaxShape>
    a sh:NodeShape ;
    sh:targetClass ex:ConsumptionTax ;
    sh:name "消費税" ;
    sh:description "仮受消費税から仮払消費税を差し引いて納税する付加価値税。免税事業者、簡易課税、税込経理と税抜経理が関連する。" .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/InvoiceSystemShape>
    a sh:NodeShape ;
    sh:targetClass ex:InvoiceSystem ;
    sh:name "インボイス制度" ;
    sh:description "2023年10月開始。適格請求書がなければ仕入税額控除できない制度。課税区分・税率・適格可否・控除方法の四軸で誤りやすい。" .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/DepreciationShape>
    a sh:NodeShape ;
    sh:targetClass ex:Depreciation ;
    sh:name "減価償却" ;
    sh:description "長期使用資産を耐用年数にわたって費用配分する処理。定額法と定率法があり、事業供用日から開始する。" .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/DigitalTransformationShape>
    a sh:NodeShape ;
    sh:targetClass ex:DigitalTransformation ;
    sh:name "デジタルトランスフォーメーション" ;
    sh:description "2010年代以降不可避の変革。待ったなしで事務・取引処理をシステムに置き換え、残る役割を専門業務・管理・業務設計へ移す。" .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/RoboticProcessAutomationShape>
    a sh:NodeShape ;
    sh:targetClass ex:RoboticProcessAutomation ;
    sh:name "ロボティックプロセスオートメーション" ;
    sh:description "データの検索、ダウンロード、入力、分析を自動化する技術。" .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/CloudSystemShape>
    a sh:NodeShape ;
    sh:targetClass ex:CloudSystem ;
    sh:name "クラウドシステム" ;
    sh:description "UI/UXとAPI連携を重視する現代の業務システム。入力・所定ルールによる内部処理・出力の構造を理解することが運用の要点。" .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/BusinessProcessOutsourcingShape>
    a sh:NodeShape ;
    sh:targetClass ex:BusinessProcessOutsourcing ;
    sh:name "業務プロセスアウトソーシング" ;
    sh:description "内部知識不足の補完や必要な時だけの資源利用。丸投げは危険であり、内部人材が指導・仲介者となる必要がある。" .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/LicensedSpecialistShape>
    a sh:NodeShape ;
    sh:targetClass ex:LicensedSpecialist ;
    sh:name "士業専門家" ;
    sh:description "弁護士、弁理士、税理士、公認会計士、社会保険労務士など法令領域の専門家。内部知識の不足を補う。" .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/LawShape>
    a sh:NodeShape ;
    sh:targetClass ex:Law ;
    sh:name "法令" ;
    sh:description "会社法、独占禁止法、下請法、労働基準法、税法、会計基準、特許法、金融商品取引法、労働者派遣法など。ほぼ毎年改正される。" .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/StakeholderShape>
    a sh:NodeShape ;
    sh:targetClass ex:Stakeholder ;
    sh:name "ステークホルダー" ;
    sh:description "税務当局、株主、債権者、銀行、取引先、労働基準監督署など、方針や報告先を形づくる関係者。" .
