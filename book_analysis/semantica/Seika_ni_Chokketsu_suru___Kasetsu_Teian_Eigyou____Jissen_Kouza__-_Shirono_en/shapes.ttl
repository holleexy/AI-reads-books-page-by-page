<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/HypothesisLevelShape>
    a sh:NodeShape ;
    sh:targetClass ex:HypothesisLevel ;
    sh:name "仮説レベル" ;
    sh:description "エリア特化・企業規模特化・業界特化・企業特化の四段階。レベルが上がるほど案件化率と共感が高まる。" ;
    sh:property [
        sh:path ex:levelName ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/InformationSourceShape>
    a sh:NodeShape ;
    sh:targetClass ex:InformationSource ;
    sh:name "情報源" ;
    sh:description "SPEEDA、Googleアラート、RSSリーダーなど仮説立案のための調査手段。" .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/ProposalMaterialShape>
    a sh:NodeShape ;
    sh:targetClass ex:ProposalMaterial ;
    sh:name "提案資料" ;
    sh:description "初回商談で導入必要性を伝える資料。情報過多を避け、Whyと起こり得る結果を中心に構成する。" ;
    sh:property [
        sh:path ex:proposedToCustomer ;
        sh:class ex:Customer ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:includesCaseStudy ;
        sh:class ex:CaseStudy ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:presentedInMeeting ;
        sh:class ex:SalesMeeting ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:title ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:goal ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/CaseStudyShape>
    a sh:NodeShape ;
    sh:targetClass ex:CaseStudy ;
    sh:name "導入事例" ;
    sh:description "同業種・同規模を優先して示す事例。検討中・検証・導入の段階と具体的社数で訴求する。" ;
    sh:property [
        sh:path ex:title ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/SalesMeetingShape>
    a sh:NodeShape ;
    sh:targetClass ex:SalesMeeting ;
    sh:name "商談" ;
    sh:description "仮説提示、ヒアリング、質疑、クロージングで構成される顧客との商談。" ;
    sh:property [
        sh:path ex:hasMeetingPhase ;
