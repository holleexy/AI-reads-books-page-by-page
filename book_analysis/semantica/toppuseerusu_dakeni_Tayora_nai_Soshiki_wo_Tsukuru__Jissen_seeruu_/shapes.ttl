    a sh:NodeShape ;
    sh:targetClass ex:SalesKPI ;
    sh:name "営業KPI" ;
    sh:description "目標達成の柱に沿って設定される注力営業指標。イネーブルメント施策の改善起点となる。" .

<https://books.local/toppuseerusu_dakeni_Tayora_nai_Soshiki_wo_Tsukuru__Jissen_seeruu_/SalesGoalShape>
    a sh:NodeShape ;
    sh:targetClass ex:SalesGoal ;
    sh:name "営業目標" ;
    sh:description "達成すべき売上などの定量的ゴール。計画段階で戦略および注力指標と合わせて明確化する。" .

<https://books.local/toppuseerusu_dakeni_Tayora_nai_Soshiki_wo_Tsukuru__Jissen_seeruu_/SalesStrategyShape>
    a sh:NodeShape ;
    sh:targetClass ex:SalesStrategy ;
    sh:name "営業戦略" ;
    sh:description "注力顧客・チャネル・製品など目標達成の柱を含む戦略。イネーブルメント施策はこれに沿って統合実行する。" ;
    sh:property [
        sh:path ex:hasGoal ;
        sh:class ex:SalesGoal ;
        sh:severity sh:Violation
    ] .

<https://books.local/toppuseerusu_dakeni_Tayora_nai_Soshiki_wo_Tsukuru__Jissen_seeruu_/SalesPlayShape>
    a sh:NodeShape ;
    sh:targetClass ex:SalesPlay ;
    sh:name "セールス・プレイ" ;
    sh:description "現場スペシャリストのナレッジを集約し、製品ごとの売り方をパッケージ化した実践的営業コンテンツ。" .
