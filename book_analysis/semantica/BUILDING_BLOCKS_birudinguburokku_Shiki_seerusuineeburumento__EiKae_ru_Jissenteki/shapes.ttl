    a sh:NodeShape ;
    sh:targetClass ex:SupportService ;
    sh:name "営業サポートサービス" ;
    sh:description "領域専門家、提案依頼書支援、ディールデスク、外部コーチングなど、コミュニケーション一元化とナレッジマネジメントを支えるサービス。" .

<https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/PerformanceConsultingShape>
    a sh:NodeShape ;
    sh:targetClass ex:PerformanceConsulting ;
    sh:name "パフォーマンスコンサルティング" ;
    sh:description "トレーニングでは解決できない組織的要因や個人的要因の根本原因を分析し継続的改善を行う、セールスイネーブルメントの最終形。" .

<https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/MetricShape>
    a sh:NodeShape ;
    sh:targetClass ex:Metric ;
    sh:name "指標" ;
    sh:description "憲章で定義される先行指標と遅行指標。現状診断のギャップ分析や影響分析にも用いる。" ;
    sh:property [
        sh:path ex:hasObjective ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .
