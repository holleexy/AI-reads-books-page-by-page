<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="https://books.local/SHIFT_Kaibou/">
    <rdfs:label>SHIFT_KaibouOntology</rdfs:label>
    <owl:versionInfo>1.0</owl:versionInfo>
  </owl:Ontology>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/Company">
    <rdfs:label xml:lang="ja">会社</rdfs:label>
    <rdfs:comment xml:lang="ja">ソフトウェアのテスト・品質保証などを行う企業組織</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/Person">
    <rdfs:label xml:lang="ja">人物</rdfs:label>
    <rdfs:comment xml:lang="ja">経営者・社員など組織に関わる個人</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/Executive">
    <rdfs:label xml:lang="ja">経営陣</rdfs:label>
    <rdfs:comment xml:lang="ja">創業者社長・CHRO・会長など経営を担う人物</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/SHIFT_Kaibou/Person"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/Employee">
    <rdfs:label xml:lang="ja">社員</rdfs:label>
    <rdfs:comment xml:lang="ja">多様なバックグラウンドを持つ従業員。IT未経験者も含む</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/SHIFT_Kaibou/Person"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/Location">
    <rdfs:label xml:lang="ja">所在地</rdfs:label>
    <rdfs:comment xml:lang="ja">本社オフィスなどの地理的拠点</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/Business">
    <rdfs:label xml:lang="ja">事業</rdfs:label>
    <rdfs:comment xml:lang="ja">ソフトウェアテスト、コンサルティング、システム開発などの事業領域</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/ManagementPhilosophy">
    <rdfs:label xml:lang="ja">経営理念</rdfs:label>
    <rdfs:comment xml:lang="ja">コアな価値の探求、エリート主義の否定、99パーセントの底上げなどの思想</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/HumanCapitalManagement">
    <rdfs:label xml:lang="ja">人的資本経営</rdfs:label>
    <rdfs:comment xml:lang="ja">学歴・職歴・年齢を問わず多様な人材の能力を極限まで引き出す経営</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/ProcessTechnology">
    <rdfs:label xml:lang="ja">プロセス・テクノロジー</rdfs:label>
    <rdfs:comment xml:lang="ja">暗黙知や非効率な業務を分解・可視化・標準化する手法</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/Aptitude">
    <rdfs:label xml:lang="ja">素養</rdfs:label>
    <rdfs:comment xml:lang="ja">属性ではなくパターン認識などテスト業務に必要な基礎的能力</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/RecruitmentStrategy">
    <rdfs:label xml:lang="ja">採用戦略</rdfs:label>
    <rdfs:comment xml:lang="ja">属性を排除し素養を見抜く桜木花道型の採用アプローチ</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/CATTest">
    <rdfs:label xml:lang="ja">CAT検定</rdfs:label>
    <rdfs:comment xml:lang="ja">専門知識を問わず素養を判定するオンライン適性テスト</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/AISystem">
    <rdfs:label xml:lang="ja">AIシステム</rdfs:label>
    <rdfs:comment xml:lang="ja">レジュミル、AI面接官、めん太など人事・採用に用いる人工知能</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/EvaluationMeeting">
    <rdfs:label xml:lang="ja">評価会議</rdfs:label>
    <rdfs:comment xml:lang="ja">役員が全社員の年収を一人ずつ実額で決める会議</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/CompensationSystem">
    <rdfs:label xml:lang="ja">報酬制度</rdfs:label>
    <rdfs:comment xml:lang="ja">市場価値絶対主義と先行投資としての給与に基づく実力主義報酬</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/TopGunSystem">
    <rdfs:label xml:lang="ja">TopGun制度</rdfs:label>
    <rdfs:comment xml:lang="ja">スキル分解と検定合格を年収に直結させる任意の能力開発制度</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/HitoLog">
    <rdfs:label xml:lang="ja">ヒトログ</rdfs:label>
    <rdfs:comment xml:lang="ja">450項目超の社員データを管理し退職リスクを予測する人材システム</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/LifetimeValue">
    <rdfs:label xml:lang="ja">生涯価値</rdfs:label>
    <rdfs:comment xml:lang="ja">人数・在籍期間・価値総出力で人事施策効果を定量化する指標</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/OrganizationalCulture">
    <rdfs:label xml:lang="ja">組織文化</rdfs:label>
    <rdfs:comment xml:lang="ja">イベント・部活・オフィスを教会と捉えるウェットな関係性</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/InternalEvent">
    <rdfs:label xml:lang="ja">社内イベント</rdfs:label>
    <rdfs:comment xml:lang="ja">エンゲージメント向上のための行事・部活動・社内ラジオ・表彰</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/Office">
    <rdfs:label xml:lang="ja">オフィス</rdfs:label>
    <rdfs:comment xml:lang="ja">アイデンティティ確認の場として定義される職場空間</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/SalesStrategy">
    <rdfs:label xml:lang="ja">営業戦略</rdfs:label>
    <rdfs:comment xml:lang="ja">組織的営業と多重下請け構造打破を目指す営業改革</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/HRBusinessPartner">
    <rdfs:label xml:lang="ja">人事ビジネスパートナー</rdfs:label>
    <rdfs:comment xml:lang="ja">事業目標から採用ペルソナを逆算し事業と人事を同期させる役割</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/SHIFT_Kaibou/LastMileRole">
    <rdfs:label xml:lang="ja">ラストワンマイル</rdfs:label>
    <rdfs:comment xml:lang="ja">自動化後に人間が担う繊細な仕上げやAI統括の役割</rdfs:comment>
  </owl:Class>

