<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/">
    <rdfs:label>Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__YuusaiOntology</rdfs:label>
    <owl:versionInfo>1.0</owl:versionInfo>
  </owl:Ontology>

  <owl:Class rdf:about="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/Book">
    <rdfs:label xml:lang="ja">書籍</rdfs:label>
    <rdfs:comment xml:lang="ja">『頭のいい人が話す前に考えていること』のように、話す前の思考法と習慣を扱う書籍を表す。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/Person">
    <rdfs:label xml:lang="ja">人物</rdfs:label>
    <rdfs:comment xml:lang="ja">著者、理論の提唱者、経営者、聞き手など、コミュニケーションに関わる人物。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/Author">
    <rdfs:label xml:lang="ja">著者</rdfs:label>
    <rdfs:comment xml:lang="ja">コンサルタント経験に基づき社会的知性の実践法をまとめた書籍の執筆者。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/Person"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/GoldenRule">
    <rdfs:label xml:lang="ja">黄金法則</rdfs:label>
    <rdfs:comment xml:lang="ja">知性を感じさせ信頼を得るためのマインドの基盤。感情制御、他者評価、承認欲求の扱いなどを含む。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/ThinkingForm">
    <rdfs:label xml:lang="ja">思考の型</rdfs:label>
    <rdfs:comment xml:lang="ja">思考を深め適切に伝えるためのフォーム。客観視、整理、傾聴、言語化の四類型がある。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/ObjectiveThinking">
    <rdfs:label xml:lang="ja">客観視の思考法</rdfs:label>
    <rdfs:comment xml:lang="ja">根拠の薄い情報や認知バイアスを避け、言葉の定義を共有して話を浅くしない思考法。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/ThinkingForm"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/OrganizingThinking">
    <rdfs:label xml:lang="ja">整理の思考法</rdfs:label>
    <rdfs:comment xml:lang="ja">重要な情報と雑多な情報、事実と意見を峻別し、結論からわかりやすく話す思考法。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/ThinkingForm"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/ListeningThinking">
    <rdfs:label xml:lang="ja">傾聴の思考法</rdfs:label>
    <rdfs:comment xml:lang="ja">相手の真意を探り、アドバイスより整理を行い、構造化面接や仮説質問で深く聞く思考法。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/ThinkingForm"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/VerbalizationThinking">
    <rdfs:label xml:lang="ja">言語化の思考法</rdfs:label>
    <rdfs:comment xml:lang="ja">言語化コストを自ら負担し、再定義・ネーミング・語彙・読書ノートでアウトプットの質を高める思考法。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/ThinkingForm"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/Concept">
    <rdfs:label xml:lang="ja">概念</rdfs:label>
    <rdfs:comment xml:lang="ja">社会的知性、知的謙虚さ、結果は話す前に決まる、など本書の中核的な考え方。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/SocialIntelligence">
    <rdfs:label xml:lang="ja">社会的知性</rdfs:label>
    <rdfs:comment xml:lang="ja">頭のよさは生まれつきではなく後天的に身につけられるSQであり、他者の思考を読み信頼を得て動かす能力。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/Concept"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/CognitiveBias">
    <rdfs:label xml:lang="ja">認知バイアス</rdfs:label>
    <rdfs:comment xml:lang="ja">確証バイアスや後知恵バイアスなど、客観視と論理的な遅い思考を妨げる認知の歪み。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/Concept"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/Technique">
    <rdfs:label xml:lang="ja">実践技法</rdfs:label>
    <rdfs:comment xml:lang="ja">アンガーマネジメント、並列評価、構造化面接、再定義、ノウハウメモなど具体的な手法。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Atama_noii_Nin_ga_Hanasu_Mae_ni_Kangae_teirukoto__-_Adachi__Yuusai/Communication">
    <rdfs:label xml:lang="ja">コミュニケーション</rdfs:label>
    <rdfs:comment xml:lang="ja">プレゼンや商談、大切な人との対話など、話す前のプロセスが結果を左右する対人伝達。</rdfs:comment>
  </owl:Class>

