        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:conductedWith ;
        sh:class ex:Customer ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:durationNote ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:goal ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/MeetingPhaseShape>
    a sh:NodeShape ;
    sh:targetClass ex:MeetingPhase ;
    sh:name "商談フェーズ" ;
    sh:description "オープニング、ボディ、クロージングなど商談の時間配分単位。" ;
    sh:property [
        sh:path ex:description ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:durationNote ;
        sh:datatype xsd:string ;
