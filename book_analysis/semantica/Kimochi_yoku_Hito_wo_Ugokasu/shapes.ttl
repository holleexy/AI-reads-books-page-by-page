@prefix ex: <https://books.local/Kimochi_yoku_Hito_wo_Ugokasu/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://books.local/Kimochi_yoku_Hito_wo_Ugokasu/shapes> a owl:Ontology .

<https://books.local/Kimochi_yoku_Hito_wo_Ugokasu/BookShape>
    a sh:NodeShape ;
    sh:targetClass ex:Book ;
    sh:name "書籍" ;
    sh:description "人を動かすコミュニケーション術を扱う対象書籍。正論だけでは人は動かないという出発点を持つ。" ;
    sh:property [
        sh:path ex:labelText ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Kimochi_yoku_Hito_wo_Ugokasu/CommunicationApproachShape>
    a sh:NodeShape ;
    sh:targetClass ex:CommunicationApproach ;
    sh:name "コミュニケーションアプローチ" ;
    sh:description "合意形成に用いる対話の進め方の総称。競争的議論と共創的議論を含む。" ;
    sh:property [
        sh:path ex:appliedToSituation ;
        sh:class ex:BusinessSituation ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:describedInBook ;
        sh:class ex:Book ;
        sh:severity sh:Violation
    ] .

<https://books.local/Kimochi_yoku_Hito_wo_Ugokasu/CompetitiveDiscussionShape>
    a sh:NodeShape ;
    sh:targetClass ex:CompetitiveDiscussion ;
    sh:name "競い争うディスカッション" ;
    sh:description "相手を説得・論破する競争的な議論。正しさの押し付けにより抵抗や思考停止を招く。" ;
    sh:property [
        sh:path ex:triggeredByBias ;
        sh:class ex:Bias ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:appliedToSituation ;
        sh:class ex:BusinessSituation ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:describedInBook ;
        sh:class ex:Book ;
        sh:severity sh:Violation
    ] .

<https://books.local/Kimochi_yoku_Hito_wo_Ugokasu/CoCreativeDiscussionShape>
    a sh:NodeShape ;
    sh:targetClass ex:CoCreativeDiscussion ;
    sh:name "共に創るディスカッション" ;
    sh:description "相手の意見を引き出し、一緒により良い結論を生み出すコ・クリエーション型の議論。" ;
    sh:property [
        sh:path ex:treatsAsMaterial ;
        sh:class ex:Obstacle ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:appliedToSituation ;
        sh:class ex:BusinessSituation ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:describedInBook ;
        sh:class ex:Book ;
        sh:severity sh:Violation
    ] .

<https://books.local/Kimochi_yoku_Hito_wo_Ugokasu/BiasShape>
    a sh:NodeShape ;
    sh:targetClass ex:Bias ;
    sh:name "バイアス" ;
    sh:description "判断や行動を歪める認知上の偏り。現状維持や経験則に基づく思い込みを含む。" .

<https://books.local/Kimochi_yoku_Hito_wo_Ugokasu/StatusQuoBiasShape>
    a sh:NodeShape ;
    sh:targetClass ex:StatusQuoBias ;
    sh:name "現状維持バイアス" ;
    sh:description "変化を嫌い現状を維持しようとする心理。正論の押し付けが抵抗を生む原因となる。" .

<https://books.local/Kimochi_yoku_Hito_wo_Ugokasu/HeuristicShape>
    a sh:NodeShape ;
    sh:targetClass ex:Heuristic ;
    sh:name "ヒューリスティック" ;
    sh:description "経験則に基づく速い判断。代表性、利用可能性、固着性、シミュレーションの四種がある。" .

<https://books.local/Kimochi_yoku_Hito_wo_Ugokasu/CoreSkillShape>
    a sh:NodeShape ;
    sh:targetClass ex:CoreSkill ;
    sh:name "コアスキル" ;
    sh:description "共に創るディスカッションを実践し四つの壁を越えるための七つの中核技能。" ;
    sh:property [
        sh:path ex:overcomesWall ;
        sh:class ex:PsychologicalWall ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:usesFramework ;
        sh:class ex:Framework ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:appliedToSituation ;
        sh:class ex:BusinessSituation ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:supportsApproach ;
        sh:class ex:CoCreativeDiscussion ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:describedInBook ;
        sh:class ex:Book ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:labelText ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

