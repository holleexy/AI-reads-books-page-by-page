<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/">
    <rdfs:label>Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_KouichOntology</rdfs:label>
    <owl:versionInfo>1.0</owl:versionInfo>
  </owl:Ontology>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/Book">
    <rdfs:label xml:lang="ja">書籍</rdfs:label>
    <rdfs:comment xml:lang="ja">無敗営業の知見をまとめた分析対象の書籍。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/Author">
    <rdfs:label xml:lang="ja">著者</rdfs:label>
    <rdfs:comment xml:lang="ja">上場企業中心に三万人以上を指導し、八年無敗・受注率八割を維持した執筆者。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SalesPerson">
    <rdfs:label xml:lang="ja">営業担当者</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客との情報ギャップを解消し案件を推進する売り手。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/HighPerformer">
    <rdfs:label xml:lang="ja">ハイパフォーマー</rdfs:label>
    <rdfs:comment xml:lang="ja">商談前後の連絡・資料分割・早期の社内巻き込みを欠かさない高成果営業。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SalesPerson"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/LowPerformer">
    <rdfs:label xml:lang="ja">ローパフォーマー</rdfs:label>
    <rdfs:comment xml:lang="ja">対面商談だけで勝負し、資料を一気に作成しがちな低成果営業。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SalesPerson"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/Customer">
    <rdfs:label xml:lang="ja">顧客</rdfs:label>
    <rdfs:comment xml:lang="ja">価格そのものではなく費用対効果の納得感で判断し、建前で断りやすい買い手。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SalesPhilosophy">
    <rdfs:label xml:lang="ja">営業理念</rdfs:label>
    <rdfs:comment xml:lang="ja">営業は根性ではなくステップ・バイ・ステップの体系化可能なスキルであるという思想。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/InformationGap">
    <rdfs:label xml:lang="ja">情報ギャップ</rdfs:label>
    <rdfs:comment xml:lang="ja">売り手と買い手の間に生じるズレであり、本書が解消すべき本質的課題。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SalesPower">
    <rdfs:label xml:lang="ja">四つの力</rdfs:label>
    <rdfs:comment xml:lang="ja">四つのズレを構造的に解消するための営業能力の総称。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/QuestioningPower">
    <rdfs:label xml:lang="ja">質問力</rdfs:label>
    <rdfs:comment xml:lang="ja">要件ヒアリング不足という最大の失望要因を解消する力。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SalesPower"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/ValuePropositionPower">
    <rdfs:label xml:lang="ja">価値訴求力</rdfs:label>
    <rdfs:comment xml:lang="ja">魅力や価値を感じてもらえないズレを解消し、選ばれる理由をつくる力。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SalesPower"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/ProposalActionPower">
    <rdfs:label xml:lang="ja">提案行動力</rdfs:label>
    <rdfs:comment xml:lang="ja">レスポンスや動きの悪さを解消し、全ての力を回す実行力。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SalesPower"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/ProposalLogicConstructionPower">
    <rdfs:label xml:lang="ja">提案ロジック構築力</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客の意図に沿わない提案を防ぎ、社内稟議で語れる選ぶ理由を組み立てる力。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SalesPower"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SalesCase">
    <rdfs:label xml:lang="ja">営業案件</rdfs:label>
    <rdfs:comment xml:lang="ja">難易度に応じてリソース投下先を見極める対象となる商談機会。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/EasyWinCase">
    <rdfs:label xml:lang="ja">楽勝案件</rdfs:label>
    <rdfs:comment xml:lang="ja">誰が担当しても受注できる既存・予算確保済みなどの案件。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SalesCase"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SureLossCase">
    <rdfs:label xml:lang="ja">惨敗案件</rdfs:label>
    <rdfs:comment xml:lang="ja">競合が深く浸透し当て馬になりやすい、誰が担当しても受注が難しい案件。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SalesCase"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/CloseContestCase">
    <rdfs:label xml:lang="ja">接戦案件</rdfs:label>
    <rdfs:comment xml:lang="ja">やり方次第で受注にも失注にもなる、最も重要な案件。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SalesCase"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/CloseContestPattern">
    <rdfs:label xml:lang="ja">接戦パターン</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客が何と何で迷っているかを把握するための迷いの類型。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/CompetitorHesitation">
    <rdfs:label xml:lang="ja">他社との迷い</rdfs:label>
    <rdfs:comment xml:lang="ja">コンペや相見積もりで競合他社と比較している接戦。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/CloseContestPattern"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/PostponementHesitation">
    <rdfs:label xml:lang="ja">保留との迷い</rdfs:label>
    <rdfs:comment xml:lang="ja">今やるべきか後回しにすべきかを顧客が迷っている接戦。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/CloseContestPattern"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/InhouseHesitation">
    <rdfs:label xml:lang="ja">内製との迷い</rdfs:label>
    <rdfs:comment xml:lang="ja">外注すべきか自社でやるべきかを顧客が迷っている接戦。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/CloseContestPattern"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/WinningQuestion">
    <rdfs:label xml:lang="ja">三つの質問</rdfs:label>
    <rdfs:comment xml:lang="ja">情報ギャップを埋め接戦を制するための質問フレームワーク。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/ContestSituationQuestion">
    <rdfs:label xml:lang="ja">接戦状況を問う質問</rdfs:label>
    <rdfs:comment xml:lang="ja">案件発生直後に他社状況や暫定順位、BANTCHを確認する質問。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/WinningQuestion"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/DecisionSceneQuestion">
    <rdfs:label xml:lang="ja">決定の場面を問う質問</rdfs:label>
    <rdfs:comment xml:lang="ja">決着後に、理由ではなく心が動いた瞬間や場面という事実を聞く質問。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/WinningQuestion"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/BackgroundQuestion">
    <rdfs:label xml:lang="ja">裏にある背景を問う質問</rdfs:label>
    <rdfs:comment xml:lang="ja">枕詞を用い、顧客自身も気づいていない潜在課題を引き出す汎用質問。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/WinningQuestion"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/HearingPhase">
    <rdfs:label xml:lang="ja">商談フェーズ</rdfs:label>
    <rdfs:comment xml:lang="ja">ヒアリングを土台作りから具体化まで進める四段階。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/FoundationPhase">
    <rdfs:label xml:lang="ja">土台作り</rdfs:label>
    <rdfs:comment xml:lang="ja">信頼感・自己開示・興味関心でつかみとアイスブレイクを行う段階。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/HearingPhase"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/BidirectionalHearingPhase">
    <rdfs:label xml:lang="ja">双方向な聞く</rdfs:label>
    <rdfs:comment xml:lang="ja">一方通行を避け、誠実な応答と枕詞でヒアリングへ切り込む段階。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/HearingPhase"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/DeepListeningPhase">
    <rdfs:label xml:lang="ja">深掘りする聴く</rdfs:label>
    <rdfs:comment xml:lang="ja">ピラミッド構造で発言割合を増やし、なぜかを掘り下げる段階。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/HearingPhase"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SpecifyingAskingPhase">
    <rdfs:label xml:lang="ja">具体化する訊く</rdfs:label>
    <rdfs:comment xml:lang="ja">条件付きオープン質問や選択肢付きクローズド質問でピンポイント情報を得る段階。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/HearingPhase"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/ProblemSolvingQuestion">
    <rdfs:label xml:lang="ja">課題解決質問</rdfs:label>
    <rdfs:comment xml:lang="ja">現状把握・深掘り・気づかせ・つなぎからなるSPIN応用の質問群。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/ValueQuadrant">
    <rdfs:label xml:lang="ja">価値の四象限</rdfs:label>
    <rdfs:comment xml:lang="ja">機能価値と情緒価値の二軸で顧客価値を四ゾーンに分類する枠組み。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/LaborProvision">
    <rdfs:label xml:lang="ja">労務提供</rdfs:label>
    <rdfs:comment xml:lang="ja">事務作業や手間を代行する、経験の浅い営業でも実行しやすい価値。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/ValueQuadrant"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/AffinityEmpathy">
    <rdfs:label xml:lang="ja">好感・共感</rdfs:label>
    <rdfs:comment xml:lang="ja">マナーや人柄を通じパートナーとしての安心感を与える情緒価値。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/ValueQuadrant"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/InformationProvision">
    <rdfs:label xml:lang="ja">情報提供・人の紹介</rdfs:label>
    <rdfs:comment xml:lang="ja">業界知識や有益な人脈を提供する機能的価値。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/ValueQuadrant"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/PlusAlphaProposal">
    <rdfs:label xml:lang="ja">プラスアルファ・提言</rdfs:label>
    <rdfs:comment xml:lang="ja">優先課題に寄り添う斬新なアイデアと付加価値の高い提案。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/ValueQuadrant"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SalesModel">
    <rdfs:label xml:lang="ja">営業モデル</rdfs:label>
    <rdfs:comment xml:lang="ja">リスト数とリードタイムに応じて勝ちパターンと力の重心が変わる営業様式。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/RouteSales">
    <rdfs:label xml:lang="ja">ルート型営業</rdfs:label>
    <rdfs:comment xml:lang="ja">数百件の短期リストを行動量で回し、質問力・価値訴求力・提案行動力を重心とする型。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SalesModel"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/AccountSales">
    <rdfs:label xml:lang="ja">アカウント型営業</rdfs:label>
    <rdfs:comment xml:lang="ja">少数大口を論理で深掘りし、質問力・価値訴求力・提案ロジック構築力を重心とする型。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/SalesModel"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/AnalysisFramework">
    <rdfs:label xml:lang="ja">分析フレームワーク</rdfs:label>
    <rdfs:comment xml:lang="ja">案件把握や関係構築、逆転論理に用いる思考枠組みの総称。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/BANTCH">
    <rdfs:label xml:lang="ja">バンチ</rdfs:label>
    <rdfs:comment xml:lang="ja">予算・決裁・ニーズ・時期・競合・人数で案件の真の状況を見極める確認枠。</rdfs:comment>
