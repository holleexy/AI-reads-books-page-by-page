    <rdfs:label xml:lang="ja">プロセスの一部である</rdfs:label>
    <rdfs:comment xml:lang="ja">各購買ステージが5段階購買プロセスに属する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/法人営業勝ちパターン大全/PurchasingStage"/>
    <rdfs:range rdf:resource="https://books.local/法人営業勝ちパターン大全/PurchasingProcess"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/法人営業勝ちパターン大全/hasProposal">
