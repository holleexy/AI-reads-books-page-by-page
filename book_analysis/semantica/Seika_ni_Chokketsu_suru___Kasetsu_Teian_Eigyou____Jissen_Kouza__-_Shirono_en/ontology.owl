    <rdfs:label xml:lang="ja">仮説レベルを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">仮説の具体性（エリア・規模・業界・企業特化）を示す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/Hypothesis"/>
