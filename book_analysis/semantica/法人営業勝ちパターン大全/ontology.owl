    <rdfs:range rdf:resource="https://books.local/法人営業勝ちパターン大全/InfluenceMap"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/法人営業勝ちパターン大全/hasLeadPersonPhase">
    <rdfs:label xml:lang="ja">リードパーソンフェーズを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">個人単位の関係深化段階。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/法人営業勝ちパターン大全/Stakeholder"/>
    <rdfs:domain rdf:resource="https://books.local/法人営業勝ちパターン大全/Customer"/>
    <rdfs:range rdf:resource="https://books.local/法人営業勝ちパターン大全/LeadPersonPhase"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/法人営業勝ちパターン大全/constructs">
    <rdfs:label xml:lang="ja">構築する</rdfs:label>
    <rdfs:comment xml:lang="ja">シートと共通言語で勝ちパターンを再現可能にする。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/法人営業勝ちパターン大全/WinningPatternConstructionSheet"/>
    <rdfs:domain rdf:resource="https://books.local/法人営業勝ちパターン大全/SalesMethodology"/>
    <rdfs:range rdf:resource="https://books.local/法人営業勝ちパターン大全/WinningPattern"/>
  </owl:ObjectProperty>

