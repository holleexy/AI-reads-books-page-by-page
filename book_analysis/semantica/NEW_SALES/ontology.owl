    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/SympathySales"/>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/Salesperson"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/PersonalityType"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/sharesKnowledge">
    <rdfs:label xml:lang="ja">ナレッジを共有する</rdfs:label>
