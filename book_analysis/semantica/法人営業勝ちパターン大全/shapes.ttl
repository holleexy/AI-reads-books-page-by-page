    sh:targetClass ex:BuyerType ;
    sh:name "購買者タイプ" ;
    sh:description "論理型27.2%、感情型14.9%、政治型57.9%。過半数は「安全か・他者はどう思うか」の政治型。" .

<https://books.local/法人営業勝ちパターン大全/LogicalBuyerShape>
    a sh:NodeShape ;
    sh:targetClass ex:LogicalBuyer ;
    sh:name "論理型購買者" ;
