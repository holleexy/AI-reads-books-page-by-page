    sh:targetClass ex:ResearchFinding ;
    sh:name "調査知見" ;
    sh:description "購買経験者を含む約2万4千人調査と10万件超の苦情分析から得た、裏側とプロセス最適化に関する知見。" ;
    sh:property [
        sh:path ex:description ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .
