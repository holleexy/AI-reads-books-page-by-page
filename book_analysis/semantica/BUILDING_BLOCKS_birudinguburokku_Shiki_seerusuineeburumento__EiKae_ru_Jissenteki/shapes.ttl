    sh:targetClass ex:Onboarding ;
    sh:name "営業オンボーディング" ;
    sh:description "パフォーマンスマイルストーン、チャンク・シーケンス・レイヤー、反転学習、間隔反復、ロールプレイ、レディネス検証、七十・二十・十の法則により新入社員を早期戦力化する取組。" ;
    sh:property [
