    ] .

<https://books.local/toppuseerusu_dakeni_Tayora_nai_Soshiki_wo_Tsukuru__Jissen_seeruu_/KnowledgeManagementShape>
    a sh:NodeShape ;
    sh:targetClass ex:KnowledgeManagement ;
    sh:name "ナレッジマネジメント" ;
    sh:description "成功事例の収集と流通サイクルを回し、営業がすぐ使える最新の武器を提供する取り組み。" ;
    sh:property [
