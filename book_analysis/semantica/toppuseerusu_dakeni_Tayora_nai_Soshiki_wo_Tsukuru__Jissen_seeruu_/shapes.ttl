    a sh:NodeShape ;
    sh:targetClass ex:ManagerEnablement ;
    sh:name "マネジャー・イネーブルメント" ;
    sh:description "営業マネジャー向けの定着支援。現場への施策浸透と実践形式トレーニングの効果を加速する。" ;
