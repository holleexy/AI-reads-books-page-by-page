    <rdfs:label xml:lang="ja">思考法を用いる</rdfs:label>
    <rdfs:comment xml:lang="ja">仮説提案営業が依拠する思考法。主に仮説思考。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/HypothesisProposalSales"/>
