    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/HowMightWe"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/generates">
    <rdfs:label xml:lang="ja">生成する</rdfs:label>
    <rdfs:comment xml:lang="ja">生成段階や手法がアイデアを生み出す関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/IdeaGeneration"/>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/FunctionAnalysisMethod"/>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/MorphologicalChartMethod"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/Idea"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/usesMethod">
    <rdfs:label xml:lang="ja">手法を用いる</rdfs:label>
    <rdfs:comment xml:lang="ja">アイデア生成が機能解析法や形態チャート法を用いる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/IdeaGeneration"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/FunctionAnalysisMethod"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/MorphologicalChartMethod"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/verifiesWith">
    <rdfs:label xml:lang="ja">検証する</rdfs:label>
    <rdfs:comment xml:lang="ja">アイデアをプロトタイプやリーン・スタートアップで検証する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/IdeaVerification"/>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Idea"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/Prototype"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/LeanStartup"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/facilitates">
    <rdfs:label xml:lang="ja">促進する</rdfs:label>
    <rdfs:comment xml:lang="ja">リサーチャーが対話・ワークショップ・問い立てをファシリテートする関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Researcher"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/Dialogue"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/Workshop"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/ResearchQuestion"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/possesses">
    <rdfs:label xml:lang="ja">備える</rdfs:label>
    <rdfs:comment xml:lang="ja">リサーチャーや個人がネガティブ・ケイパビリティや衝動・自信を備える関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Researcher"/>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Individual"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/NegativeCapability"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/ExploratoryImpulse"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/CreativeConfidence"/>
