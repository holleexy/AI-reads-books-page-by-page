    <rdfs:range rdf:resource="https://books.local/バックオフィス業務のすべてがわかる本.ocr/Stakeholder"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/バックオフィス業務のすべてがわかる本.ocr/appliesPrinciple">
    <rdfs:label xml:lang="ja">原則を適用する</rdfs:label>
    <rdfs:comment xml:lang="ja">経理財務や複式簿記が発生主義などの会計原則を適用する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/バックオフィス業務のすべてがわかる本.ocr/AccountingFinance"/>
