@prefix ex: <https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/shapes> a owl:Ontology .

<https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/BookShape>
    a sh:NodeShape ;
    sh:targetClass ex:Book ;
    sh:name "書籍" ;
    sh:description "無敗営業の知見をまとめた分析対象の書籍。" ;
    sh:property [
        sh:path ex:writtenBy ;
        sh:class ex:Author ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasPhilosophy ;
        sh:class ex:SalesPhilosophy ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:describedAs ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/AuthorShape>
    a sh:NodeShape ;
    sh:targetClass ex:Author ;
    sh:name "著者" ;
    sh:description "上場企業中心に三万人以上を指導し、八年無敗・受注率八割を維持した執筆者。" ;
    sh:property [
        sh:path ex:hasPhilosophy ;
        sh:class ex:SalesPhilosophy ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:trains ;
        sh:class ex:SalesPerson ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:describedAs ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:statisticValue ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

