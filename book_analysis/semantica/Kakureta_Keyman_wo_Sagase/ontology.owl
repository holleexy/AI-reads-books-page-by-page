  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Kakureta_Keyman_wo_Sagase/facilitates">
    <rdfs:label xml:lang="ja">促進する</rdfs:label>
    <rdfs:comment xml:lang="ja">販売員が関係者間の共通言語と共通ビジョンの構築を主導する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Kakureta_Keyman_wo_Sagase/Salesperson"/>
    <rdfs:range rdf:resource="https://books.local/Kakureta_Keyman_wo_Sagase/CollectiveLearning"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Kakureta_Keyman_wo_Sagase/obstructs">
    <rdfs:label xml:lang="ja">阻害する</rdfs:label>
    <rdfs:comment xml:lang="ja">ブロッカーが変革と高品質契約の成立を妨害する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Kakureta_Keyman_wo_Sagase/Blocker"/>
    <rdfs:range rdf:resource="https://books.local/Kakureta_Keyman_wo_Sagase/BuyingProcess"/>
    <rdfs:range rdf:resource="https://books.local/Kakureta_Keyman_wo_Sagase/BuyingCommittee"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Kakureta_Keyman_wo_Sagase/neutralizes">
    <rdfs:label xml:lang="ja">無力化する</rdfs:label>
    <rdfs:comment xml:lang="ja">関係者間の社会的圧力によりブロッカーを封じ込める。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Kakureta_Keyman_wo_Sagase/CollectiveLearning"/>
    <rdfs:range rdf:resource="https://books.local/Kakureta_Keyman_wo_Sagase/Blocker"/>
