    ] .

<https://books.local/法人営業勝ちパターン大全/VendorComparisonShape>
    a sh:NodeShape ;
    sh:targetClass ex:VendorComparison ;
    sh:name "ベンダー比較" ;
    sh:description "正式提案と見積を比較する段階。中身だけでなく検討プロセスで差をつけるガイド戦略の適用対象。" ;
