@prefix ex: <https://books.local/法人営業勝ちパターン大全/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://books.local/法人営業勝ちパターン大全/shapes> a owl:Ontology .

<https://books.local/法人営業勝ちパターン大全/CorporateSalesShape>
    a sh:NodeShape ;
    sh:targetClass ex:CorporateSales ;
    sh:name "法人営業" ;
    sh:description "企業間取引におけるB2B営業。本書の対象領域であり、顧客の裏側を把握することが成果の前提となる。" .

<https://books.local/法人営業勝ちパターン大全/SalesMethodologyShape>
    a sh:NodeShape ;
    sh:targetClass ex:SalesMethodology ;
    sh:name "営業方法論" ;
    sh:description "失注の悔しさから生まれ、約2万4千人の調査と4万人超の営業支援を通じて体系化した再現可能な勝ちパターンの方法論。" ;
    sh:property [
        sh:path ex:constructs ;
        sh:class ex:WinningPattern ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:supportedByFinding ;
        sh:class ex:ResearchFinding ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:description ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/法人営業勝ちパターン大全/SalespersonShape>
    a sh:NodeShape ;
    sh:targetClass ex:Salesperson ;
    sh:name "営業担当者" ;
    sh:description "法人営業を担う個人。顧客の見えない世界を照らす松明を使い、チームで勝ちパターンを再現する主体。" ;
    sh:property [
        sh:path ex:trappedIn ;
        sh:class ex:Maze ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:usesFramework ;
        sh:class ex:Framework ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasProposal ;
        sh:class ex:Proposal ;
        sh:severity sh:Violation
    ] .

<https://books.local/法人営業勝ちパターン大全/CustomerShape>
    a sh:NodeShape ;
    sh:targetClass ex:Customer ;
    sh:name "顧客" ;
    sh:description "購買を行う組織。公式の窓口の背後に複数のキーパーソンと独自の世界観・裏側を持つ。" ;
    sh:property [
        sh:path ex:hasPurchasingStage ;
        sh:class ex:PurchasingStage ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasHiddenWorld ;
        sh:class ex:HiddenCustomerWorld ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasBuyerType ;
        sh:class ex:BuyerType ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasInfluenceMap ;
        sh:class ex:InfluenceMap ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasLeadPersonPhase ;
        sh:class ex:LeadPersonPhase ;
        sh:severity sh:Violation
    ] .

<https://books.local/法人営業勝ちパターン大全/DealShape>
    a sh:NodeShape ;
    sh:targetClass ex:Deal ;
    sh:name "案件" ;
    sh:description "法人営業における商談。神秘的な受注はあっても神秘的な失注はなく、裏側を見れば原因を特定できる。" ;
    sh:property [
        sh:path ex:hasPurchasingStage ;
        sh:class ex:PurchasingStage ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:involvesStakeholder ;
        sh:class ex:Stakeholder ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:belongsToCustomer ;
        sh:class ex:Customer ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:handledBy ;
        sh:class ex:Salesperson ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:trappedIn ;
        sh:class ex:Maze ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasKeyPerson ;
        sh:class ex:KeyPerson ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasInfluenceMap ;
        sh:class ex:InfluenceMap ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasProposal ;
        sh:class ex:Proposal ;
        sh:severity sh:Violation
    ] .

<https://books.local/法人営業勝ちパターン大全/HiddenCustomerWorldShape>
    a sh:NodeShape ;
    sh:targetClass ex:HiddenCustomerWorld ;
    sh:name "顧客の裏側" ;
    sh:description "顧客の世界観と内部事情。これを見通せなければ優れた製品や提案も実を結ばない。" ;
    sh:property [
        sh:path ex:belongsToCustomer ;
        sh:class ex:Customer ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:description ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/法人営業勝ちパターン大全/PurchasingProcessShape>
    a sh:NodeShape ;
    sh:targetClass ex:PurchasingProcess ;
    sh:name "購買プロセス" ;
    sh:description "顧客側の5段階の購買過程。営業の4段階プロセスとは全く異なり、実質決定の66.8%は上流で起きる。" ;
    sh:property [
        sh:path ex:supportedByFinding ;
        sh:class ex:ResearchFinding ;
        sh:severity sh:Violation
    ] .

<https://books.local/法人営業勝ちパターン大全/PurchasingStageShape>
    a sh:NodeShape ;
    sh:targetClass ex:PurchasingStage ;
    sh:name "購買ステージ" ;
    sh:description "課題認識・情報収集・要件定義・ベンダー比較・発注決定のいずれか。現在地の特定が松明の第一歩。" ;
    sh:property [
        sh:path ex:mappedToPattern ;
        sh:class ex:WinningPattern ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:partOfProcess ;
        sh:class ex:PurchasingProcess ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:supportedByFinding ;
        sh:class ex:ResearchFinding ;
        sh:severity sh:Violation
    ] .

<https://books.local/法人営業勝ちパターン大全/IssueRecognitionShape>
    a sh:NodeShape ;
    sh:targetClass ex:IssueRecognition ;
    sh:name "課題認識" ;
    sh:description "事業課題が生じ「何か買う必要があるかも」と感じる段階。エンゲージメント戦略の適用対象。" ;
    sh:property [
        sh:path ex:mappedToPattern ;
        sh:class ex:WinningPattern ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:partOfProcess ;
        sh:class ex:PurchasingProcess ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:supportedByFinding ;
        sh:class ex:ResearchFinding ;
        sh:severity sh:Violation
    ] .

<https://books.local/法人営業勝ちパターン大全/InformationGatheringShape>
    a sh:NodeShape ;
    sh:targetClass ex:InformationGathering ;
    sh:name "情報収集" ;
    sh:description "選択肢を軽く調べる温度の低い段階。相談して安心な相手になるエキスパート戦略の適用対象。" ;
    sh:property [
        sh:path ex:mappedToPattern ;
        sh:class ex:WinningPattern ;
        sh:severity sh:Violation
    ] ;
    sh:property [
