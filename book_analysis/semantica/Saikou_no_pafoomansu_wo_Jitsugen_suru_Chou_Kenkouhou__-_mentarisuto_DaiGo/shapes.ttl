@prefix ex: <https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/shapes> a owl:Ontology .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/BodyClockShape>
    a sh:NodeShape ;
    sh:targetClass ex:BodyClock ;
    sh:name "体内時計" ;
    sh:description "約24.5時間周期の生体リズム。視交叉上核と末端細胞の時計を毎日リセットする必要がある。" .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/ChrononutritionShape>
    a sh:NodeShape ;
    sh:targetClass ex:Chrononutrition ;
    sh:name "時間栄養学" ;
    sh:description "食事の時間と量で時計遺伝子を制御し、運動能力・肥満・メンタルを最適化する考え方。" ;
    sh:property [
        sh:path ex:regulates ;
        sh:class ex:Hormone ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:basedOn ;
        sh:class ex:ResearchFinding ;
        sh:severity sh:Violation
    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/CircadianResetShape>
    a sh:NodeShape ;
    sh:targetClass ex:CircadianReset ;
    sh:name "体内時計リセット" ;
    sh:description "朝日による視交叉上核のリセットと、炭水化物・タンパク質摂取による末端細胞時計のリセット。" ;
    sh:property [
        sh:path ex:resets ;
        sh:class ex:BodyClock ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:practiceMethod ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/SunlightShape>
    a sh:NodeShape ;
    sh:targetClass ex:Sunlight ;
    sh:name "太陽光" ;
    sh:description "朝日は体内時計をリセットし代謝を最適化する。朝8時から12時に20〜30分浴びるとBMI低下が報告される。" ;
    sh:property [
        sh:path ex:resets ;
        sh:class ex:BodyClock ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:improves ;
        sh:class ex:Brain ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:activates ;
        sh:class ex:Hormone ;
        sh:severity sh:Violation
    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/MealShape>
    a sh:NodeShape ;
    sh:targetClass ex:Meal ;
    sh:name "食事" ;
    sh:description "摂取する食べ物のまとまり。1日3食習慣に科学的根拠はなく、石器時代には朝食の常備は不可能だった。" ;
    sh:property [
        sh:path ex:resets ;
        sh:class ex:BodyClock ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:contains ;
        sh:class ex:Nutrient ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:affects ;
        sh:class ex:Sleep ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:basedOn ;
        sh:class ex:ResearchFinding ;
        sh:severity sh:Violation
    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/BreakfastShape>
    a sh:NodeShape ;
    sh:targetClass ex:Breakfast ;
    sh:name "朝食" ;
    sh:description "朝は交感神経が優位で脂肪蓄積しやすいため生理学的には不要。RCTでは朝食抜き群が最も体重減少した。" ;
    sh:property [
        sh:path ex:resets ;
        sh:class ex:BodyClock ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:contains ;
        sh:class ex:Nutrient ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:affects ;
        sh:class ex:Sleep ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:basedOn ;
        sh:class ex:ResearchFinding ;
        sh:severity sh:Violation
    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/FoodShape>
    a sh:NodeShape ;
    sh:targetClass ex:Food ;
    sh:name "食品" ;
    sh:description "健康効果や落とし穴を持つ飲食物。生の果物は適量、ジュースやドライフルーツは糖質濃縮のため避ける。" ;
    sh:property [
        sh:path ex:contains ;
        sh:class ex:Nutrient ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:affects ;
        sh:class ex:Sleep ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:recommendedAmount ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:healthEffect ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/OilShape>
    a sh:NodeShape ;
    sh:targetClass ex:Oil ;
    sh:name "油" ;
    sh:description "ビタミン吸収に必須。エキストラバージンオリーブオイルが推奨され、マーガリンやトランス脂肪酸は避ける。" ;
    sh:property [
        sh:path ex:contains ;
        sh:class ex:Nutrient ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:affects ;
        sh:class ex:Sleep ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:recommendedAmount ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:healthEffect ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/NutrientShape>
    a sh:NodeShape ;
    sh:targetClass ex:Nutrient ;
    sh:name "栄養素" ;
    sh:description "人体の代謝・食欲・脳機能・腸内環境を左右する成分。" ;
    sh:property [
        sh:path ex:recommendedAmount ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:healthEffect ;
