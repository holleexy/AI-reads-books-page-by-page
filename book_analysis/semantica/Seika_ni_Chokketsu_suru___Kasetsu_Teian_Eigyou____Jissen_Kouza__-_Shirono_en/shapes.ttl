    ] .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/ClosingTechniqueShape>
    a sh:NodeShape ;
    sh:targetClass ex:ClosingTechnique ;
    sh:name "クロージング手法" ;
    sh:description "松竹梅の選択肢クロージングなど、即決を迫らず次回アクションへ誘導する技法。" .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/OnlineMeetingTechniqueShape>
    a sh:NodeShape ;
    sh:targetClass ex:OnlineMeetingTechnique ;
    sh:name "オンライン商談テクニック" ;
    sh:description "視覚・聴覚・言語の三つのVを工夫し、警戒心の高いオンライン環境で関係を深める技法。" ;
    sh:property [
        sh:path ex:description ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/PartnerSalesShape>
    a sh:NodeShape ;
    sh:targetClass ex:PartnerSales ;
    sh:name "パートナーセールス" ;
    sh:description "SIerや代理店を通じた間接販売。分析、協業提案、交渉、案件創出、継続受注の五ステップで進める。" ;
    sh:property [
        sh:path ex:sellsThroughPartner ;
        sh:class ex:BusinessPartner ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:describedInBook ;
        sh:class ex:Book ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:goal ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:addressesChallenge ;
        sh:class ex:SalesChallenge ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:appliesPrinciple ;
        sh:class ex:PsychologicalPrinciple ;
        sh:severity sh:Violation
    ] .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/PsychologicalPrincipleShape>
    a sh:NodeShape ;
    sh:targetClass ex:PsychologicalPrinciple ;
    sh:name "心理原則" ;
    sh:description "返報性・一貫性・社会的証明・権威・好意・希少性など、顧客の心を動かすチャルディーニの原則。" ;
    sh:property [
        sh:path ex:describedInBook ;
        sh:class ex:Book ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:description ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/SalespersonShape>
    a sh:NodeShape ;
    sh:targetClass ex:Salesperson ;
    sh:name "営業パーソン" ;
    sh:description "企業ブランドや製品スペックではなく仮説提案によって個人として選ばれることを目指す営業担当者。" ;
    sh:property [
        sh:path ex:formulatesHypothesis ;
        sh:class ex:Hypothesis ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:preparesMaterial ;
        sh:class ex:ProposalMaterial ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:practicesApproach ;
        sh:class ex:SalesApproach ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:appliesPrinciple ;
        sh:class ex:PsychologicalPrinciple ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:collaboratesWith ;
        sh:class ex:BusinessPartner ;
        sh:severity sh:Violation
    ] .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/CustomerShape>
    a sh:NodeShape ;
    sh:targetClass ex:Customer ;
    sh:name "顧客" ;
    sh:description "仮説の対象となる企業。ニーズが未明確でも課題仮説によって商談を前進させる相手。" .

<https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/BusinessPartnerShape>
    a sh:NodeShape ;
    sh:targetClass ex:BusinessPartner ;
    sh:name "販売パートナー" ;
    sh:description "メーカー製品を顧客へ販売するSIerや代理店。Win-Win-Winの協業とイノベーター理論による展開対象。" .
