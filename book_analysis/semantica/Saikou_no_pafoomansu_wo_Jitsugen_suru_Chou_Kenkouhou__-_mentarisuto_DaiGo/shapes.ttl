        sh:severity sh:Violation
    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/BrainShape>
    a sh:NodeShape ;
    sh:targetClass ex:Brain ;
    sh:name "脳" ;
    sh:description "青魚・クルミ・大豆などで最適化できる。オメガ3は海馬を大きくし認知機能を高める。" .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/GutMicrobiomeShape>
    a sh:NodeShape ;
    sh:targetClass ex:GutMicrobiome ;
    sh:name "腸内環境" ;
    sh:description "第2の脳。免疫とホルモンを支配し、食物繊維（MAC）不足や人工甘味料で乱れる。" ;
    sh:property [
        sh:path ex:regulates ;
        sh:class ex:Hormone ;
        sh:severity sh:Violation
    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/HormoneShape>
    a sh:NodeShape ;
    sh:targetClass ex:Hormone ;
    sh:name "ホルモン" ;
    sh:description "レプチン、オレキシン、コルチゾール、アドレナリン、ドーパミン、HSLなど生理調節物質。" ;
    sh:property [
        sh:path ex:regulates ;
        sh:class ex:Hormone ;
        sh:severity sh:Violation
    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/MetabolicFlexibilityShape>
    a sh:NodeShape ;
    sh:targetClass ex:MetabolicFlexibility ;
    sh:name "代謝柔軟性" ;
    sh:description "糖質と脂質を切り替えてエネルギーにする能力。極端な糖質制限で壊れ太りやすい体質になる。" .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/DietMethodShape>
    a sh:NodeShape ;
    sh:targetClass ex:DietMethod ;
    sh:name "ダイエット手法" ;
    sh:description "総カロリーが同じなら糖質制限もバランス食も減量効果は同等。カロリーの質とタイミングが重要。" ;
