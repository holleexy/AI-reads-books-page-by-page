  <owl:Class rdf:about="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/FiveCs">
    <rdfs:label xml:lang="ja">五つのシー</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客、顧客の顧客、競合、自社、顧客の競合から刺さる情報を分析する枠。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Muhai_Eigyou____3_tsuno_Shitsumon____to___4_tsuno_Chikara_____-_Takahashi_Kouich/AnalysisFramework"/>
