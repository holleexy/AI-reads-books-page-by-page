<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/ExerciseShape>
    a sh:NodeShape ;
    sh:targetClass ex:Exercise ;
    sh:name "運動" ;
    sh:description "下半身の大きな筋肉を鍛えるのが効率的。45分超の有酸素はコルチゾールで筋肉分解と食欲増進を招く。" ;
    sh:property [
