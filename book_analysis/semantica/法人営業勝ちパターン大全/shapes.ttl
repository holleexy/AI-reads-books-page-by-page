    ] .

<https://books.local/法人営業勝ちパターン大全/KeyPersonShape>
    a sh:NodeShape ;
    sh:targetClass ex:KeyPerson ;
    sh:name "キーパーソン" ;
    sh:description "正式な決裁者とは限らずステージで移る重要人物。数珠つなぎで接近し、目の前の人を決して飛ばさない。" ;
    sh:property [
        sh:path ex:influences ;
        sh:class ex:Deal ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:belongsToCustomer ;
        sh:class ex:Customer ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasBuyerType ;
        sh:class ex:BuyerType ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasLeadPersonPhase ;
        sh:class ex:LeadPersonPhase ;
        sh:severity sh:Violation
    ] .

<https://books.local/法人営業勝ちパターン大全/MazeShape>
    a sh:NodeShape ;
    sh:targetClass ex:Maze ;
    sh:name "迷路" ;
    sh:description "誰がいて内部がどうなっているか見えず時間が過ぎる状態。4つの迷路に分類し落とし穴を診断して脱出する。" ;
    sh:property [
        sh:path ex:hasPitfall ;
        sh:class ex:Pitfall ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:usesTactic ;
        sh:class ex:Tactic ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:description ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

