  <owl:ObjectProperty rdf:about="https://books.local/勝てるプロダクト開発の教科書/answersWhyNow">
    <rdfs:label xml:lang="ja">なぜ今かを答える</rdfs:label>
    <rdfs:comment xml:lang="ja">技術・社会・競争環境の変化がタイミングの必然を与える。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/勝てるプロダクト開発の教科書/Vision"/>
    <rdfs:range rdf:resource="https://books.local/勝てるプロダクト開発の教科書/WhyNow"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/勝てるプロダクト開発の教科書/groundedIn">
    <rdfs:label xml:lang="ja">原体験に根ざす</rdfs:label>
    <rdfs:comment xml:lang="ja">自分がやる必然の物語は過去の原体験から始まる。</rdfs:comment>
