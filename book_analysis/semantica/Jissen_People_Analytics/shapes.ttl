    sh:targetClass ex:EthicalPrinciple ;
    sh:name "倫理原則" ;
    sh:description "権力性への自覚や現場への寄り添いを含め、分析結果で従業員を過度にコントロールしないための倫理的指針。" ;
    sh:property [
        sh:path ex:hasDescription ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Jissen_People_Analytics/HRDataUtilizationPrincipleShape>
    a sh:NodeShape ;
    sh:targetClass ex:HRDataUtilizationPrinciple ;
    sh:name "人事データ利活用原則" ;
    sh:description "効用最大化、目的明確化、利用制限、適正取得、正確性・最新性・公平性、セキュリティ確保、アカウンタビリティ、責任所在明確化、人間関与の九原則。" ;
    sh:property [
        sh:path ex:hasDescription ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Jissen_People_Analytics/RequirementSpecificationShape>
    a sh:NodeShape ;
    sh:targetClass ex:RequirementSpecification ;
    sh:name "要件定義書" ;
