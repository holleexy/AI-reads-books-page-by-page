  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/illustratedBy">
    <rdfs:label xml:lang="ja">例示される</rdfs:label>
    <rdfs:comment xml:lang="ja">本手法の有効性がケーススタディによって示される関係。</rdfs:comment>
