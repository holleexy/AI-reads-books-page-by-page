@prefix ex: <https://books.local/バックオフィス業務のすべてがわかる本.ocr/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/shapes> a owl:Ontology .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/BackOfficeShape>
    a sh:NodeShape ;
    sh:targetClass ex:BackOffice ;
    sh:name "バックオフィス" ;
    sh:description "経理、人事、法務、総務を総称する管理部門・間接部門・コーポレート部門。一つの機能として捉え、経営者の会社経営コントロールの一部を引き受ける。" ;
    sh:property [
        sh:path ex:hasFunction ;
        sh:class ex:BackOfficeFunction ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:contrastedWith ;
        sh:class ex:FrontOffice ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:belongsToCompany ;
        sh:class ex:Company ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:ledBy ;
        sh:class ex:ExecutiveRole ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasPolicy ;
        sh:class ex:BackOfficePolicy ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasOrganizationDesign ;
        sh:class ex:OrganizationDesign ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasWorkType ;
        sh:class ex:WorkType ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:consultsSpecialist ;
        sh:class ex:LicensedSpecialist ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:outsourcesTo ;
        sh:class ex:BusinessProcessOutsourcing ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:usesDigitalTransformation ;
        sh:class ex:DigitalTransformation ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:mission ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:characteristic ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/FrontOfficeShape>
    a sh:NodeShape ;
    sh:targetClass ex:FrontOffice ;
    sh:name "フロントオフィス" ;
    sh:description "販売、アフターサービス、企画・開発、製造、物流、マーケティング、サービスなど直接的な事業活動を担う部門。" .

<https://books.local/バックオフィス業務のすべてがわかる本.ocr/CompanyShape>
    a sh:NodeShape ;
    sh:targetClass ex:Company ;
    sh:name "企業" ;
    sh:description "バックオフィスを持つ組織。大企業、中小企業、スタートアップなど類型や成長段階により組織設計が異なる。" ;
    sh:property [
        sh:path ex:hasOrganizationDesign ;
        sh:class ex:OrganizationDesign ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:outsourcesTo ;
        sh:class ex:BusinessProcessOutsourcing ;
        sh:severity sh:Violation
    ] .

