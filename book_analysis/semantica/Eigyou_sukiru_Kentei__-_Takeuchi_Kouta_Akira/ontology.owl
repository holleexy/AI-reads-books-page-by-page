<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/">
    <rdfs:label>Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_AkiraOntology</rdfs:label>
    <owl:versionInfo>1.0</owl:versionInfo>
  </owl:Ontology>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Book">
    <rdfs:label xml:lang="ja">書籍</rdfs:label>
    <rdfs:comment xml:lang="ja">本書『営業スキル検定』。いい営業像の提示と、営業の学術的・体系的整理を目的とする。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Author">
    <rdfs:label xml:lang="ja">著者</rdfs:label>
    <rdfs:comment xml:lang="ja">リクルートで営業を始め、モノグサ株式会社を起業した人物。営業の価値を事業開発という長期的視点で捉え直した。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/EmpathyAcquisition">
    <rdfs:label xml:lang="ja">共感獲得</rdfs:label>
    <rdfs:comment xml:lang="ja">営業の本質。絶対的根拠がない中でリスクを伴う意思決定を相手にしてもらうこと。資金調達・採用・ミッション伝達なども含まれる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesStyle">
    <rdfs:label xml:lang="ja">営業スタイル</rdfs:label>
    <rdfs:comment xml:lang="ja">担当見込み顧客数と商品の弾力性の二つの変数によって決まる営業の分類。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Marketing">
    <rdfs:label xml:lang="ja">マーケティング</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客数が膨大で、効率的に見込み客を絞り込む領域の営業スタイル。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesStyle"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/CustomOrderSales">
    <rdfs:label xml:lang="ja">御用聞き営業</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客数は少ないが高単価。強固な信頼関係を基にした深い伴走を行うスタイル。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesStyle"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/ConsultingSales">
    <rdfs:label xml:lang="ja">コンサルティング営業</rdfs:label>
    <rdfs:comment xml:lang="ja">弾力性が小さい商品を、営業自身の問題解決能力を付加価値として売るスタイル。短期売上にはなるが商品改善には繋がりにくい。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesStyle"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/BusinessDevelopmentSales">
    <rdfs:label xml:lang="ja">事業開発営業</rdfs:label>
    <rdfs:comment xml:lang="ja">弾力性が大きい商品を扱い、現場の一次情報を開発へフィードバックして商品価値を高める。本書が最も推奨するスタイル。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesStyle"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesFoundation">
    <rdfs:label xml:lang="ja">営業基盤</rdfs:label>
    <rdfs:comment xml:lang="ja">営業を体系化するために分離して定義すべき知識・KPI・スキルの総称。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Knowledge">
    <rdfs:label xml:lang="ja">知識</rdfs:label>
    <rdfs:comment xml:lang="ja">記憶していればそのまま使える情報。業界知識、商品知識、決裁者情報など。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesFoundation"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/KPI">
    <rdfs:label>KPI</rdfs:label>
    <rdfs:comment xml:lang="ja">営業目標と相関する行動指標。アポ数や商談回数など。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesFoundation"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Skill">
    <rdfs:label xml:lang="ja">スキル</rdfs:label>
    <rdfs:comment xml:lang="ja">記憶だけでは体現できず、実践と反復が必要な技術。言語化できなければ育成もスランプ脱出もできない。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesFoundation"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesLevel">
    <rdfs:label xml:lang="ja">営業レベル</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客ニーズの顕在化度合い（自覚の有無）によって0から3に分類される営業スキルの水準。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesLevel0">
    <rdfs:label xml:lang="ja">営業レベル0</rdfs:label>
    <rdfs:comment xml:lang="ja">ニーズが顕在化し購買行動を開始している顧客への対応。店頭接客や問い合わせ対応。基本的ビジネスマナーが中心。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesLevel"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesLevel1">
    <rdfs:label xml:lang="ja">営業レベル1</rdfs:label>
    <rdfs:comment xml:lang="ja">ニーズは自覚しているが購買を始めていない顧客。情報の非対称性を埋めて売る。トークスクリプトや想定Q&amp;Aが中心。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesLevel"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesLevel2">
    <rdfs:label xml:lang="ja">営業レベル2</rdfs:label>
    <rdfs:comment xml:lang="ja">潜在ニーズはあるが自覚していない顧客。ヒアリング・ギャップ特定・真因合意・導入障害解消が中心。事業開発営業のコア。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesLevel"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesLevel3">
    <rdfs:label xml:lang="ja">営業レベル3</rdfs:label>
    <rdfs:comment xml:lang="ja">潜在ニーズすら無い顧客への合法的な課題創造。目標を引き上げ新たなギャップを作る。商品が市場適合するまでの時間稼ぎの禁じ手。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesLevel"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Customer">
    <rdfs:label xml:lang="ja">顧客</rdfs:label>
    <rdfs:comment xml:lang="ja">営業の対象となる見込み客または既存顧客。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Need">
    <rdfs:label xml:lang="ja">ニーズ</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客の課題や欲求。顕在化の度合いによって対応すべき営業レベルが決まる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Gap">
    <rdfs:label xml:lang="ja">ギャップ</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客の目標（ありたい姿）と現状との差。レベル2で認識させる対象。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/RootCause">
    <rdfs:label xml:lang="ja">真因</rdfs:label>
    <rdfs:comment xml:lang="ja">ギャップの、顧客自身も気づいていない根本原因。仮説で提示し顧客の口で言わせる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Product">
    <rdfs:label xml:lang="ja">商品</rdfs:label>
    <rdfs:comment xml:lang="ja">販売対象。弾力性の大小で価値変化の速さが異なる。究極目標は営業がいなくても売れる状態を作ること。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Meeting">
    <rdfs:label xml:lang="ja">商談</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客との営業対話。三回商談フレームワークの構成単位。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/ThreeMeetingFramework">
    <rdfs:label xml:lang="ja">三回商談フレームワーク</rdfs:label>
    <rdfs:comment xml:lang="ja">レベル2〜3向けの商談設計。1回目は価値伝達とヒアリング、2回目は期待を超える提案と障害解消、3回目は決裁者へのクロージング。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/DecisionMaker">
    <rdfs:label xml:lang="ja">決裁者</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客組織の購買意思決定者。レベル3では経営課題について語り、3回目商談でプレゼン対象となる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesSkillCertification">
    <rdfs:label xml:lang="ja">営業スキル検定</rdfs:label>
    <rdfs:comment xml:lang="ja">スキルを言語化し習得可能にし、評価とフィードバックを行う仕組み。組織のいい営業像と改善基準を提供する。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/RolePlay">
    <rdfs:label xml:lang="ja">ロールプレイング</rdfs:label>
    <rdfs:comment xml:lang="ja">レベル別に設計する実践評価。くじ引きで顧客属性や真因パターンを変え、対応力を測る。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Organization">
    <rdfs:label xml:lang="ja">組織</rdfs:label>
    <rdfs:comment xml:lang="ja">検定を運用し営業像を定着させる企業やチーム。録音公開、評価者育成、開発連携が求められる。</rdfs:comment>
  </owl:Class>

  <owl:ObjectProperty rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/hasAuthor">
    <rdfs:label xml:lang="ja">著者を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">書籍とその著者の関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Book"/>
    <rdfs:range rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Author"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/hasEssence">
    <rdfs:label xml:lang="ja">本質を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">本書が営業の本質として定義する共感獲得。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Book"/>
    <rdfs:range rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/EmpathyAcquisition"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/recommends">
    <rdfs:label xml:lang="ja">推奨する</rdfs:label>
    <rdfs:comment xml:lang="ja">本書が最も推奨する事業開発営業。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Book"/>
    <rdfs:range rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/BusinessDevelopmentSales"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/sells">
    <rdfs:label xml:lang="ja">販売する</rdfs:label>
    <rdfs:comment xml:lang="ja">その営業スタイルが扱う商品。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesStyle"/>
    <rdfs:range rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Product"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/improves">
    <rdfs:label xml:lang="ja">改善する</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客の温度感という一次情報を開発へ返し、プロダクト価値やCVRを高める。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/BusinessDevelopmentSales"/>
    <rdfs:range rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Product"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/requiresSkill">
    <rdfs:label xml:lang="ja">スキルを要する</rdfs:label>
    <rdfs:comment xml:lang="ja">各営業レベルで求められる主要スキル。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesLevel"/>
    <rdfs:range rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Skill"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/targetsNeed">
    <rdfs:label xml:lang="ja">ニーズを対象とする</rdfs:label>
    <rdfs:comment xml:lang="ja">営業レベルはニーズの顕在化度合いで分類される。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesLevel"/>
    <rdfs:range rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Need"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/hasNeed">
    <rdfs:label xml:lang="ja">ニーズを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客が持つ顕在的または潜在的ニーズ。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Customer"/>
    <rdfs:range rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Need"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/hasGap">
    <rdfs:label xml:lang="ja">ギャップを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客の目標と現状の差。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Customer"/>
    <rdfs:range rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Gap"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/hasRootCause">
    <rdfs:label xml:lang="ja">真因を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">ギャップを生んでいる根本原因。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Gap"/>
    <rdfs:range rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/RootCause"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/identifies">
    <rdfs:label xml:lang="ja">特定する</rdfs:label>
    <rdfs:comment xml:lang="ja">ヒアリングを通じギャップや真因を特定する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Skill"/>
    <rdfs:range rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Gap"/>
    <rdfs:range rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/RootCause"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/consistsOf">
    <rdfs:label xml:lang="ja">構成要素とする</rdfs:label>
    <rdfs:comment xml:lang="ja">三回商談フレームワークを構成する各商談。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/ThreeMeetingFramework"/>
    <rdfs:range rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Meeting"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/involves">
    <rdfs:label xml:lang="ja">関与させる</rdfs:label>
    <rdfs:comment xml:lang="ja">商談に顧客や決裁者を関与させる。特に3回目で決裁者へクロージングする。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Meeting"/>
    <rdfs:range rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/DecisionMaker"/>
    <rdfs:range rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/Customer"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/evaluates">
    <rdfs:label xml:lang="ja">評価する</rdfs:label>
    <rdfs:comment xml:lang="ja">検定が評価する営業スキル。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Eigyou_sukiru_Kentei__-_Takeuchi_Kouta_Akira/SalesSkillCertification"/>
