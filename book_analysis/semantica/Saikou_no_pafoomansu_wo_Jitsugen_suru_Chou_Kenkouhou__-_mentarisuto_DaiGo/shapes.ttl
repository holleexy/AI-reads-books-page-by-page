    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/CarbohydrateShape>
    a sh:NodeShape ;
    sh:targetClass ex:Carbohydrate ;
    sh:name "炭水化物" ;
    sh:description "摂取割合約50%が最も寿命が長い。極端な制限は寿命短縮と代謝柔軟性の破壊につながる。" ;
    sh:property [
        sh:path ex:impairs ;
        sh:class ex:GutMicrobiome ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:recommendedAmount ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:healthEffect ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/ProteinShape>
    a sh:NodeShape ;
    sh:targetClass ex:Protein ;
    sh:name "タンパク質" ;
    sh:description "総カロリーの15%以上で食欲が自然に抑制される。ホエイは大豆より体脂肪減少効果が高い。" ;
    sh:property [
        sh:path ex:suppresses ;
        sh:class ex:Appetite ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:recommendedAmount ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:healthEffect ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/FatShape>
    a sh:NodeShape ;
    sh:targetClass ex:Fat ;
    sh:name "脂質" ;
    sh:description "炭水化物より食欲を刺激する。高脂肪食は日中の眠気を78%高め、レプチンとオレキシンに悪影響を与える。" ;
    sh:property [
        sh:path ex:affects ;
        sh:class ex:Sleep ;
        sh:severity sh:Violation
    ] ;
    sh:property [
