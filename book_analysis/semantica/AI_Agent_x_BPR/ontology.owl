<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="https://books.local/AI_Agent_x_BPR/">
    <rdfs:label>AI_Agent_x_BPROntology</rdfs:label>
    <owl:versionInfo>1.0</owl:versionInfo>
  </owl:Ontology>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/AIAgent">
    <rdfs:label xml:lang="ja">AIエージェント</rdfs:label>
    <rdfs:comment xml:lang="ja">目的・理解・行動・学習の四要素を満たし、自律的に業務を代行するシステム。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/Copilot">
    <rdfs:label xml:lang="ja">コパイロット</rdfs:label>
    <rdfs:comment xml:lang="ja">人間を支援する生成AIの活用形態であり、エージェント化の前段階。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/DigitalWorker">
    <rdfs:label xml:lang="ja">デジタルワーカー</rdfs:label>
    <rdfs:comment xml:lang="ja">人間の指示を待たず24時間365日稼働するAIエージェント。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/AI_Agent_x_BPR/AIAgent"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/AgentCapability">
    <rdfs:label xml:lang="ja">エージェント能力</rdfs:label>
    <rdfs:comment xml:lang="ja">目的設定、ギャップ理解、タスク実行、結果からの学習のいずれか。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/BusinessReform">
    <rdfs:label xml:lang="ja">業務改革</rdfs:label>
    <rdfs:comment xml:lang="ja">AIエージェントにより仕事の定義自体を変える経営の意思決定。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/BusinessProcess">
    <rdfs:label xml:lang="ja">業務プロセス</rdfs:label>
    <rdfs:comment xml:lang="ja">企業における一連の業務活動。縦割りではなく作業構造でも整理する。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/BackOfficeWork">
    <rdfs:label xml:lang="ja">バックオフィス業務</rdfs:label>
    <rdfs:comment xml:lang="ja">間接業務。横串整理により共通エージェントの再利用がしやすい。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/AI_Agent_x_BPR/BusinessProcess"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/FrontOfficeWork">
    <rdfs:label xml:lang="ja">フロントオフィス業務</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客対応・営業・マーケティング等。判断重要性と手順明確さで分類する。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/AI_Agent_x_BPR/BusinessProcess"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/RPA">
    <rdfs:label>RPA</rdfs:label>
    <rdfs:comment xml:lang="ja">ロボティック・プロセス・オートメーション。従来の間接業務効率化技術。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/ERP">
    <rdfs:label>ERP</rdfs:label>
    <rdfs:comment xml:lang="ja">統合基幹業務システム。デジタル化の基盤として導入されてきた。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/AIAMMethod">
    <rdfs:label xml:lang="ja">AIAM法</rdfs:label>
    <rdfs:comment xml:lang="ja">目的と成果から逆算してAIエージェント業務改革を進める五フェーズ手法。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/AIAMPhase">
    <rdfs:label xml:lang="ja">AIAMフェーズ</rdfs:label>
    <rdfs:comment xml:lang="ja">基本計画立案、業務設計、検証計画策定、構築・検証、システム開発のいずれか。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/DesignPrinciple">
    <rdfs:label xml:lang="ja">設計原則</rdfs:label>
    <rdfs:comment xml:lang="ja">トップダウンとボトムアップ、変革リーダー、クイックウィン、人間最終判断など。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/TechnicalLayer">
    <rdfs:label xml:lang="ja">技術層</rdfs:label>
    <rdfs:comment xml:lang="ja">AIエージェント五層アーキテクチャを構成する層。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/IntelligenceLayer">
    <rdfs:label xml:lang="ja">知能層</rdfs:label>
    <rdfs:comment xml:lang="ja">思考と理解を担う層。ChatGPT、Claude、Gemini、Llamaなど。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/AI_Agent_x_BPR/TechnicalLayer"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/MemoryKnowledgeLayer">
    <rdfs:label xml:lang="ja">記憶・知識層</rdfs:label>
    <rdfs:comment xml:lang="ja">文脈維持と知識保持を担う層。短期・長期メモリ、RAGなど。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/AI_Agent_x_BPR/TechnicalLayer"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/ActionLayer">
    <rdfs:label xml:lang="ja">行動層</rdfs:label>
    <rdfs:comment xml:lang="ja">タスク実行を担う層。API連携やツール利用など。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/AI_Agent_x_BPR/TechnicalLayer"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/ControlCoordinationLayer">
    <rdfs:label xml:lang="ja">制御・調整層</rdfs:label>
    <rdfs:comment xml:lang="ja">統括と安全確保を担う層。オーケストレーション、ガードレールなど。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/AI_Agent_x_BPR/TechnicalLayer"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/LearningOptimizationLayer">
    <rdfs:label xml:lang="ja">学習・最適化層</rdfs:label>
    <rdfs:comment xml:lang="ja">継続的改善を担う層。フィードバックやログ分析など。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/AI_Agent_x_BPR/TechnicalLayer"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/ProvisionForm">
    <rdfs:label xml:lang="ja">提供形態</rdfs:label>
    <rdfs:comment xml:lang="ja">SaaS型、API連携型、ローカルLLM型のいずれか。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/WorkPattern">
    <rdfs:label xml:lang="ja">業務型</rdfs:label>
    <rdfs:comment xml:lang="ja">作業構造単位の業務分類。部門横断の横串整理の基礎。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/SummaryTranscriptionPattern">
    <rdfs:label xml:lang="ja">要約・転記型</rdfs:label>
    <rdfs:comment xml:lang="ja">議事録作成や申請入力など定型性が高く削減効果が大きい型。目安削減率80%。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/AI_Agent_x_BPR/WorkPattern"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/CheckReviewPattern">
    <rdfs:label xml:lang="ja">チェック・校閲型</rdfs:label>
    <rdfs:comment xml:lang="ja">経費審査や請求確認などヒューマンエラー防止効果が大きい型。目安削減率60%。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/AI_Agent_x_BPR/WorkPattern"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/InquiryResponsePattern">
    <rdfs:label xml:lang="ja">問い合わせ対応型</rdfs:label>
    <rdfs:comment xml:lang="ja">社内FAQや人事問合せなど24時間対応が可能な型。目安削減率50%。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/AI_Agent_x_BPR/WorkPattern"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/AssessmentProcess">
    <rdfs:label xml:lang="ja">業務選定アセスメント</rdfs:label>
    <rdfs:comment xml:lang="ja">工数整理、適性評価、前提確認、削減率算定、取組選定の五ステップ。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/PriorityCategory">
    <rdfs:label xml:lang="ja">取組優先区分</rdfs:label>
    <rdfs:comment xml:lang="ja">すぐ着手、中期仕込み、他施策対応の三領域。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/Barrier">
    <rdfs:label xml:lang="ja">導入の壁</rdfs:label>
    <rdfs:comment xml:lang="ja">情報管理、要件ずれ、検証地獄、精度、ガバナンス、効果可視化、人の壁のいずれか。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/LLMCharacteristic">
    <rdfs:label xml:lang="ja">LLM特性</rdfs:label>
    <rdfs:comment xml:lang="ja">確率的出力、ハルシネーション、コンテキスト依存、表データ不得手、ポチョムキン理解など。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/ROI">
    <rdfs:label xml:lang="ja">投資対効果</rdfs:label>
    <rdfs:comment xml:lang="ja">工数削減費を導入コストで割った指標。横展開を含む包括評価が重要。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/KPI">
    <rdfs:label>KPI</rdfs:label>
    <rdfs:comment xml:lang="ja">目標合意、検証ゴール、撤退基準、効果可視化に用いる重要業績評価指標。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/SuccessPrinciple">
    <rdfs:label xml:lang="ja">成功の要諦</rdfs:label>
    <rdfs:comment xml:lang="ja">トップダウン開始、推進機能、科学的業務選定など成功のための十原則。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/CaseStudy">
    <rdfs:label xml:lang="ja">事例</rdfs:label>
    <rdfs:comment xml:lang="ja">明治安田生命、富士通、Walmart、Klaviyo等のAI活用実例。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/Organization">
    <rdfs:label xml:lang="ja">組織</rdfs:label>
    <rdfs:comment xml:lang="ja">業務改革や事例の主体となる企業・団体。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/AI_Agent_x_BPR/FutureScenario">
    <rdfs:label xml:lang="ja">未来シナリオ</rdfs:label>
    <rdfs:comment xml:lang="ja">汎用型・特化型エージェントの進化とAI 2027における知能爆発の想定。</rdfs:comment>
  </owl:Class>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/hasCapability">
    <rdfs:label xml:lang="ja">能力を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">エージェントが目的・理解・行動・学習のいずれかを備えることを表す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/AIAgent"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/AgentCapability"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/hasLayer">
    <rdfs:label xml:lang="ja">層を構成する</rdfs:label>
    <rdfs:comment xml:lang="ja">エージェントが五層アーキテクチャのいずれかの層を持つことを表す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/AIAgent"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/TechnicalLayer"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/hasProvisionForm">
    <rdfs:label xml:lang="ja">提供形態を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">SaaS型、API連携型、ローカルLLM型としての提供を表す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/AIAgent"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/ProvisionForm"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/evolvedFrom">
    <rdfs:label xml:lang="ja">から進化した</rdfs:label>
    <rdfs:comment xml:lang="ja">コパイロット支援から自律エージェントへの進化関係。</rdfs:comment>
