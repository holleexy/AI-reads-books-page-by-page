    ] .

<https://books.local/法人営業勝ちパターン大全/OrderDecisionShape>
    a sh:NodeShape ;
    sh:targetClass ex:OrderDecision ;
    sh:name "発注決定" ;
    sh:description "選定と契約の段階で、しばしば儀式的。特別感を生むカスタマイズ戦略の適用対象。" ;
