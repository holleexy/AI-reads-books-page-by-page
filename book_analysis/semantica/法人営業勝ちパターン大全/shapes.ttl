<https://books.local/法人営業勝ちパターン大全/DefensiveStrategyShape>
    a sh:NodeShape ;
    sh:targetClass ex:DefensiveStrategy ;
    sh:name "守りの戦略" ;
    sh:description "同じ電話やフォローを繰り返さず、どの迷路のどの落とし穴かを正しく診断して脱出する戦略。" ;
