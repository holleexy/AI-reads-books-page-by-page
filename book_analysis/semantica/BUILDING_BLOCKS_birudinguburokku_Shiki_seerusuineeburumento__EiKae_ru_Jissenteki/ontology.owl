  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/hasSystem">
    <rdfs:label xml:lang="ja">システムを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">セールスイネーブルメントが相互依存する四つの基盤システムを持つ関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/SalesEnablement"/>
    <rdfs:range rdf:resource="https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/EnablementSystem"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/targetsOrganization">
    <rdfs:label xml:lang="ja">対象組織</rdfs:label>
    <rdfs:comment xml:lang="ja">セールスイネーブルメントが生産性を最大化しようとする営業組織。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/SalesEnablement"/>
    <rdfs:range rdf:resource="https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/SalesOrganization"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/enablesRepresentative">
    <rdfs:label xml:lang="ja">営業担当者をイネーブルする</rdfs:label>
    <rdfs:comment xml:lang="ja">適切なリソースを適切なタイミングで活用できるよう営業担当者を支援する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/SalesEnablement"/>
