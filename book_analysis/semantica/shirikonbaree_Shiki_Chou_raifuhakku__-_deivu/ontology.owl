  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/shirikonbaree_Shiki_Chou_raifuhakku__-_deivu/hasCompass">
    <rdfs:label xml:lang="ja">羅針盤を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">書籍が提示する真の成功の原則を示す</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/shirikonbaree_Shiki_Chou_raifuhakku__-_deivu/Book"/>
