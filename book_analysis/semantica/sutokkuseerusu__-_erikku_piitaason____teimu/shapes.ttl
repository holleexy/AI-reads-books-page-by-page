@prefix ex: <https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/shapes> a owl:Ontology .

<https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/BookShape>
    a sh:NodeShape ;
    sh:targetClass ex:Book ;
    sh:name "書籍" ;
    sh:description "既存顧客向け四つのメッセージモデルを行動経済学と心理学で解説したビジネス書。" .

<https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageModelShape>
    a sh:NodeShape ;
    sh:targetClass ex:MessageModel ;
    sh:name "メッセージモデル" ;
    sh:description "既存顧客との関係を強化し収益を最大化するための科学的な伝達枠組み。" ;
    sh:property [
        sh:path ex:appliesToCustomer ;
        sh:class ex:Customer ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:basedOnBias ;
        sh:class ex:CognitiveBias ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:basedOnTheory ;
        sh:class ex:ProspectTheory ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasStep ;
        sh:class ex:MessageStep ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:usedAtMoment ;
        sh:class ex:CriticalMoment ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:assignedToZone ;
        sh:class ex:CustomerZone ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:usesSkill ;
        sh:class ex:CommunicationSkill ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:describedIn ;
        sh:class ex:Book ;
        sh:severity sh:Violation
    ] .

<https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/RetentionMessageModelShape>
    a sh:NodeShape ;
    sh:targetClass ex:RetentionMessageModel ;
    sh:name "現状維持メッセージモデル" ;
    sh:description "契約更新時に革新性より安心感を与え継続を促す五段階のリテンション手法。" ;
    sh:property [
        sh:path ex:appliesToCustomer ;
        sh:class ex:Customer ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:basedOnBias ;
        sh:class ex:CognitiveBias ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:basedOnTheory ;
        sh:class ex:ProspectTheory ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:hasStep ;
        sh:class ex:MessageStep ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:usedAtMoment ;
        sh:class ex:CriticalMoment ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:assignedToZone ;
        sh:class ex:CustomerZone ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:usesSkill ;
        sh:class ex:CommunicationSkill ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:describedIn ;
        sh:class ex:Book ;
        sh:severity sh:Violation
    ] .

