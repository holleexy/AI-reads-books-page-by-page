    a sh:NodeShape ;
    sh:targetClass ex:DietaryFiber ;
    sh:name "食物繊維" ;
    sh:description "腸内で酢酸などの短鎖脂肪酸に変わり食欲を抑える。不足すると腸内細菌が腸壁を食べ始める。" ;
    sh:property [
        sh:path ex:improves ;
