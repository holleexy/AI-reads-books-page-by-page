<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="https://books.local/Research_Driven_Innovation/">
    <rdfs:label>Research_Driven_InnovationOntology</rdfs:label>
    <owl:versionInfo>1.0</owl:versionInfo>
  </owl:Ontology>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/ResearchDrivenInnovation">
    <rdfs:label xml:lang="ja">リサーチ・ドリブン・イノベーション</rdfs:label>
    <rdfs:comment xml:lang="ja">リサーチという反復的な探索活動を中核に据え、内と外の絶えざる往復による探究を本質とするイノベーションの実践手法。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/Innovation">
    <rdfs:label xml:lang="ja">イノベーション</rdfs:label>
    <rdfs:comment xml:lang="ja">シュンペーターの新結合に基づき、一見関係のない既存の知識同士を結びつけ新たな価値を生み出すこと。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/Organization">
    <rdfs:label xml:lang="ja">組織</rdfs:label>
    <rdfs:comment xml:lang="ja">イノベーションを実施する集団。探究的衝動の抑圧、創造的自信の喪失、成功の罠が生じうる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/Individual">
    <rdfs:label xml:lang="ja">個人</rdfs:label>
    <rdfs:comment xml:lang="ja">探究的衝動と創造的自信を持つ主体。文脈的アプローチでは日常業務内で知の深化と探索のバランスを取る。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/Team">
    <rdfs:label xml:lang="ja">チーム</rdfs:label>
    <rdfs:comment xml:lang="ja">問いとデータを足場に創造的対話を行い、前提の合意形成まで進める実践単位。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/ExploratoryImpulse">
    <rdfs:label xml:lang="ja">探究的衝動</rdfs:label>
    <rdfs:comment xml:lang="ja">デューイの経験学習における内なる衝動。イノベーションの起点となり、問いによって刺激される。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/CreativeConfidence">
    <rdfs:label xml:lang="ja">創造的自信</rdfs:label>
    <rdfs:comment xml:lang="ja">個人が創造的に思考し行為できるという自信。組織内で抑圧され喪失されうる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/SuccessTrap">
    <rdfs:label xml:lang="ja">成功の罠</rdfs:label>
    <rdfs:comment xml:lang="ja">一度成功した手法に固執し、中長期的な知の探索を怠ってしまう現象。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/ChangeRigidity">
    <rdfs:label xml:lang="ja">変化の硬直化</rdfs:label>
    <rdfs:comment xml:lang="ja">個人・チーム・組織の各レイヤーでイノベーションを阻害する変化への抵抗。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/KnowledgeDeepening">
    <rdfs:label xml:lang="ja">知の深化</rdfs:label>
    <rdfs:comment xml:lang="ja">既存事業を改善する活動。両利きの経営の一方の極。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/KnowledgeExploration">
    <rdfs:label xml:lang="ja">知の探索</rdfs:label>
    <rdfs:comment xml:lang="ja">新たな可能性を探る活動。両利きの経営の他方の極。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/AmbidextrousManagement">
    <rdfs:label xml:lang="ja">両利きの経営</rdfs:label>
    <rdfs:comment xml:lang="ja">知の深化と知の探索を両立させイノベーションを持続させる経営。連続的・構造的・文脈的アプローチがある。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/ContextualApproach">
    <rdfs:label xml:lang="ja">文脈的アプローチ</rdfs:label>
    <rdfs:comment xml:lang="ja">各個人が日常業務内で深化と探索のバランスを取る両利きの方法。最も重要視される。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Research_Driven_Innovation/AmbidextrousManagement"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/OrganizationalLearning">
    <rdfs:label xml:lang="ja">組織学習</rdfs:label>
    <rdfs:comment xml:lang="ja">イノベーションの延長線上にある学習。衝動から観察・結合・判断を経て目的へ昇華する。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/CreativeSoil">
    <rdfs:label xml:lang="ja">創造の土壌</rdfs:label>
    <rdfs:comment xml:lang="ja">氷山モデルにおけるプロセス層。個人の衝動や関係性の質を耕すことで創造性が育まれる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/InnovationApproach">
    <rdfs:label xml:lang="ja">イノベーション・アプローチ</rdfs:label>
    <rdfs:comment xml:lang="ja">イノベーションの方向性を見出すためのアプローチの総称。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/OutsideInApproach">
    <rdfs:label xml:lang="ja">アウトサイド・イン</rdfs:label>
    <rdfs:comment xml:lang="ja">ユーザー観察・共感・プロトタイピングによる外から内へのアプローチ。アブダクションで多様な見方を立ち上げる。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Research_Driven_Innovation/InnovationApproach"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/InsideOutApproach">
    <rdfs:label xml:lang="ja">インサイド・アウト</rdfs:label>
    <rdfs:comment xml:lang="ja">つくり手の熟考・ビジョン・批判的対話・プロービングによる内から外へのアプローチ。驚きや愛を呼ぶ意味を提案する。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Research_Driven_Innovation/InnovationApproach"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/DesignThinking">
    <rdfs:label xml:lang="ja">デザイン思考</rdfs:label>
    <rdfs:comment xml:lang="ja">エスノグラフィ、共感、批判厳禁の発想、プロトタイピングを用いるアウトサイド・インの手法。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/MeaningInnovation">
    <rdfs:label xml:lang="ja">意味のイノベーション</rdfs:label>
    <rdfs:comment xml:lang="ja">生活者が求めるものを探るのではなく、つくり手が意味を提案するインサイド・アウトの手法。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/InquiryDrivenDoubleDiamond">
    <rdfs:label xml:lang="ja">探究的ダブルダイヤモンドモデル</rdfs:label>
    <rdfs:comment xml:lang="ja">方向性を探索し定義していくリサーチ・ドリブン・イノベーションの実践プロセスモデル。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/ProcessStep">
    <rdfs:label xml:lang="ja">プロセス段階</rdfs:label>
    <rdfs:comment xml:lang="ja">探究的ダブルダイヤモンドを構成する実践ステップの総称。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/QuestionFormulation">
    <rdfs:label xml:lang="ja">問いを立てる</rdfs:label>
    <rdfs:comment xml:lang="ja">価値探究型のリサーチクエスチョンを立て、探究的衝動と創造的対話を誘発する第一段階。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Research_Driven_Innovation/ProcessStep"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/DataCollection">
    <rdfs:label xml:lang="ja">データを集める</rdfs:label>
    <rdfs:comment xml:lang="ja">正解ではなく足場としてデータを集める第二段階。わかるためのデータとつくるためのデータがある。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Research_Driven_Innovation/ProcessStep"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/DataInterpretation">
    <rdfs:label xml:lang="ja">データを解釈する</rdfs:label>
    <rdfs:comment xml:lang="ja">社会構成主義に立ち、関係性の解釈の重ね合わせと対話により意味を生成する第三段階。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Research_Driven_Innovation/ProcessStep"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/ConsensusFormation">
    <rdfs:label xml:lang="ja">合意を形成する</rdfs:label>
    <rdfs:comment xml:lang="ja">答えではなく前提で一致し、HMW形式で次フェーズへ進む第四段階。違和感を尊重する。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Research_Driven_Innovation/ProcessStep"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/IdeaGeneration">
    <rdfs:label xml:lang="ja">アイデアの生成</rdfs:label>
    <rdfs:comment xml:lang="ja">機能解析法と形態チャート法により多様な組み合わせのアイデアを生み出す段階。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Research_Driven_Innovation/ProcessStep"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/IdeaVerification">
    <rdfs:label xml:lang="ja">アイデアの検証</rdfs:label>
    <rdfs:comment xml:lang="ja">リーン・スタートアップとプロトタイピングにより、進みたい方向性に沿っているかを確かめる段階。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Research_Driven_Innovation/ProcessStep"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/ResearchQuestion">
    <rdfs:label xml:lang="ja">リサーチクエスチョン</rdfs:label>
    <rdfs:comment xml:lang="ja">目標ありきではなく人間や社会の本質への関心から立つ問い。実用的関心と概念的関心、内と外のマトリクスで探索する。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/Data">
    <rdfs:label xml:lang="ja">データ</rdfs:label>
    <rdfs:comment xml:lang="ja">正解を導くものではなく、不確実な海で高く跳ぶための足場（錨）。客観的・大量・即答である必要はない。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/DataForUnderstanding">
    <rdfs:label xml:lang="ja">わかるためのデータ</rdfs:label>
    <rdfs:comment xml:lang="ja">チームの共通理解（立脚点）をつくるデータ。既知の未知へのアプローチ。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Research_Driven_Innovation/Data"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/DataForCreating">
    <rdfs:label xml:lang="ja">つくるためのデータ</rdfs:label>
    <rdfs:comment xml:lang="ja">多様な解釈を生み出し新たな気づきを促すデータ。未知の未知へのアプローチ。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Research_Driven_Innovation/Data"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/Dialogue">
    <rdfs:label xml:lang="ja">対話</rdfs:label>
    <rdfs:comment xml:lang="ja">結論を急ぐ議論とは異なり、判断を留保し価値観の共有と新たな意味の生成を目的とする営み。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/Premise">
    <rdfs:label xml:lang="ja">前提</rdfs:label>
    <rdfs:comment xml:lang="ja">答えで固定化せず個人の思考の余地を残すために一致させる合意対象。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/HowMightWe">
    <rdfs:label xml:lang="ja">ハウ・マイト・ウィ</rdfs:label>
    <rdfs:comment xml:lang="ja">私たちはどのようにすればできるだろうか、という形式で前提を表現する問い。行為・感情・場・関係性に着目する。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/Idea">
    <rdfs:label xml:lang="ja">アイデア</rdfs:label>
    <rdfs:comment xml:lang="ja">方向性合意後の生成フェーズで生み出される構想。良し悪しより進みたい方向性との整合が問われる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/FunctionAnalysisMethod">
    <rdfs:label xml:lang="ja">機能解析法</rdfs:label>
    <rdfs:comment xml:lang="ja">入力・処理（ブラックボックス）・出力で機能を分解しアイデア生成の基礎をつくる方法。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/MorphologicalChartMethod">
    <rdfs:label xml:lang="ja">形態チャート法</rdfs:label>
    <rdfs:comment xml:lang="ja">分解した各要素の実現手段を掛け合わせ、多様なアイデアの組み合わせを生成する方法。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/LeanStartup">
    <rdfs:label xml:lang="ja">リーン・スタートアップ</rdfs:label>
    <rdfs:comment xml:lang="ja">低コストの実用最小限の製品を早期に作成し学習する検証手法。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/Prototype">
    <rdfs:label xml:lang="ja">プロトタイプ</rdfs:label>
    <rdfs:comment xml:lang="ja">試行錯誤を通じて学習するための試作。アイデア自体の評価より方向性の確認に用いる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/Researcher">
    <rdfs:label xml:lang="ja">リサーチャー</rdfs:label>
    <rdfs:comment xml:lang="ja">単なるデータ収集・分析者ではなく、問いを立て対話をファシリテートし思考を跳躍させる哲学者かつクリエイター。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/NegativeCapability">
    <rdfs:label xml:lang="ja">ネガティブ・ケイパビリティ</rdfs:label>
    <rdfs:comment xml:lang="ja">不確実性や曖昧さを耐え抜き享受する能力。イノベーションに不可欠。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/CaseStudy">
    <rdfs:label xml:lang="ja">ケーススタディ</rdfs:label>
    <rdfs:comment xml:lang="ja">トイレ空間、シチズンのブランディング、さとり世代向け保険、コンビニ高頻度ユーザーなどプロセス検証事例。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/Workshop">
    <rdfs:label xml:lang="ja">ワークショップ</rdfs:label>
    <rdfs:comment xml:lang="ja">入力・プロセス・成果物を設計し、わからなかったことから共有して解釈を深める場。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Research_Driven_Innovation/Stakeholder">
    <rdfs:label xml:lang="ja">ステークホルダー</rdfs:label>
    <rdfs:comment xml:lang="ja">問いの点検やイノベーションの価値に関わる利害関係者。</rdfs:comment>
  </owl:Class>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/suppresses">
    <rdfs:label xml:lang="ja">抑圧する</rdfs:label>
    <rdfs:comment xml:lang="ja">組織が個人の探究的衝動や創造的自信を抑圧する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Organization"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/ExploratoryImpulse"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/CreativeConfidence"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/fallsInto">
    <rdfs:label xml:lang="ja">陥る</rdfs:label>
    <rdfs:comment xml:lang="ja">組織が成功の罠や変化の硬直化に陥る関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Organization"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/SuccessTrap"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/ChangeRigidity"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/balances">
    <rdfs:label xml:lang="ja">両立させる</rdfs:label>
    <rdfs:comment xml:lang="ja">知の深化と知の探索を両立させる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/AmbidextrousManagement"/>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/ContextualApproach"/>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Individual"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/KnowledgeDeepening"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/KnowledgeExploration"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/memberOf">
    <rdfs:label xml:lang="ja">所属する</rdfs:label>
    <rdfs:comment xml:lang="ja">個人やリサーチャーがチームまたは組織に所属する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Individual"/>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Researcher"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/Team"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/Organization"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/cultivates">
    <rdfs:label xml:lang="ja">耕す</rdfs:label>
    <rdfs:comment xml:lang="ja">組織やチームが創造の土壌や探究的衝動を育てる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Organization"/>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Team"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/CreativeSoil"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/ExploratoryImpulse"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/integrates">
    <rdfs:label xml:lang="ja">往復統合する</rdfs:label>
    <rdfs:comment xml:lang="ja">内と外のアプローチを二者択一せず絶えず往復して探究する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/ResearchDrivenInnovation"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/OutsideInApproach"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/InsideOutApproach"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/basedOn">
    <rdfs:label xml:lang="ja">基づく</rdfs:label>
    <rdfs:comment xml:lang="ja">アプローチやイノベーションが特定の手法・理論に基づく関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/OutsideInApproach"/>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/InsideOutApproach"/>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Innovation"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/DesignThinking"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/MeaningInnovation"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/OrganizationalLearning"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/follows">
    <rdfs:label xml:lang="ja">従う</rdfs:label>
    <rdfs:comment xml:lang="ja">本手法が探究的ダブルダイヤモンドモデルに沿って進む関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/ResearchDrivenInnovation"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/InquiryDrivenDoubleDiamond"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/hasStep">
    <rdfs:label xml:lang="ja">段階を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">モデルが問い・データ収集・解釈・合意・生成・検証などの段階を持つ関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/InquiryDrivenDoubleDiamond"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/ProcessStep"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/stimulates">
    <rdfs:label xml:lang="ja">刺激する</rdfs:label>
    <rdfs:comment xml:lang="ja">問いが探究的衝動を刺激し創造的対話を誘発する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/ResearchQuestion"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/ExploratoryImpulse"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/Dialogue"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/involves">
    <rdfs:label xml:lang="ja">関与させる</rdfs:label>
    <rdfs:comment xml:lang="ja">問いやイノベーションがステークホルダーの視点を含む関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/ResearchQuestion"/>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Innovation"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/Stakeholder"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/usesAsScaffold">
    <rdfs:label xml:lang="ja">足場として用いる</rdfs:label>
    <rdfs:comment xml:lang="ja">チームがデータを思考跳躍のための足場として用いる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Team"/>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/DataCollection"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/Data"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/interprets">
    <rdfs:label xml:lang="ja">解釈する</rdfs:label>
    <rdfs:comment xml:lang="ja">対話を通じてデータの関係性・矛盾・量・頻度・推移を解釈する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Team"/>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Workshop"/>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/DataInterpretation"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/Data"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/conductedVia">
    <rdfs:label xml:lang="ja">対話によって行う</rdfs:label>
    <rdfs:comment xml:lang="ja">解釈やワークショップが対話によって進められる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/DataInterpretation"/>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Workshop"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/Dialogue"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/agreesOn">
    <rdfs:label xml:lang="ja">合意する</rdfs:label>
    <rdfs:comment xml:lang="ja">チームが答えではなく前提で合意する関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/Team"/>
    <rdfs:domain rdf:resource="https://books.local/Research_Driven_Innovation/ConsensusFormation"/>
    <rdfs:range rdf:resource="https://books.local/Research_Driven_Innovation/Premise"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Research_Driven_Innovation/expressedAs">
    <rdfs:label xml:lang="ja">表現される</rdfs:label>
    <rdfs:comment xml:lang="ja">前提がハウ・マイト・ウィの形式で表現される関係。</rdfs:comment>
