<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/">
    <rdfs:label>Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_enOntology</rdfs:label>
    <owl:versionInfo>1.0</owl:versionInfo>
  </owl:Ontology>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/Book">
    <rdfs:label xml:lang="ja">書籍</rdfs:label>
    <rdfs:comment xml:lang="ja">成果に直結する仮説提案営業の実践講座に関する書籍およびその分析対象。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/SalesChallenge">
    <rdfs:label xml:lang="ja">営業課題</rdfs:label>
    <rdfs:comment xml:lang="ja">新製品が売れない、新規開拓が苦手、引き合い減少、製品同質化、オンライン商談での関係構築難化などBtoB営業の共通課題。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/SalesApproach">
    <rdfs:label xml:lang="ja">営業アプローチ</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客への働きかけの仕方を表す営業スタイルや手法の上位概念。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/WaitingSales">
    <rdfs:label xml:lang="ja">待ちの営業</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客からの提案依頼を待つ従来型の営業。システムリプレース型の大型案件に依存しやすい。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/SalesApproach"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/OffensiveSales">
    <rdfs:label xml:lang="ja">攻めの営業</rdfs:label>
    <rdfs:comment xml:lang="ja">クラウド普及による単価低下を踏まえ、顧客に先回りして提案する能動的な営業パラダイム。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/SalesApproach"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/HypothesisProposalSales">
    <rdfs:label xml:lang="ja">仮説提案営業</rdfs:label>
    <rdfs:comment xml:lang="ja">明確なニーズがなくても事前調査に基づく仮説と個別提案資料で初回商談から案件を前進させる営業手法。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/OffensiveSales"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/ThinkingMethod">
    <rdfs:label xml:lang="ja">思考法</rdfs:label>
    <rdfs:comment xml:lang="ja">営業活動で結論を導くための思考の枠組み。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/ExhaustiveThinking">
    <rdfs:label xml:lang="ja">網羅思考</rdfs:label>
    <rdfs:comment xml:lang="ja">すべての事象やデータを抽出・分析してから結論を出す手法。現場営業には時間がかかりすぎて不向き。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/ThinkingMethod"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/HypothesisThinking">
    <rdfs:label xml:lang="ja">仮説思考</rdfs:label>
    <rdfs:comment xml:lang="ja">BCGが提唱した、情報が不十分な段階で仮の結論を立て実行・検証・修正を繰り返す手法。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/ThinkingMethod"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/Hypothesis">
    <rdfs:label xml:lang="ja">仮説</rdfs:label>
    <rdfs:comment xml:lang="ja">限られた情報から立てる顧客課題または解決策の仮の結論。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/ProblemHypothesis">
    <rdfs:label xml:lang="ja">問題仮説</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客が抱えているであろう課題の仮定。So what?で根本原因とインパクトまで深掘りする。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/Hypothesis"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/SolutionHypothesis">
    <rdfs:label xml:lang="ja">解決仮説</rdfs:label>
    <rdfs:comment xml:lang="ja">問題を解決するための具体的な対策や製品導入の仮定。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/Hypothesis"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/HypothesisLevel">
    <rdfs:label xml:lang="ja">仮説レベル</rdfs:label>
    <rdfs:comment xml:lang="ja">エリア特化・企業規模特化・業界特化・企業特化の四段階。レベルが上がるほど案件化率と共感が高まる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/InformationSource">
    <rdfs:label xml:lang="ja">情報源</rdfs:label>
    <rdfs:comment xml:lang="ja">SPEEDA、Googleアラート、RSSリーダーなど仮説立案のための調査手段。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/ProposalMaterial">
    <rdfs:label xml:lang="ja">提案資料</rdfs:label>
    <rdfs:comment xml:lang="ja">初回商談で導入必要性を伝える資料。情報過多を避け、Whyと起こり得る結果を中心に構成する。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/CaseStudy">
    <rdfs:label xml:lang="ja">導入事例</rdfs:label>
    <rdfs:comment xml:lang="ja">同業種・同規模を優先して示す事例。検討中・検証・導入の段階と具体的社数で訴求する。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/SalesMeeting">
    <rdfs:label xml:lang="ja">商談</rdfs:label>
    <rdfs:comment xml:lang="ja">仮説提示、ヒアリング、質疑、クロージングで構成される顧客との商談。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/MeetingPhase">
    <rdfs:label xml:lang="ja">商談フェーズ</rdfs:label>
    <rdfs:comment xml:lang="ja">オープニング、ボディ、クロージングなど商談の時間配分単位。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/ClosingTechnique">
    <rdfs:label xml:lang="ja">クロージング手法</rdfs:label>
    <rdfs:comment xml:lang="ja">松竹梅の選択肢クロージングなど、即決を迫らず次回アクションへ誘導する技法。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/OnlineMeetingTechnique">
    <rdfs:label xml:lang="ja">オンライン商談テクニック</rdfs:label>
    <rdfs:comment xml:lang="ja">視覚・聴覚・言語の三つのVを工夫し、警戒心の高いオンライン環境で関係を深める技法。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/PartnerSales">
    <rdfs:label xml:lang="ja">パートナーセールス</rdfs:label>
    <rdfs:comment xml:lang="ja">SIerや代理店を通じた間接販売。分析、協業提案、交渉、案件創出、継続受注の五ステップで進める。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/SalesApproach"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/PsychologicalPrinciple">
    <rdfs:label xml:lang="ja">心理原則</rdfs:label>
    <rdfs:comment xml:lang="ja">返報性・一貫性・社会的証明・権威・好意・希少性など、顧客の心を動かすチャルディーニの原則。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/Salesperson">
    <rdfs:label xml:lang="ja">営業パーソン</rdfs:label>
    <rdfs:comment xml:lang="ja">企業ブランドや製品スペックではなく仮説提案によって個人として選ばれることを目指す営業担当者。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/Customer">
    <rdfs:label xml:lang="ja">顧客</rdfs:label>
    <rdfs:comment xml:lang="ja">仮説の対象となる企業。ニーズが未明確でも課題仮説によって商談を前進させる相手。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/BusinessPartner">
    <rdfs:label xml:lang="ja">販売パートナー</rdfs:label>
    <rdfs:comment xml:lang="ja">メーカー製品を顧客へ販売するSIerや代理店。Win-Win-Winの協業とイノベーター理論による展開対象。</rdfs:comment>
  </owl:Class>

  <owl:ObjectProperty rdf:about="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/addressesChallenge">
    <rdfs:label xml:lang="ja">課題に対処する</rdfs:label>
    <rdfs:comment xml:lang="ja">営業アプローチが対象とするBtoB営業上の課題。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Seika_ni_Chokketsu_suru___Kasetsu_Teian_Eigyou____Jissen_Kouza__-_Shirono_en/SalesApproach"/>
