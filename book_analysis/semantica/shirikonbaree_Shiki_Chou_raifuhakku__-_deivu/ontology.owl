  <owl:ObjectProperty rdf:about="https://books.local/shirikonbaree_Shiki_Chou_raifuhakku__-_deivu/buildsCommunity">
    <rdfs:label xml:lang="ja">コミュニティを構築する</rdfs:label>
    <rdfs:comment xml:lang="ja">人間関係の手法が自己実現を支える共同体を作ることを示す</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/shirikonbaree_Shiki_Chou_raifuhakku__-_deivu/Technique"/>
    <rdfs:range rdf:resource="https://books.local/shirikonbaree_Shiki_Chou_raifuhakku__-_deivu/Community"/>
  </owl:ObjectProperty>

