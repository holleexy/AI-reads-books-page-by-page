<https://books.local/法人営業勝ちパターン大全/TorchShape>
    a sh:NodeShape ;
    sh:targetClass ex:Torch ;
    sh:name "松明" ;
    sh:description "迷路脱出の光。購買ステージ特定、目の前の人の役割判定、自社発注へ向かう道筋の描出の三点セット。" ;
    sh:property [
