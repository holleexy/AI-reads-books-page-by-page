<https://books.local/法人営業勝ちパターン大全/StakeholderShape>
    a sh:NodeShape ;
    sh:targetClass ex:Stakeholder ;
    sh:name "ステークホルダー" ;
    sh:description "案件に関与する6類型の関係者。一人が複数役割を兼ね、影響力は分散・流動的で見えにくい。" ;
