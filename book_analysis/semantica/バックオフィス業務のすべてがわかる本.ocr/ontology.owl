  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/バックオフィス業務のすべてがわかる本.ocr/usesDigitalTransformation">
    <rdfs:label xml:lang="ja">デジタル化を用いる</rdfs:label>
    <rdfs:comment xml:lang="ja">定型の事務処理をRPA、OCR、クラウドシステムなどで置き換える関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/バックオフィス業務のすべてがわかる本.ocr/BackOffice"/>
