        sh:severity sh:Violation
    ] .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/AppetiteShape>
    a sh:NodeShape ;
    sh:targetClass ex:Appetite ;
    sh:name "食欲" ;
    sh:description "プロテインレバレッジ、脂質、ストレス、どうにでもなれ効果、早歩きやテトリス等で増減する欲求。" .

<https://books.local/Saikou_no_pafoomansu_wo_Jitsugen_suru_Chou_Kenkouhou__-_mentarisuto_DaiGo/SkinCareShape>
    a sh:NodeShape ;
    sh:targetClass ex:SkinCare ;
    sh:name "スキンケア" ;
    sh:description "必要なのは保湿と日焼け止めのみ。ワセリン等の油分膜とSPF30以上の広域スペクトラムを2時間おきに塗る。" ;
    sh:property [
        sh:path ex:basedOn ;
        sh:class ex:ResearchFinding ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ex:recommendedAmount ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
