    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/ShareSales"/>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/SalesOrganization"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/SalesKnowledge"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/analyzesBy">
    <rdfs:label xml:lang="ja">分析軸で分析する</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客・プロセス・コンテンツの三軸分析。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/NEW_SALES/ScoreSales"/>
    <rdfs:range rdf:resource="https://books.local/NEW_SALES/AnalysisAxis"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/NEW_SALES/emphasizesPerspective">
    <rdfs:label xml:lang="ja">意義を強調する</rdfs:label>
