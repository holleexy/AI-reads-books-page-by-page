    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/KPI"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/followsPrinciple">
    <rdfs:label xml:lang="ja">要諦に従う</rdfs:label>
    <rdfs:comment xml:lang="ja">成功の十要諦のいずれかを指針とすることを表す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/BusinessReform"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/SuccessPrinciple"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/usedHistoricalTechnology">
    <rdfs:label xml:lang="ja">歴史的技術を用いた</rdfs:label>
    <rdfs:comment xml:lang="ja">RPAやERPなど従来のデジタル化手段との関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/BusinessReform"/>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/Organization"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/RPA"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/ERP"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/hasPhase">
    <rdfs:label xml:lang="ja">フェーズを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">AIAM法を構成する五フェーズとの関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/AIAMMethod"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/AIAMPhase"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/nextPhase">
    <rdfs:label xml:lang="ja">次フェーズ</rdfs:label>
    <rdfs:comment xml:lang="ja">計画から本番開発へ進むフェーズ順序。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/AIAMPhase"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/AIAMPhase"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/hasDesignPrinciple">
    <rdfs:label xml:lang="ja">設計原則を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">推進時に守るべき設計原則。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/AIAMMethod"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/DesignPrinciple"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/assessedBy">
    <rdfs:label xml:lang="ja">により評価される</rdfs:label>
    <rdfs:comment xml:lang="ja">業務選定アセスメントによる適性と効果の評価。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/BusinessProcess"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/AssessmentProcess"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/hasWorkPattern">
    <rdfs:label xml:lang="ja">業務型を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">要約転記、チェック校閲、問い合わせ対応などの型分類。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/BusinessProcess"/>
    <rdfs:domain rdf:resource="https://books.local/AI_Agent_x_BPR/BackOfficeWork"/>
    <rdfs:range rdf:resource="https://books.local/AI_Agent_x_BPR/WorkPattern"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/AI_Agent_x_BPR/assignedToCategory">
    <rdfs:label xml:lang="ja">優先区分に分類される</rdfs:label>
    <rdfs:comment xml:lang="ja">AI親和度と難度に基づく取組優先度。</rdfs:comment>
