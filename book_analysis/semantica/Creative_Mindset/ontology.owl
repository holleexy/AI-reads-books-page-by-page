<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="https://books.local/Creative_Mindset/">
    <rdfs:label>Creative_MindsetOntology</rdfs:label>
    <owl:versionInfo>1.0</owl:versionInfo>
  </owl:Ontology>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Book">
    <rdfs:label xml:lang="ja">書籍</rdfs:label>
    <rdfs:comment xml:lang="ja">創造的自信に関する分析対象の著作。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Person">
    <rdfs:label xml:lang="ja">人物</rdfs:label>
    <rdfs:comment xml:lang="ja">著者、実践者、研究者などの個人。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/CreativeConfidence">
    <rdfs:label xml:lang="ja">クリエイティブ・コンフィデンス</rdfs:label>
    <rdfs:comment xml:lang="ja">自身の創造的潜在能力を信じ、それに基づいて行動する勇気。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Mindset">
    <rdfs:label xml:lang="ja">マインドセット</rdfs:label>
    <rdfs:comment xml:lang="ja">能力や失敗に対する信念の枠組み。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/FixedMindset">
    <rdfs:label xml:lang="ja">固定マインドセット</rdfs:label>
    <rdfs:comment xml:lang="ja">能力は生まれつき静的で変わらないという信念。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Creative_Mindset/Mindset"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/GrowthMindset">
    <rdfs:label xml:lang="ja">成長マインドセット</rdfs:label>
    <rdfs:comment xml:lang="ja">能力は努力によって伸ばせると信じる姿勢。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Creative_Mindset/Mindset"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Fear">
    <rdfs:label xml:lang="ja">恐れ</rdfs:label>
    <rdfs:comment xml:lang="ja">評価や失敗への不安など、創造性を阻む主要な障壁。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Failure">
    <rdfs:label xml:lang="ja">失敗</rdfs:label>
    <rdfs:comment xml:lang="ja">学習と実験に不可欠な過程であり、前向きに再解釈される対象。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/GuidedMastery">
    <rdfs:label xml:lang="ja">誘導的習熟</rdfs:label>
    <rdfs:comment xml:lang="ja">小さな段階的挑戦を通じて勇気と自己効力感を育てる方法。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/SelfEfficacy">
    <rdfs:label xml:lang="ja">自己効力感</rdfs:label>
    <rdfs:comment xml:lang="ja">自分の能力で成果を出せるという確信。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/DesignThinking">
    <rdfs:label xml:lang="ja">デザイン思考</rdfs:label>
    <rdfs:comment xml:lang="ja">人間中心で反復的な問題解決の方法論。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/DesignThinkingStep">
    <rdfs:label xml:lang="ja">デザイン思考のステップ</rdfs:label>
    <rdfs:comment xml:lang="ja">デザイン思考プロセスを構成する段階。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Empathize">
    <rdfs:label xml:lang="ja">共感</rdfs:label>
    <rdfs:comment xml:lang="ja">自然な環境で利用者を観察し潜在ニーズを探る段階。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Creative_Mindset/DesignThinkingStep"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Define">
    <rdfs:label xml:lang="ja">問題定義</rdfs:label>
    <rdfs:comment xml:lang="ja">観察を統合し、問題を明確に再フレーミングする段階。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Creative_Mindset/DesignThinkingStep"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Ideate">
    <rdfs:label xml:lang="ja">発想</rdfs:label>
    <rdfs:comment xml:lang="ja">判断を保留して多様なアイデアを出す発散的思考の段階。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Creative_Mindset/DesignThinkingStep"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Prototype">
    <rdfs:label xml:lang="ja">プロトタイプ</rdfs:label>
    <rdfs:comment xml:lang="ja">アイデアを素早く低忠実度で形にする段階。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Creative_Mindset/DesignThinkingStep"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Test">
    <rdfs:label xml:lang="ja">テスト</rdfs:label>
    <rdfs:comment xml:lang="ja">利用者の反応を集め、反復改善する段階。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Creative_Mindset/DesignThinkingStep"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Innovation">
    <rdfs:label xml:lang="ja">イノベーション</rdfs:label>
    <rdfs:comment xml:lang="ja">技術・事業・人間ニーズの均衡によって生まれる革新。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/InnovationPillar">
    <rdfs:label xml:lang="ja">イノベーションの柱</rdfs:label>
    <rdfs:comment xml:lang="ja">成功する革新を支える三要素のいずれか。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Feasibility">
    <rdfs:label xml:lang="ja">実現可能性</rdfs:label>
    <rdfs:comment xml:lang="ja">技術的・機能的に可能な範囲。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Creative_Mindset/InnovationPillar"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Viability">
    <rdfs:label xml:lang="ja">事業妥当性</rdfs:label>
    <rdfs:comment xml:lang="ja">財務的に持続できるかどうか。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Creative_Mindset/InnovationPillar"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Desirability">
    <rdfs:label xml:lang="ja">望ましさ</rdfs:label>
    <rdfs:comment xml:lang="ja">人々が実際に必要とし、欲するもの。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Creative_Mindset/InnovationPillar"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/CaseStudy">
    <rdfs:label xml:lang="ja">事例研究</rdfs:label>
    <rdfs:comment xml:lang="ja">共感と行動による創造的実践の具体例。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Organization">
    <rdfs:label xml:lang="ja">組織</rdfs:label>
    <rdfs:comment xml:lang="ja">創造性を規模展開する企業や集団。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Leader">
    <rdfs:label xml:lang="ja">リーダー</rdfs:label>
    <rdfs:comment xml:lang="ja">チームの創造性に影響を与える指導者。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Multiplier">
    <rdfs:label xml:lang="ja">増幅型リーダー</rdfs:label>
    <rdfs:comment xml:lang="ja">周囲の知性と創造性を引き出すリーダー。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Creative_Mindset/Leader"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/Diminisher">
    <rdfs:label xml:lang="ja">減点型リーダー</rdfs:label>
    <rdfs:comment xml:lang="ja">チームの知性や挑戦を抑制するリーダー。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/Creative_Mindset/Leader"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/InnovationCatalyst">
    <rdfs:label xml:lang="ja">イノベーション・カタリスト</rdfs:label>
    <rdfs:comment xml:lang="ja">組織内でデザイン思考の実践を促す訓練された促進者。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/PsychologicalSafety">
    <rdfs:label xml:lang="ja">心理的安全性</rdfs:label>
    <rdfs:comment xml:lang="ja">失敗や異論を恐れずに発言・実験できる環境。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/Creative_Mindset/CreativeTool">
    <rdfs:label xml:lang="ja">創造性ツール</rdfs:label>
    <rdfs:comment xml:lang="ja">発想や共感、フィードバックを促す実践的手法。</rdfs:comment>
  </owl:Class>

  <owl:ObjectProperty rdf:about="https://books.local/Creative_Mindset/authoredBy">
    <rdfs:label xml:lang="ja">著者</rdfs:label>
    <rdfs:comment xml:lang="ja">書籍を書いた人物を示す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/Book"/>
    <rdfs:range rdf:resource="https://books.local/Creative_Mindset/Person"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Creative_Mindset/hasMindset">
    <rdfs:label xml:lang="ja">持つマインドセット</rdfs:label>
    <rdfs:comment xml:lang="ja">人物が採用している能力観を示す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/Person"/>
    <rdfs:range rdf:resource="https://books.local/Creative_Mindset/Mindset"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Creative_Mindset/blockedBy">
    <rdfs:label xml:lang="ja">阻まれる要因</rdfs:label>
    <rdfs:comment xml:lang="ja">創造的自信の発揮を妨げる恐れを示す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/CreativeConfidence"/>
    <rdfs:range rdf:resource="https://books.local/Creative_Mindset/Fear"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Creative_Mindset/reframedAs">
    <rdfs:label xml:lang="ja">再解釈される</rdfs:label>
    <rdfs:comment xml:lang="ja">失敗を学習と習熟の過程として捉える関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/Failure"/>
    <rdfs:range rdf:resource="https://books.local/Creative_Mindset/GuidedMastery"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Creative_Mindset/builds">
    <rdfs:label xml:lang="ja">育む</rdfs:label>
    <rdfs:comment xml:lang="ja">誘導的習熟が自己効力感を高めることを示す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/GuidedMastery"/>
    <rdfs:range rdf:resource="https://books.local/Creative_Mindset/SelfEfficacy"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Creative_Mindset/unlocks">
    <rdfs:label xml:lang="ja">解き放つ</rdfs:label>
    <rdfs:comment xml:lang="ja">デザイン思考が創造的自信を引き出す手段であることを示す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/DesignThinking"/>
    <rdfs:range rdf:resource="https://books.local/Creative_Mindset/CreativeConfidence"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Creative_Mindset/hasStep">
    <rdfs:label xml:lang="ja">含むステップ</rdfs:label>
    <rdfs:comment xml:lang="ja">デザイン思考が持つプロセス段階。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/DesignThinking"/>
    <rdfs:range rdf:resource="https://books.local/Creative_Mindset/DesignThinkingStep"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Creative_Mindset/balances">
    <rdfs:label xml:lang="ja">均衡させる</rdfs:label>
    <rdfs:comment xml:lang="ja">イノベーションが実現可能性・事業妥当性・望ましさを両立すること。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/Innovation"/>
    <rdfs:range rdf:resource="https://books.local/Creative_Mindset/InnovationPillar"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Creative_Mindset/illustratedBy">
    <rdfs:label xml:lang="ja">例示される</rdfs:label>
    <rdfs:comment xml:lang="ja">方法論が具体事例によって示される関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/DesignThinking"/>
    <rdfs:range rdf:resource="https://books.local/Creative_Mindset/CaseStudy"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Creative_Mindset/practicedBy">
    <rdfs:label xml:lang="ja">実践者</rdfs:label>
    <rdfs:comment xml:lang="ja">事例を実施した人物。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/CaseStudy"/>
    <rdfs:range rdf:resource="https://books.local/Creative_Mindset/Person"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Creative_Mindset/fosters">
    <rdfs:label xml:lang="ja">育む環境</rdfs:label>
    <rdfs:comment xml:lang="ja">組織が心理的安全性を醸成すること。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/Organization"/>
    <rdfs:range rdf:resource="https://books.local/Creative_Mindset/PsychologicalSafety"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Creative_Mindset/employsCatalyst">
    <rdfs:label xml:lang="ja">カタリストを置く</rdfs:label>
    <rdfs:comment xml:lang="ja">組織が内部のイノベーション促進者を活用すること。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/Organization"/>
    <rdfs:range rdf:resource="https://books.local/Creative_Mindset/InnovationCatalyst"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Creative_Mindset/ledBy">
    <rdfs:label xml:lang="ja">率いられる</rdfs:label>
    <rdfs:comment xml:lang="ja">組織を指導するリーダーとの関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/Organization"/>
    <rdfs:range rdf:resource="https://books.local/Creative_Mindset/Leader"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/Creative_Mindset/usesTool">
    <rdfs:label xml:lang="ja">用いるツール</rdfs:label>
    <rdfs:comment xml:lang="ja">創造性を刺激するために使う手法。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/Person"/>
    <rdfs:range rdf:resource="https://books.local/Creative_Mindset/CreativeTool"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="https://books.local/Creative_Mindset/title">
    <rdfs:label xml:lang="ja">名称</rdfs:label>
    <rdfs:comment xml:lang="ja">書籍・事例・ツールなどの名前。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/Book"/>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/CaseStudy"/>
    <rdfs:domain rdf:resource="https://books.local/Creative_Mindset/CreativeTool"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

</rdf:RDF>
