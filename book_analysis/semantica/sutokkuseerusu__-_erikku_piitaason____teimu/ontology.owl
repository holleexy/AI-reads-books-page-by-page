<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/">
    <rdfs:label>sutokkuseerusu__-_erikku_piitaason____teimuOntology</rdfs:label>
    <owl:versionInfo>1.0</owl:versionInfo>
  </owl:Ontology>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/Book">
    <rdfs:label xml:lang="ja">書籍</rdfs:label>
    <rdfs:comment xml:lang="ja">既存顧客向け四つのメッセージモデルを行動経済学と心理学で解説したビジネス書。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageModel">
    <rdfs:label xml:lang="ja">メッセージモデル</rdfs:label>
    <rdfs:comment xml:lang="ja">既存顧客との関係を強化し収益を最大化するための科学的な伝達枠組み。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/RetentionMessageModel">
    <rdfs:label xml:lang="ja">現状維持メッセージモデル</rdfs:label>
    <rdfs:comment xml:lang="ja">契約更新時に革新性より安心感を与え継続を促す五段階のリテンション手法。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageModel"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/PriceIncreaseMessageModel">
    <rdfs:label xml:lang="ja">値上げ納得メッセージモデル</rdfs:label>
    <rdfs:comment xml:lang="ja">現状維持モデルとアンカリング効果を組み合わせ値上げを受け入れさせる手法。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageModel"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/UpsellMessageModel">
    <rdfs:label xml:lang="ja">発展促進メッセージモデル</rdfs:label>
    <rdfs:comment xml:lang="ja">関係性を強調し感情に訴えて高額ソリューションへの移行を勧めるハイブリッド型手法。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageModel"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/ApologyMessageModel">
    <rdfs:label xml:lang="ja">許しを請うメッセージモデル</rdfs:label>
    <rdfs:comment xml:lang="ja">不具合時に対処・責任・再発防止・説明・おわびの順で謝罪しロイヤルティを高める手法。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageModel"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CognitiveBias">
    <rdfs:label xml:lang="ja">認知バイアス</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客の意思決定を歪める心理的傾向の総称。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/StatusQuoBias">
    <rdfs:label xml:lang="ja">現状維持バイアス</rdfs:label>
    <rdfs:comment xml:lang="ja">安定の優先、変化コスト、選択の難しさ、後悔への恐れから現状を維持しようとする傾向。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CognitiveBias"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/ContextEffect">
    <rdfs:label xml:lang="ja">文脈効果</rdfs:label>
    <rdfs:comment xml:lang="ja">同じメッセージでも新規か既存かという立場で反応が大きく異なる現象。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CognitiveBias"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/FramingEffect">
    <rdfs:label xml:lang="ja">フレーミング効果</rdfs:label>
    <rdfs:comment xml:lang="ja">利益を強調するか損失を強調するかでリスク許容度と決断が逆転する現象。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CognitiveBias"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/AnchoringEffect">
    <rdfs:label xml:lang="ja">アンカリング効果</rdfs:label>
    <rdfs:comment xml:lang="ja">最初に提示した高い基準値に判断が引きずられる認知バイアス。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CognitiveBias"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/ProspectTheory">
    <rdfs:label xml:lang="ja">プロスペクト理論</rdfs:label>
    <rdfs:comment xml:lang="ja">人は利益獲得より損失回避のために二倍から三倍行動しやすいとする理論。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/IncumbentAdvantage">
    <rdfs:label xml:lang="ja">現職の強み</rdfs:label>
    <rdfs:comment xml:lang="ja">既存顧客が投じた時間・費用・労力というサンクコストを無駄にしたくない障壁。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/Customer">
    <rdfs:label xml:lang="ja">顧客</rdfs:label>
    <rdfs:comment xml:lang="ja">メッセージの受け手となる取引相手。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/ExistingCustomer">
    <rdfs:label xml:lang="ja">既存顧客</rdfs:label>
    <rdfs:comment xml:lang="ja">現状維持バイアスを擁護・強化し継続の安心感を与えるべき顧客。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/Customer"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/ProspectCustomer">
    <rdfs:label xml:lang="ja">見込み顧客</rdfs:label>
    <rdfs:comment xml:lang="ja">現状維持バイアスを打ち砕き変化を促す必要がある新規対象。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/Customer"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CriticalMoment">
    <rdfs:label xml:lang="ja">クリティカルモーメント</rdfs:label>
    <rdfs:comment xml:lang="ja">サブスクリプションにおいて既存顧客との絶対に失敗できない局面。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageStep">
    <rdfs:label xml:lang="ja">メッセージステップ</rdfs:label>
    <rdfs:comment xml:lang="ja">各メッセージモデルを構成する順序付きの伝達手順。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/ServiceRecoveryParadox">
    <rdfs:label xml:lang="ja">サービスリカバリーパラドックス</rdfs:label>
    <rdfs:comment xml:lang="ja">適切なリカバリーにより顧客満足度とロイヤルティが却って高まる現象。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CommunicationSkill">
    <rdfs:label xml:lang="ja">伝達スキル</rdfs:label>
    <rdfs:comment xml:lang="ja">三段階指標、ナンバープレイ、画像優位性、手描きイラスト、主語を御社にする伝え方。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/SituationReadingSkill">
    <rdfs:label xml:lang="ja">状況を読む力</rdfs:label>
    <rdfs:comment xml:lang="ja">定着、アップセル時機、無関心圏の区別により適用モデルを見極める技能。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/StockSales">
    <rdfs:label xml:lang="ja">ストックセールス</rdfs:label>
    <rdfs:comment xml:lang="ja">カスタマーシェア向上を目指す実験に基づく顧客管理型アプローチ。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CustomerShare">
    <rdfs:label xml:lang="ja">カスタマーシェア</rdfs:label>
    <rdfs:comment xml:lang="ja">成熟市場で既存顧客の生涯価値最大化を示す収益の鍵となる指標。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MarketShare">
    <rdfs:label xml:lang="ja">マーケットシェア</rdfs:label>
    <rdfs:comment xml:lang="ja">成長市場で重視される新規獲得による市場占有率。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CustomerZone">
    <rdfs:label xml:lang="ja">顧客ゾーン</rdfs:label>
    <rdfs:comment xml:lang="ja">満足度とポテンシャルの二軸でアタック、チャレンジ、ディフェンス、リカバリーに分ける区分。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/EngagementPractice">
    <rdfs:label xml:lang="ja">エンゲージメント実践</rdfs:label>
    <rdfs:comment xml:lang="ja">キックオフと四半期ビジネスレビューを変革しメッセージの空白期間を埋める組織的リズム。</rdfs:comment>
  </owl:Class>

  <owl:ObjectProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/appliesToCustomer">
    <rdfs:label xml:lang="ja">適用対象顧客</rdfs:label>
    <rdfs:comment xml:lang="ja">当該メッセージモデルが向けられる顧客種別を示す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageModel"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/Customer"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/basedOnBias">
    <rdfs:label xml:lang="ja">根拠バイアス</rdfs:label>
    <rdfs:comment xml:lang="ja">メッセージ設計の根拠となる認知バイアスを示す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageModel"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CognitiveBias"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/basedOnTheory">
    <rdfs:label xml:lang="ja">根拠理論</rdfs:label>
    <rdfs:comment xml:lang="ja">損失回避性などプロスペクト理論に根ざすことを示す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageModel"/>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/FramingEffect"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/ProspectTheory"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/hasStep">
    <rdfs:label xml:lang="ja">ステップを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">モデルを構成する順序付き伝達手順を持つ。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageModel"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageStep"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/usedAtMoment">
    <rdfs:label xml:lang="ja">使用局面</rdfs:label>
    <rdfs:comment xml:lang="ja">更新、値上げ、アップセル、謝罪など失敗できない局面を示す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageModel"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CriticalMoment"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/assignedToZone">
    <rdfs:label xml:lang="ja">適用ゾーン</rdfs:label>
    <rdfs:comment xml:lang="ja">アタック、チャレンジ、ディフェンス、リカバリーのどのゾーンで使うかを示す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageModel"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CustomerZone"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/classifiedInto">
    <rdfs:label xml:lang="ja">ゾーン分類</rdfs:label>
    <rdfs:comment xml:lang="ja">CS指数とOP指数により顧客をゾーンへ分類する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/Customer"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CustomerZone"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/exhibitsBias">
    <rdfs:label xml:lang="ja">示すバイアス</rdfs:label>
    <rdfs:comment xml:lang="ja">顧客が示す現状維持や文脈効果などの心理傾向。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/Customer"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CognitiveBias"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/hasIncumbentAdvantage">
    <rdfs:label xml:lang="ja">現職の強みを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">既存顧客がサンクコストにより乗り換えにくい状態を持つ。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/ExistingCustomer"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/IncumbentAdvantage"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/recoversThrough">
    <rdfs:label xml:lang="ja">リカバリーを通じて</rdfs:label>
    <rdfs:comment xml:lang="ja">適切な謝罪順序により満足度が却って高まる現象を利用する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/ApologyMessageModel"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/ServiceRecoveryParadox"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/usesSkill">
    <rdfs:label xml:lang="ja">技能を用いる</rdfs:label>
    <rdfs:comment xml:lang="ja">状況判断と伝達・視覚化の技能で効果を最大化する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageModel"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CommunicationSkill"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/SituationReadingSkill"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/implementsModel">
    <rdfs:label xml:lang="ja">モデルを実装する</rdfs:label>
    <rdfs:comment xml:lang="ja">ストックセールスが四つのメッセージモデルを組織的に適用する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/StockSales"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageModel"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/maximizes">
    <rdfs:label xml:lang="ja">最大化する</rdfs:label>
    <rdfs:comment xml:lang="ja">新規のマーケットシェアではなく既存顧客のカスタマーシェアを最大化する。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/StockSales"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CustomerShare"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/contrastedWith">
    <rdfs:label xml:lang="ja">対比される</rdfs:label>
    <rdfs:comment xml:lang="ja">成熟市場のカスタマーシェアが成長市場のマーケットシェアと対比される。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CustomerShare"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MarketShare"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/employsPractice">
    <rdfs:label xml:lang="ja">実践を用いる</rdfs:label>
    <rdfs:comment xml:lang="ja">キックオフとQBRの変革により契約期間中の空白を埋める。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/StockSales"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/EngagementPractice"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/describedIn">
    <rdfs:label xml:lang="ja">解説される書籍</rdfs:label>
    <rdfs:comment xml:lang="ja">当該概念が解説されている書籍を示す。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/MessageModel"/>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/StockSales"/>
    <rdfs:domain rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/CognitiveBias"/>
    <rdfs:range rdf:resource="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/Book"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="https://books.local/sutokkuseerusu__-_erikku_piitaason____teimu/stepOrderNote">
