    <rdfs:range rdf:resource="https://books.local/法人営業勝ちパターン大全/PurchasingStage"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/法人営業勝ちパターン大全/mappedToPattern">
