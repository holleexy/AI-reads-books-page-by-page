    ] ;
    sh:property [
        sh:path ex:supportedByFinding ;
        sh:class ex:ResearchFinding ;
        sh:severity sh:Violation
    ] .

<https://books.local/法人営業勝ちパターン大全/RequirementsDefinitionShape>
    a sh:NodeShape ;
    sh:targetClass ex:RequirementsDefinition ;
    sh:name "要件定義" ;
    sh:description "予算・機能・時期・運用が言語化される段階。実質決定が集中し、ディスカッション戦略の適用対象。" ;
    sh:property [
        sh:path ex:mappedToPattern ;
        sh:class ex:WinningPattern ;
        sh:severity sh:Violation
    ] ;
