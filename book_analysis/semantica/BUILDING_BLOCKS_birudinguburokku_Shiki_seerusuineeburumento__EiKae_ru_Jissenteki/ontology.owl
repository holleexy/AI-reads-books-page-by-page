    <rdfs:label xml:lang="ja">ビルディングブロックを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">セールスイネーブルメントが営業力最大化の構成要素を持つ関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/BUILDING_BLOCKS_birudinguburokku_Shiki_seerusuineeburumento__EiKae_ru_Jissenteki/SalesEnablement"/>
