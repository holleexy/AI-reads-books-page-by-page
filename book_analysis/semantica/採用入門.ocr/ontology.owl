<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="https://books.local/採用入門.ocr/">
    <rdfs:label>採用入門.ocrOntology</rdfs:label>
    <owl:versionInfo>1.0</owl:versionInfo>
  </owl:Ontology>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/Book">
    <rdfs:label xml:lang="ja">書籍</rdfs:label>
    <rdfs:comment xml:lang="ja">『図解採用入門100のツボ』など、採用の考え方を体系的に示す入門書。100の独立したツボで構成され順不同で読める。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/Author">
    <rdfs:label xml:lang="ja">著者</rdfs:label>
    <rdfs:comment xml:lang="ja">書籍の執筆者。実務家の坪谷邦生と採用市場研究所の秋山統樹など。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/Tsubo">
    <rdfs:label xml:lang="ja">ツボ</rdfs:label>
    <rdfs:comment xml:lang="ja">書籍を構成する100の独立した要点。見開き2ページで自己完結し、Q&amp;A・解説・図解・実践ヒントからなる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/HumanResources">
    <rdfs:label xml:lang="ja">人事</rdfs:label>
    <rdfs:comment xml:lang="ja">人を生かして事をなすこと。人の能力発揮と組織成果の同時実現。搾取でもぬるま湯でもない。機能はホロン構造をなす。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/Result">
    <rdfs:label xml:lang="ja">成果</rdfs:label>
    <rdfs:comment xml:lang="ja">組織が顧客と社会に提供する価値。内部努力ではなく外部から見える価値であり、ドラッカーによれば成果は組織の外に存在する。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/Business">
    <rdfs:label xml:lang="ja">事業</rdfs:label>
    <rdfs:comment xml:lang="ja">価値を継続的に提供する活動。製品・サービスを生み出し収益を得て、企業が成長するための仕組み全体。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/Organization">
    <rdfs:label xml:lang="ja">組織</rdfs:label>
    <rdfs:comment xml:lang="ja">共通目的に向かい人が結びつき役割を分担して協働する仕組み。織り合わせるという意味を持ち、円滑な機能に人事が不可欠。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/Recruitment">
    <rdfs:label xml:lang="ja">採用</rdfs:label>
    <rdfs:comment xml:lang="ja">組織と人が出会いともに未来を形づくる営み。人を選ぶから関係性を築くへの転換。人事の最初で特に重要な中核機能。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/採用入門.ocr/HumanResources"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/NewGraduateRecruitment">
    <rdfs:label xml:lang="ja">新卒採用</rdfs:label>
    <rdfs:comment xml:lang="ja">日本特有の一括採用。潜在能力と将来の成長を重視し、長期育成・ジョブローテーション・同期文化を前提とする。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/採用入門.ocr/Recruitment"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/ExperiencedHireRecruitment">
    <rdfs:label xml:lang="ja">経験者採用</rdfs:label>
    <rdfs:comment xml:lang="ja">実務経験と専門スキルを評価し任せる採用。即戦力と入社後成果が最重要。需要は流動的で現場主導が多い。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/採用入門.ocr/Recruitment"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/RecruitmentTeam">
    <rdfs:label xml:lang="ja">採用チーム</rdfs:label>
    <rdfs:comment xml:lang="ja">人事・現場マネージャー・現場メンバー・経営者・外部パートナーが協働する体制。多様な視点・速度と質の両立・学習資産化が利点。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/TeamStructure">
    <rdfs:label xml:lang="ja">チーム構造</rdfs:label>
    <rdfs:comment xml:lang="ja">分散型・専任集中型・ハイブリッド型・プロジェクト型・RPO外部委託型の五類型。人員規模に応じて見直しが必要。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/RecruitmentProcess">
    <rdfs:label xml:lang="ja">採用プロセス</rdfs:label>
    <rdfs:comment xml:lang="ja">矢羽モデルと呼ばれる短期プロセス。採用要件から募集、選考、適応（オンボーディング）へと進む。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/RecruitmentRequirement">
    <rdfs:label xml:lang="ja">採用要件</rdfs:label>
    <rdfs:comment xml:lang="ja">事業と組織が成果を出すために必要な人材条件。曖昧だとスキル不一致や早期離職を招く。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/Sourcing">
    <rdfs:label xml:lang="ja">募集</rdfs:label>
    <rdfs:comment xml:lang="ja">候補者を集め接点を作る活動。媒体・紹介・スカウト・リファラルなどを含む。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/Selection">
    <rdfs:label xml:lang="ja">選考</rdfs:label>
    <rdfs:comment xml:lang="ja">候補者を評価し採否を決める活動。属人的直感への偏りは失敗要因となる。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/Onboarding">
    <rdfs:label xml:lang="ja">適応</rdfs:label>
    <rdfs:comment xml:lang="ja">入社後の定着・貢献・成果創出を促すオンボーディング。適応できなければ採用は失敗である。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/CandidateExperience">
    <rdfs:label xml:lang="ja">採用CX</rdfs:label>
    <rdfs:comment xml:lang="ja">応募から入社までの全接点における候補者体験。迅速な連絡・丁寧な対応・文化を感じる瞬間が入社承諾と適応に影響する。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/RecruitmentMarketing">
    <rdfs:label xml:lang="ja">採用マーケティング</rdfs:label>
    <rdfs:comment xml:lang="ja">候補者と企業の関係性を育成する活動。採用CXを支える層。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/RecruitmentStrategy">
    <rdfs:label xml:lang="ja">採用戦略</rdfs:label>
    <rdfs:comment xml:lang="ja">経営・事業戦略と候補者ニーズを整合させる方針。いつ、どんな人を、何人、どのように採用するかを定める。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/Person">
    <rdfs:label xml:lang="ja">人</rdfs:label>
    <rdfs:comment xml:lang="ja">採用に関わる個人。能力を生かして事をなす主体。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/Executive">
    <rdfs:label xml:lang="ja">経営者</rdfs:label>
    <rdfs:comment xml:lang="ja">方向提示・顔出し・迅速な意思決定・文化語りを担う。採用へのコミットで活動は半ば成功する。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/採用入門.ocr/Person"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/FieldManager">
    <rdfs:label xml:lang="ja">現場マネージャー</rdfs:label>
    <rdfs:comment xml:lang="ja">職場適合を保証する役割。要件の具体化、スキルとスタンス評価、CX演出、適応支援、結果検証を行う。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/採用入門.ocr/Person"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/Recruiter">
    <rdfs:label xml:lang="ja">採用担当者</rdfs:label>
    <rdfs:comment xml:lang="ja">経営・現場・外部をつなぐハブ。戦略立案、プロセス設計、情報調整、CX設計、組織学習促進を担う。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/採用入門.ocr/Person"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/Candidate">
    <rdfs:label xml:lang="ja">候補者</rdfs:label>
    <rdfs:comment xml:lang="ja">組織と出会い関係性を築く人材。キャリア形成の機会として採用を捉える主体。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/採用入門.ocr/Person"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/ExternalPartner">
    <rdfs:label xml:lang="ja">外部パートナー</rdfs:label>
    <rdfs:comment xml:lang="ja">効率を高める協力者。求人媒体、人材紹介、スカウト、RPOなどの類型がある。信頼関係が成功の鍵。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/HiringFailure">
    <rdfs:label xml:lang="ja">採用失敗</rdfs:label>
    <rdfs:comment xml:lang="ja">要件曖昧、属人的選考、広報と実態の乖離、戦略欠如の四類型。戦術成功への執着が中長期の大きな失敗を招く。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/RecruitmentImpact">
    <rdfs:label xml:lang="ja">採用の影響</rdfs:label>
    <rdfs:comment xml:lang="ja">組織成長（増員と補充）、組織活性化、個人のキャリア形成、社会の雇用創出という四層の影響。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/HiringModel">
    <rdfs:label xml:lang="ja">採用モデル</rdfs:label>
    <rdfs:comment xml:lang="ja">文化と雇用システムに根ざす採用の型。国によるタイミング・基準・雇用形態の違いを説明する。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/JapaneseHiringModel">
    <rdfs:label xml:lang="ja">日本型採用</rdfs:label>
    <rdfs:comment xml:lang="ja">新卒一括採用・潜在能力・長期雇用・ジョブローテーションによるメンバーシップ型。組織力と忠誠心が強み。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/採用入門.ocr/HiringModel"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/AmericanHiringModel">
    <rdfs:label xml:lang="ja">米国型採用</rdfs:label>
    <rdfs:comment xml:lang="ja">通年採用・スキルと成果・ジョブ型雇用。適材適所と専門深化、市場流動性が強み。</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://books.local/採用入門.ocr/HiringModel"/>
  </owl:Class>

  <owl:Class rdf:about="https://books.local/採用入門.ocr/HistoricalPeriod">
    <rdfs:label xml:lang="ja">歴史的時期</rdfs:label>
    <rdfs:comment xml:lang="ja">明治の学歴エリート採用から、終身雇用の定着、バブル崩壊後の多様化、21世紀の通年・ジョブ型・遠隔採用までの区分。</rdfs:comment>
  </owl:Class>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/writtenBy">
    <rdfs:label xml:lang="ja">著者である</rdfs:label>
    <rdfs:comment xml:lang="ja">書籍とその執筆者を結びつける。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Book"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/Author"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/consistsOfTsubo">
    <rdfs:label xml:lang="ja">ツボからなる</rdfs:label>
    <rdfs:comment xml:lang="ja">書籍が独立したツボの集合として構成される関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Book"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/Tsubo"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/producesResult">
    <rdfs:label xml:lang="ja">成果を生む</rdfs:label>
    <rdfs:comment xml:lang="ja">事業と組織が顧客・社会への価値としての成果を生み出す関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Business"/>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Organization"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/Result"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/requiresOrganization">
    <rdfs:label xml:lang="ja">組織を必要とする</rdfs:label>
    <rdfs:comment xml:lang="ja">事業が継続的に成果を出すために組織を必要とする関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Business"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/Organization"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/requiresRecruitment">
    <rdfs:label xml:lang="ja">採用を必要とする</rdfs:label>
    <rdfs:comment xml:lang="ja">組織が事業を通じて成果を出すために必要な人材を採用で迎え入れる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Organization"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/Recruitment"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/hasTeam">
    <rdfs:label xml:lang="ja">採用チームを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">採用活動が個人ではなくチームとして行われる関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Recruitment"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/RecruitmentTeam"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/hasProcess">
    <rdfs:label xml:lang="ja">採用プロセスを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">採用が矢羽モデルの短期プロセスとして構造化される関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Recruitment"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/RecruitmentProcess"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/hasStageRequirement">
    <rdfs:label xml:lang="ja">採用要件段階を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">プロセスの起点として必要な人材条件を定める関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/RecruitmentProcess"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/RecruitmentRequirement"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/hasStageSourcing">
    <rdfs:label xml:lang="ja">募集段階を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">プロセスが候補者募集へと進む関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/RecruitmentProcess"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/Sourcing"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/hasStageSelection">
    <rdfs:label xml:lang="ja">選考段階を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">プロセスが評価と採否決定へと進む関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/RecruitmentProcess"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/Selection"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/hasStageOnboarding">
    <rdfs:label xml:lang="ja">適応段階を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">プロセスが入社後の定着と貢献へと進む関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/RecruitmentProcess"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/Onboarding"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/hasCandidateExperience">
    <rdfs:label xml:lang="ja">採用CXを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">採用が候補者の全接点体験として設計される関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Recruitment"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/CandidateExperience"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/hasStrategy">
    <rdfs:label xml:lang="ja">採用戦略を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">採用が経営・事業戦略と候補者ニーズに整合する方針を持つ関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Recruitment"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/RecruitmentStrategy"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/hasMarketing">
    <rdfs:label xml:lang="ja">採用マーケティングを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">候補者と企業の関係性育成が採用を支える関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Recruitment"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/RecruitmentMarketing"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/hasMember">
    <rdfs:label xml:lang="ja">メンバーを持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">採用チームが経営者・現場マネージャー・採用担当者で構成される関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/RecruitmentTeam"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/Executive"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/FieldManager"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/Recruiter"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/collaboratesWith">
    <rdfs:label xml:lang="ja">外部パートナーと協働する</rdfs:label>
    <rdfs:comment xml:lang="ja">採用チームが媒体・紹介・スカウト・RPOなどと信頼関係を築く関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/RecruitmentTeam"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/ExternalPartner"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/hasStructure">
    <rdfs:label xml:lang="ja">構造を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">採用チームが分散・専任・ハイブリッド・プロジェクト・外部委託のいずれかの型を取る関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/RecruitmentTeam"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/TeamStructure"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/targetsCandidate">
    <rdfs:label xml:lang="ja">候補者を対象とする</rdfs:label>
    <rdfs:comment xml:lang="ja">採用活動と各接点が候補者に向かう関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Recruitment"/>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Sourcing"/>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Selection"/>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/CandidateExperience"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/Candidate"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/hasImpact">
    <rdfs:label xml:lang="ja">影響を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">採用が組織・個人・社会に成長・活性化・キャリア・雇用の影響を与える関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Recruitment"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/RecruitmentImpact"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/hasFailure">
    <rdfs:label xml:lang="ja">失敗を持つ</rdfs:label>
    <rdfs:comment xml:lang="ja">採用が要件曖昧・属人性・実態乖離・戦略欠如などの失敗パターンに陥る関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Recruitment"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/HiringFailure"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/followsModel">
    <rdfs:label xml:lang="ja">採用モデルに従う</rdfs:label>
    <rdfs:comment xml:lang="ja">採用実務が日本型または米国型などの雇用文化モデルに根ざす関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Recruitment"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/HiringModel"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://books.local/採用入門.ocr/shapedInPeriod">
    <rdfs:label xml:lang="ja">歴史的時期に形成される</rdfs:label>
    <rdfs:comment xml:lang="ja">採用モデルが明治以降の各時代の雇用慣行の中で形成される関係。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/HiringModel"/>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/JapaneseHiringModel"/>
    <rdfs:range rdf:resource="https://books.local/採用入門.ocr/HistoricalPeriod"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="https://books.local/採用入門.ocr/definition">
    <rdfs:label xml:lang="ja">定義</rdfs:label>
    <rdfs:comment xml:lang="ja">概念の日本語による定義文。</rdfs:comment>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/HumanResources"/>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Recruitment"/>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Result"/>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/Tsubo"/>
    <rdfs:domain rdf:resource="https://books.local/採用入門.ocr/HiringFailure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

</rdf:RDF>
